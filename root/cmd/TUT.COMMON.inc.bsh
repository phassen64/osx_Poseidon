#!/bin/bash

#   =*= x:  Tutorial.c89||cpp

#   content:
#   +   m:  basic
#   +   m:  usage
#   +   m:  helper functions
#   +   m:  body
#           s:  argument handling
#           s:  argument usage
#           s:  compiler
#           s:  performer
#           s:  logging

#   v_  : environment
#   z_  : in this body
#   g_  : global in this scriot

#   url:
#       https://regex101.com/

#   ============================================================================
#   =*= m:  usage
#   ============================================================================

<<  =*=
    Tutorial
    +   usage: $>. {thisScript} < {TC} || {opt} > [{stressFactor}:=1]
    +   Examples:
        case.h:: $> . run                   # opt:{'','?','h','help'} => show help
        case.c:: $> . run c                 # opt:{'c'}   : rm log+tm Files
        case.1:: $> . run !                 # run all TC 1x
        case.2:: $> . run ! 5               # run all TC 5x
        case.2:: $> . run + 5               # run <1..max> TC 5x
        case.3:: $> . run  <SCRIPT> 3     # run tc=b01  run:3x times
=*=

function f_menu_usage() {
    s="usage: $> {'$z_SCP'}  {<opt>|<SRC>}  {stressFactor}:=1"
    f_lib_puts "$s" $v_COL_ID_green
    printf "\t?   :\t show help\n"
    printf "\tc   :\t remove tmpFiles\n"
    printf "\t!   :\t compile all\n";
    printf "\t+   :\t compile some random\n";
}


#   ============================================================================
#   =*= m:  func.menu
#   ============================================================================
#

function f_menu_clean() {
    local bTrc=$v_TRUE
    f_lib_trace ${FUNCNAME[0]} $LINENO "clean.common" $bTrc
    #   rm :: LOG
    #   f:  run_cppTutor.bsh.log
    #   f:  run_c89Tutor_240316153943.log
    #   f:  c89_c01_001.log
    #   f:  c89_sum_12393939.log
    pushd "$v_DIR_LOG" > /dev/null
    sPrx=$z_SCL_logSrc_prefix
    sExt=$z_SCL_extLog
    sSid=$z_SCL_id
    sSum=$z_LOG_id_sumSep
    r="^${z_SCP}\.${z_SCL_extLog}";    f__remove $r
    r="^${z_SCP_bdy}_[0-9]{12}\.${z_SCL_extLog}" ;    f__remove $r
    r="^${sPrx}_${sSid}[0-9]{2}_[0-9]{3}\.${sExt}$"; f__remove $r
    r="^${sPrx}_${sSum}_[0-9]{12}\.${sExt}$"; f__remove $r
    popd > /dev/null
    #   rm :: TMP
    pushd "$v_DIR_TMP" > /dev/null
    f__remove $g_REGEXP_tmp
    popd > /dev/null
    #   rm :: local
    f__remove $g_REGEXP_bin
    #   SCL clean
    f_scl_clean
    return -1
}


function f_menu_checkSingle() {
    # IN :g_aRc; sSrc,
    # OUT:g_aRc; g_iRc; iRc
    declare p_sSrc=$1
    declare -i i=0
    declare -i iSrc=0
    if ( f_lib_isInteger $p_sSrc ); then
        f_lib_error "TCname is numeric:$p_sSrc" $LINENO
        exit 1
    fi
    for xSrc in "${g_aRc[@]}"; do
        let "i += 1"
        if [ $xSrc == $p_sSrc ]; then
            iSrc=$i
            break
        fi
    done
    g_aRc=()
    if [ $iSrc -le 0 ]; then
        f_lib_error "!!! wrong SRC:'$p_sSrc'" $LINENO
        exit 9
    fi
    g_aRc+=($p_sSrc)   # store for return
    g_iRc=$i
    return $i
}


#   ============================================================================
#   =*= m:  func.private
#   ============================================================================


function f__remove() {
    local sRex=$1
    declare -i i
    g_iRc=0
    sPwd=`pwd`
    f_lib_puts "+++ REG try:'$sRex' at pwd:[$sPwd]" $v_COL_ID_blue
    i=0
    for xFile in `ls`
    do
        if [ -f "$xFile" ]; then
            #   echo "--- $i:'$xFile'"; i+=1
            if [[ $xFile =~ $sRex ]]; then
                i+=1
                printf "\tRM[%2.2d]:%s\n" $i $xFile
                rm -f $xFile 2> /dev/null
                g_iRc+=1
            fi
        fi
    done
    return $g_iRc
}

function f__chkRc() {

    local iRc=$1
    local iEc=$2

    #   =*= : handle return code
    iNL=$v_LIB__PRT_noNLnoPx
    if [ $iRc == $iEc ]; then
        #   meaning: has used external Ec
        f_lib_print "=== OK:iEc=<$iEc>" $iNL $v_COL_ID_green
        return $v_TRUE
    elif [ $iRc == $v_FWK_exitCode ]; then
        #   meaning: standard old return code
        f_lib_print "=!= iRc<$iRc>==iEc.glb" $iNL $v_COL_ID_blue
        return $v_TRUE
    elif [ $iRc == $v_LIB__iEc_std ]; then
        #   meaning: standard if python
        f_lib_print "=!= iRc<$iRc>==iEc.std" $iNL $v_COL_ID_olive
        return $v_TRUE
    elif [ $iRc == 0 ] ; then
        #   meaning: standard OK
        f_lib_print "=*= iRc==0" $iNL $v_COL_ID_yellow
        return $v_TRUE
    elif [ $iRc == 1 ] ; then
        #   meaning: standard error
        f_lib_print "=*= iRc:<$iRc>:error!" $iNL $v_COL_ID_red
        return $v_FALSE
    elif [ $iRc -lt $v_LIB__iEc_min ]; then
        #   meaning: warning
        f_lib_print "=?= iRc:<$iRc>LT<$g_iExitCode_min>" $iNL $v_COL_ID_yellow
        return $v_TRUE
    elif [ $iRc -gt $v_LIB__iEc_max ]; then
        #   meaning: error overflow
        f_lib_print "=?= iRc:<$iRc>:errorOverflow" $iNL $v_COL_ID_red
        return $v_FALSE
    else
        #  meaning: error
        f_lib_print "=?= iRc:<$iRc>" $iNL $v_COL_ID_red
    fi
    return $v_FALSE
}

#   ============================================================================
#   =*= m:  expr
#   ============================================================================

function f_expr_fileExpansion() {
#   local   sFspExp=$1  # not working
#   FileExpansion not as parameter
    local   sFspExp=$g_FEXPAN_src
    f_lib_trace ${FUNCNAME[0]} $LINENO "seekSrc" $z_bVbs
    g_aRc=( $(echo "$sFspExp") )
    return ${#g_aRc[@]}
}


function f_expr_regExpression() {
    local sRegExp=$1
    local bShow=$2
    local bDbg=$z_bDbg
    declare -i i=0
    g_aRc=()
    f_lib_debug "using REG:<$sRegExp>" $LINENO $bDbg
    if [ -z "$sRegExp" ]; then
        f_lib_error "sRegExpr is EMPTY"
        return 0
    fi
    #   echo "show.Base:<$bShow>"
    for xFile in `ls`
    do
        if [ ! -f "$xFile" ]; then
            continue
        fi
        if [[ $xFile =~ $sRegExp ]]; then
            i+=1; g_aRc+=( $xFile )
            if [ -z $bShow ]; then
                continue
            fi
            #   echo "found1:<$bShow>"
            if [ $bShow == $v_TRUE ]; then
                echo "foundREX:[$i]:'$xFile'"
            fi
        fi
    done
    return $i
}


#   ============================================================================
#   =*= m:  func.compile
#   ============================================================================

function f__compiling() {
    local   sSrc=$1
    local   iEc=$2
    local   iRc=-1
    local   bRc=$v_FALSE
    local   fBdy="${sSrc%.*}"
    local   fObj=${fBdy}.${z_SCL_extObj}
    local   bTrc=$z_bTrc
    #   *   run scl.compiler
    f_lib_trace ${FUNCNAME[0]} $LINENO "src:=<$sSrc>" $bTrc
    f_scl_command $sSrc;  sCmd=$z_SCL_sCmd # output
    f_lib_debug "cmd:=<$sCmd>" $LINENO $bTrc
    #   *   invoke command
    $sCmd; iRc=$?
    #   *   check
    f__chkRc $iRc $iEc; bRc=$?
    g_sRc=$fObj
    return $bRc
}

function f_main_compiler()
{
    #   IN  :   g_aSrcNow
    #   I/O :   g_aRun

    f_lib_trace ${FUNCNAME[0]} $LINENO "manager.compiler" $z_bTrc
    f_lib_debug "mode.LOG:={$z_bLog}" $LINENO $z_bDbg

    declare -i nSrc=${#g_aSrcNow[@]}
    declare -i i=0
    declare -i n=0
    declare -i iOk=0
    declare -i iEc=0
    declare -a eTc
    declare fBdy
    declare fObj

    f_lib_puts "MODE::compile" $v_COL_ID_yellow

    for xSrc in "${g_aSrcNow[@]}"
    do

        #   show
        i+=1
        s="[$i/$nSrc]"
        f_lib_print "+++ $s:'$xSrc': ..."

        # >>>   runCompiler
        f_lib_trace ${FUNCNAME[0]} $LINENO "run1" $z_bTrc
        f__compiling $xSrc $g_iExitCode; bRc=$? # compile TestCase
        f_lib_trace ${FUNCNAME[0]} $LINENO "run2" $z_bTrc

        if [ $bRc == $v_TRUE ]; then
            f_lib_puts ";"
            fBdy="${xSrc%.*}"
            fObj=${fBdy}.${z_SCL_extObj}
            if [ -f $fObj ]; then
                g_aRun+=($fObj)
                let iOk+=1
            fi
        else
            f_lib_puts "### save error at:[$LINENO]" $v_COL_ID_red
            eTc+=($xSrc)   #   noBreak
            let iEc+=1
        fi

    done

    #   ready
    f_lib_debug "RESULT.compile OK|EC=:<$iOk>|<$iEc>" $LINENO $z_bDbg

    #   show logFiles
    n=${#g_aRun[@]}
    if [ $z_bDbg == $v_TRUE ]; then
        declare -p g_aRun
        f_lib_debug "n(g.aRun) =: $n" $LINENO $z_bDbg
    fi

    #   check eTc
    n=${#eTc[@]}
    if [ $n != 0 ]; then
        eTcUniq=($( echo "${eTc[@]}" | tr ' ' '\n' | sort -u | tr '\n' ' '))
        s="!!! errors($iEc) Tc found at DIR:=`pwd`"
        f_lib_puts "$s at:<$LINENO>" $v_COL_ID_red
        s=$(declare -p eTcUniq);  f_lib_puts "out2:'$s'"  #   output way1
        s="${eTcUniq[@]}"; f_lib_puts "eTcUniq:$s"        #   output way2
    fi

    #   check aRun
    n=${#g_aRun[@]}
    if [ $n == 0 ]; then
        f_lib_error "num(aRun)==0" $v_COL_ID_red
        exit 1
    fi

}

#   ============================================================================
#   =*= m:  func.perform
#   ============================================================================


function f__performer() {
    #   IN:  srcFile && iCtr && iEc
    #   OUT: bRc,sRc
    local   fObj=$1
    local   sCmd=$2
    local   iCtr=$3
    local   iEc=$4
    local   sMap=${fObj:0:3}
    local   bTrc=$z_bTrc
    sBdy=$( printf "%s_%s_%3.3d" $z_SCL_logSrc_prefix $sMap $iCtr )
    local   sLog="$v_DIR_LOG/$sBdy.log"
    #   *   run BIN
    f_lib_debug "sCmd:=<$sCmd>;iCtr:=<$iCtr>" $LINENO $z_bDbg
    f_lib_trace ${FUNCNAME[0]} $LINENO "iEc:<$iEc>" $z_bTrc
    g_sRc=''
    if [ $z_bLog == $v_TRUE ]; then
        $sCmd 1> $sLog 2> $sLog
        g_sRc=$sLog
    fi

    #   *   fetch returnCode
    iRc=$?
    #   *   check
    f__chkRc $iRc $iEc; bRc=$?
    return $bRc
}


function f_main_performer() {
    #
    #   in :    g_aRun
    declare -i iOk=0
    declare -i iEc=0
    declare -a eTc
    declare -i nSrc=${#g_aRun[@]}
    declare -a aLog
    declare sCmd=""

    f_lib_puts "MODE::run" $v_COL_ID_yellow

    f_lib_trace ${FUNCNAME[0]} $LINENO "performer.while ..." $z_bTrc
    while [ $z_iStressCounter -le $z_nStressFactor ]; do

        f_lib_trace ${FUNCNAME[0]} $LINENO "performer.stress" $z_bTrc
        f_lib_debug "ctr|fac:={$z_iStressCounter}/{$z_nStressFactor}" $LINENO $z_bDbg

        i=0

        for xRun in "${g_aRun[@]}"
        do
            i+=1
            t1="$i/$nSrc"
            t2="$z_iStressCounter/$z_nStressFactor"
            s="[$t1]"
            if [ $z_nStressFactor -gt 1 ]; then
                s="[$t1][$t2]"
            fi
            sTcHead=$s

            # >>>   runPerformer
            f_lib_trace ${FUNCNAME[0]} $LINENO "showPerformStr" $z_bTrc
            f_lib_print "+++ $sTcHead:'${xRun}' ..."

            #   using Interpreter or RAW access
            if [ $z_bDoInterPreter == $v_TRUE ]; then
                sCmd="$z_SCL_INTERPRETER $xRun"
            else
                sCmd=$xRun
            fi

            f_lib_debug "&&&& perform.CMD:=<$sCmd>"   $LINENO $z_bDbg

            n=$z_iStressCounter
            f_lib_debug "nStress:=<$n>"  $LINENO $z_bDbg

            f__performer "$xRun" "$sCmd" "$n" "$g_iExitCode"
            bRc=$? # compile TestCase

            #   return Code
            if [ $bRc == $v_TRUE ]; then
                f_lib_puts ";"
                aLog+=($g_sRc)
                let iOk+=1
            else
                f_lib_puts "?ERR:<$bRc> at:[$LINENO]" $v_COL_ID_red
                eTc+=($xSrc)   #   noBreak
                let iEc+=1
            fi

            f_lib_debug "ready perform" $LINENO $z_bDbg

        done
        let z_iStressCounter+=1
    done

    #   ready
    f_lib_puts "<<< perform.READY  OK=<$iOk> Error=<$iEc>" $v_COL_ID_yellow

    #   errors?, no doubles
    n=${#eTc[@]}
    if [ $n != 0 ]; then
        eTcUniq=($( echo "${eTc[@]}" | tr ' ' '\n' | sort -u | tr '\n' ' '))
        s="!!! errors($iEc) Tc found at DIR:=`pwd`"
        f_lib_puts "$s at:<$LINENO>" $v_COL_ID_red
        s="${eTcUniq[@]}"; f_lib_puts "eTcUniq:$s"  #   output way2
        s=$(declare -p eTcUniq);  f_lib_puts "out2:'$s'"  #   output way1

    fi

    #   show logFiles
    if [ $z_bDbg == $v_TRUE ]; then
        declare -p aLog
    fi
    n=${#aLog[@]}
    if [ $n == 0 ]; then
        f_lib_error "aLog==n" $LINENO
        exit 1
    fi

}


#   ============================================================================
#   =*= m:  func.run
#   ============================================================================

function f_run_getRandom() {
    declare -i p_iMax=$1
    declare -i iRndMin=2
    declare -i iRndMax=$n
    f_lib_random $p_iMax; iRnd=$?
    if [ $iRnd == 1 ]; then
        iRnd=$iRndMin
    elif [ $iRnd -gt $iRndMax ]; then
        iRnd=$iRndMax
    fi
    return $iRnd
}

function f_run_shuffleArray() {
    # IN :g_aRc
    # OUT:g_aRc; g_iRc
    declare -i n=0
    declare -i i=0
    declare -i iRnd=0
    declare -a aTmp
    #   check input array
    n=${#g_aRc[@]}
    if [ $n == 0 ]; then
        return 0
    fi
    #   shuffle my array
    aTmp=( $(shuf -e "${g_aRc[@]}") )
    s="${aTmp[@]}"; f_lib_debug "aTmp=<$s>" $LINENO $z_bDbg
    #   get random
    f_run_getRandom $n iRnd=$?
    #   push l.aTmp=>g.aRc
    g_aRc=()
    for (( i=0; i < ${iRnd}; i++ ));
    do
        sTmp=${aTmp[$i]}
        g_aRc+=($sTmp)
    done
    #   return
    return $iRnd
}



#   ============================================================================
#   =*= m:  func.logging
#   ============================================================================
#

function f_run_appendLogFiles() {
    local sLogfile=$1
    local sRuntime=$2
    local bTrc=$z_bTrc
    local fLog
    local aLog
    local xLog="${v_DIR_LOG}/${g_FEXPAN_log}"
    declare -i i
    declare -i n

    f_lib_trace ${FUNCNAME[0]} $LINENO "cpLogFiles..." $bTrc
    aLog=( $(echo "$xLog") ); n=${#aLog[@]}
    if [ $z_bDbg == $v_TRUE ]; then
        declare -p aLog
    fi

    f_lib_debug "echo nLog==<$n>" $LINENO $z_bDbg
    if [ $n == 0 ]; then
        f_lib_text "noLogFiles" $LINENO
        return 0
    fi
    echo "$g_sLogLine" > $sLogfile
    echo "=L= log.HDR:automatically created at:{$sRuntime} by:${FUNCNAME[0]}" >> $sLogfile
    f_lib_trace ${FUNCNAME[0]} $LINENO "sLogfile:={$sLogfile}" $z_bTrc
    i=1
    for fLog in "${aLog[@]}"; do
        if [ -f $fLog ]; then
            f_lib_puts "=i= APPEND: fLog[$i]={$fLog} >> {$sLogfile}" $v_COL_ID_cyan
            s="=L= log.SHW:[$i/$n]:'$fLog'"
            echo $s >> $sLogfile
            cat $fLog >> $sLogfile
        else
            f_lib_error "??? noFiles found" $LINENO
            exit 1
        fi
        i+=1
    done
    echo "=L= log.EOF" >> $sLogfile
    return 0
}


function f_main_logging()
{
    declare     p_sLogLine=$1
    declare -i  p_bTrc=$2
    declare -i  p_bDbg=$3

#   entry
    f_lib_trace ${FUNCNAME[0]} $LINENO "f:commonLogging" $p_bTrc
    f_lib_debug "p1:[$p_sLogLine]"  $LINENO $p_bDbg

    #   =*= p:  create logFile
    echo "$p_sLogLine" > $z_LOGFILE_tmp

    #   =*= p:  put all logfiles together, make a common logfile
    f_run_appendLogFiles $z_LOGFILE_tmp $z_sDTM_now

    #   =*= p:  echo logLine lastLine
    p_sLogLine="<<< STP:$z_LOG_entry:{$z_sDTM_out}:time.elapsed:{$z_Timer_secs}"
    echo "$p_sLogLine" >> $z_LOGFILE_tmp

    #   =*= p:  copy: log.TMP=>log.OBJ
    f_lib_puts "=e= copy** '$z_LOGFILE_tmp' => '$z_LOGFILE_obj'" $v_COL_ID_cyan
    cp $z_LOGFILE_tmp $z_LOGFILE_obj

    #   =*= p:  move: log.TMP=>log.STD
    f_lib_puts "=e= rename '$z_LOGFILE_tmp' => '$z_LOGFILE_std'" $v_COL_ID_cyan
    mv $z_LOGFILE_tmp $z_LOGFILE_std

    #   =*= p:  show logfile
    f_lib_puts "=l= *created* run-logfile:'$z_LOGFILE_std'" $v_COL_ID_yellow

    #   =*= p:  copy to XOS
    f_lib_trace ${FUNCNAME[0]} $LINENO "copy+" $p_bTrc
    f_lib_show "=x= copy+! '$z_LOGFILE_std' => '$v_DIR_LOG_EXTENDED'"
    cp $z_LOGFILE_std $v_DIR_LOG_EXTENDED

    #   =*= p:  show last logstring
    f_lib_puts "$p_sLogLine" $v_COL_ID_blue

}


#   ============================================================================
#   =*= m:  body
#   ============================================================================


#   intro
s=`basename $BASH_SOURCE`
echo "+++ hello::$s"
sleep 1
clear
sleep 1

#   =*= p:  script-derived
z_SCP="${z_SCP}"
z_SCP_bdy="${z_SCP%.*}"
z_SCP_ext="${z_SCP##*.}"

#   =*= p:  logfile entry::RUN||STP
#   declare -r z_LOG~pre fix='run'
declare -r z_LOG_entry="$z_SCL_name:{$z_SCP}"

#   =*= p:  ShellFileExpanion
declare -r g_FEXPAN_src="${z_SCL_id}??_*.${z_SCL_extSrc}"
declare -r g_FEXPAN_log="${z_SCL_logSrc_prefix}_${z_SCL_id}??_*.${z_SCL_extLog}"

#   =*= p:  RegularExpression
declare -r g_REGEXP_src="^$z_SCL_id[0-9]{2}_[A-Za-z]+\.$z_SCL_extSrc"
declare -r g_REGEXP_bin="^${z_SCL_extSrc}[0-9]{2}_[A-Za-z]+\.${z_SCL_extObj}$"
declare -r g_REGEXP_tmp="\.txt$"

#   misc
declare -r z_LOG_id_sumSep='sum'

#   =*= p:  global return value and results
declare -a g_aRc        #   function return
declare -i g_iRc=0      #   dito
declare -a g_aSrcSum    #   all sources
declare -a g_aSrcNow    #   using for compile aTc
declare -a g_aRun    #   using for compile aTc
declare -i g_iExitCode=0      #   SCP ec get

#   =*= p:  tmp variables
f_lib_trace ${FUNCNAME[0]} $LINENO "set tmp" $z_bTrc
declare -i i
declare -i n
declare -i nSrc
declare -a aTc
declare -i iRc
declare -i iEc
declare -a aTmp
declare s
declare bRc

#   =*= p:  seek my Sources
f_lib_trace ${FUNCNAME[0]} $LINENO "seekMATCH" $z_bTrc
f_expr_fileExpansion; iRc=$?; g_aSrcSum=( ${g_aRc[@]} )
f_expr_regExpression $g_REGEXP_src; iRc=$?; g_aSrcSum=( ${g_aRc[@]} )
n=${#g_aSrcSum[@]};  f_lib_debug "nSrc=<$n>"  $LINENO $z_bDbg
if [ $n -eq 0 ]; then
    f_lib_error "??? noTc<$n> found at DIR:=`pwd`" $LINENO
    exit 1
fi
s="${g_aSrcSum[@]}"; f_lib_debug "aSrc=<$s>"  $LINENO $z_bDbg


#   ---------------------------------------------------------------------------
#   =*= s:  argument handling
#   ---------------------------------------------------------------------------

if  [ "$z_ARG_cmd" == ""  ]     ||
    [ "$z_ARG_cmd" == '?' ]     ||
    [ "$z_ARG_cmd" == 'h' ]     ||
    [ "$z_ARG_cmd" == 'help' ] ; then
    #   *** case.h : help
    f_menu_usage
    exit 1

elif [ "$z_ARG_cmd" == 'c' ]; then
    f_menu_clean
    exit 2

elif [ "$z_ARG_cmd" == '!' ]; then
    f_lib_trace ${FUNCNAME[0]} $LINENO "option:tryAllTc" $z_bTrc
    g_aSrcNow=("${g_aSrcSum[@]}")    #!CRQ-200823:ArrayCopy
    echo "*** !"

elif [ "$z_ARG_cmd" == '+' ]; then
    f_lib_trace ${FUNCNAME[0]} $LINENO "option:tryRndTc" $z_bTrc
    g_aRc=( ${g_aSrcSum[@]} )
    f_run_shuffleArray; iRc=$?
    g_aSrcNow=( ${g_aRc[@]} )

else
    g_aRc=( ${g_aSrcSum[@]} )
    f_menu_checkSingle $z_ARG_cmd iRc=$?
    if [ $iRc -le 0 ]; then
        f_lib_error "!!! wrong TC:'$sTc'" $LINENO
        exit 9
    fi
    g_aSrcNow+=( $z_ARG_cmd )
fi

#   ---------------------------------------------------------------------------
#   =*= s:  argument usage
#   ---------------------------------------------------------------------------


#   =*= p:  show current array
f_lib_trace ${FUNCNAME[0]} $LINENO "show current array..." $z_bTrc
n=${#g_aSrcNow[@]};  f_lib_debug "nSrcNow=<$n>" $LINENO $z_bDbg
s="${g_aSrcNow[@]}"; f_lib_debug "aSrcNow=<$s>" $LINENO $z_bDbg


#   =*= p:  calc Exit-Code
f_lib_trace ${FUNCNAME[0]} $LINENO "calc exit code..." $z_bTrc
f_lib_calcExitCode; g_iExitCode=$?
f_lib_debug "run.exitCode<$g_iExitCode>" $LINENO $z_bDbg

#   =*= p:  LIB.header
f_lib_header "$z_SCP" $LINENO $g_iExitCode; g_iExitCode=$?; g_iRc=$g_iExitCode

#   =*= p:  StressFactor
f_lib_trace ${FUNCNAME[0]} $LINENO "StressFactor" $z_bTrc
declare -i z_iStressCounter=1
declare -i z_nStressFactor=1
x=$z_ARG_opt; f_lib_isNumeric $x; bRc=$?
if [ $bRc == $v_TRUE ] ; then
    #   INPUT: $> SCRIPT <stressfactor> *** case.1
    z_nStressFactor=$x
fi
f_lib_debug "STRESS sid:='$z_LOG_entry'" $LINENO $z_bDbg
f_lib_debug "STRESS.counter:={$z_iStressCounter}" $LINENO $z_bDbg
f_lib_debug "STRESS.factor:={$z_nStressFactor}" $LINENO $z_bDbg

#   =*= p:  start timer
declare -r z_DTM_fmt_now="+%y%m%d%H%M%S"       #   "+%Y%m%d.%H%M%S"
declare -r z_DTM_fmt_out="+%y%m%d:%H%M%S"      # !PHA:only for viewing - not calculation
f_lib_trace ${FUNCNAME[0]} $LINENO "StartTimer" $z_bTrc
z_sTimer_start=$(date +%s.%N)
z_sDTM_out=$(date $z_DTM_fmt_out)           #   for:LogLine
z_sDTM_now=$(date $z_DTM_fmt_now)           #   for:NameOfLogFile
f_lib_debug "Timer.start:={$z_sTimer_start}" $LINENO $z_bDbg
f_lib_debug "DTM.outp:={$z_sDTM_out}" $LINENO $z_bDbg
f_lib_debug "DTM.calc:={$z_sDTM_now}" $LINENO $z_bDbg

#   =*= p:  define logFiles
f_lib_trace ${FUNCNAME[0]} $LINENO "define logfiles" $z_bTrc
z_LOGFILE_std="${v_DIR_LOG}/$z_SCP.log"
z_LOGFILE_tmp="${v_DIR_LOG}/$z_SCP.tmp.log"
z_LOGFILE_obj="${v_DIR_LOG}/${z_SCL_logObj_prefix}_${z_LOG_id_sumSep}_${z_sDTM_now}.log"
f_lib_debug "LOG.std:={$z_LOGFILE_std}" $LINENO $z_bDbg
f_lib_debug "LOG.tmp:={$z_LOGFILE_tmp}" $LINENO $z_bDbg
f_lib_debug "LOG.obj:={$z_LOGFILE_obj}" $LINENO $z_bDbg

#   =*= p:  define logLine
g_sLogLine=">>> RUN:$z_LOG_entry:{$z_sDTM_out}:EC={$g_iExitCode}"
f_lib_puts "$g_sLogLine" $v_COL_ID_blue

#
#   =*= s:  compiler
#

if [ $z_bDoCompile == $v_TRUE ]; then
    f_lib_trace ${FUNCNAME[0]} $LINENO "compiling" $z_bTrc
    declare -a g_aRun
    #   runMe
    f_main_compiler
    #   handle output
    n=${#g_aRun[@]}
    if [ $n == 0 ]; then
        f_lib_error "aRun==n" $LINENO
        exit 1
    fi
    #   handle output
    if [ $z_bDoInterPreter == $v_TRUE ]; then
        f_lib_trace ${FUNCNAME[0]} $LINENO "compile+interpret" $z_bTrc
        g_aRun=( ${g_aSrcNow[@]} )  #   JAV
    fi
else
    f_lib_trace ${FUNCNAME[0]} $LINENO "onlyInterpreter" $z_bTrc
    g_aRun=( ${g_aSrcNow[@]} )      # take source => PRL, PYT, RBY
fi

if [ $z_bDbg == $v_TRUE ]; then
    f_lib_trace ${FUNCNAME[0]} $LINENO "show results" $z_bTrc
    declare -p g_aRun
fi



#   ---------------------------------------------------------------------------
#   =*= s:  performer
#   ---------------------------------------------------------------------------

f_lib_trace ${FUNCNAME[0]} $LINENO "performer" $z_bTrc
if [ $z_bDoInterPreter == $v_TRUE ]; then
    f_lib_trace ${FUNCNAME[0]} $LINENO "interpreter" $z_bTrc
fi
f_main_performer


#   ---------------------------------------------------------------------------
#   =*= s:  calc elapsed time
#   ---------------------------------------------------------------------------

f_lib_trace ${FUNCNAME[0]} $LINENO "calcTime" $v_TRUE

#   =*= p:  calculate elapsed time
declare bUsing=$v_TRUE
if [ $bUsing == $v_TRUE ]; then
    f_lib_trace ${FUNCNAME[0]} $LINENO "calc elapsed time..." $z_bTrc
    z_Timer_stop=$(date +%s.%N);
    z_sDTM_out=$(date $z_DTM_fmt_out)
    z_Timer_calc=$(echo "$z_Timer_stop-$z_sTimer_start" | bc)
    n=2
    z_Timer_secs=$( printf "%.*f\n" $n $z_Timer_calc )
fi

#   ---------------------------------------------------------------------------
#   =*= s:  logging
#   ---------------------------------------------------------------------------

declare bUsing=$v_TRUE
if [ $bUsing == $v_TRUE ]; then
    bTrc=$v_TRUE
    bDbg=$v_TRUE
    f_lib_trace ${FUNCNAME[0]} $LINENO "perform logging" $z_bCommonTrc
    f_lib_debug "perform logging" $LINENO $z_bDbg
    f_main_logging \
        "$g_sLogLine" $bTrc $bDbg

fi
#
#   =*= :footer
#
f_lib_footer "$z_SCP" $LINENO $g_iRc
