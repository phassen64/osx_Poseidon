function f_ini_display() {
    sudo apt-get install lightdm -y
    sudo dpkg-reconfigure lightdm
}

function f_ini_dpkg_restore() {
    sudo apt-get update
    sudo apt-get --fix-broken install
    sudo dpkg --configure -a
}

function f_ini_upgrade() {
    sudo apt-get update
    sudo apt-get list --upgradable
    sudo apt-get upgrade
}

function f_ini_fireWall() {
	sudo apt-get install ufw
	sudo ufw allow 3389/tcp
	#   Reload your firewall settings:
	sudo ufw reload
}

function f_ini_xRdp() {
	sudo apt-get update
	sudo apt-get install xrdp -y
}

function f_ini_ruby() {
   	sudo apt install ruby
   	ruby --version
}

function f_ini_python() {
	sudo apt-get update
	sudo apt-get install python3 python3-pip python3-venv -y
	python3 --version
	pip3 --version
}

function f_ini_pwsh() {

    # download
    #   wget https://github.com/PowerShell/PowerShell/releases/download/v7.6.6/powershell-lts_7.6.6-1.deb_amd64.deb

    # Install the package
    sudo dpkg -i powershell-lts_7.6.6-1.deb_amd64.deb

    # Resolve any missing dependencies automatically
    sudo apt-get install -f
}

function f_ini_VsCode() {
    d='code_1.138.0-1789458813_amd64.deb'
    sudo dpkg -i $d
}


f_ini_hdd_secondaryStorage() {

    local p_iMode=$1

    #   define my secondary storage

    #   hddName
    d=/dev/disk/by-id/google-d-260922-eros

    #   UUID
    i=117f965f-9dd8-418e-92a9-2c3f0a1aaf28

    #   case
    if [ $p_iMode == 1 ]; then
        #   m:  show
        ls -l /dev/disk/by-id/google-*
    elif [ $p_iMode == 2 ]; then
        #   m:  format
        sudo mkfs.ext4 -m 0 -E lazy_itable_init=0,lazy_journal_init=0,discard $d
    elif [ $p_iMode == 3 ]; then
        #   m:  verify.format
        sudo blkid $d
    elif [ $p_iMode == 4 ]; then
        #   mount
        sudo mkdir -p /mnt/disks/data
        sudo mount -o discard,defaults $d /mnt/disks/data
        sudo chmod a+w /mnt/disks/data
    elif [ $p_iMode == 5 ]; then
        #   verify.mount
        df -h /mnt/disks/data
    else
        echo "hello hdd2"
    fi
}

