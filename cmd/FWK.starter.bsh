#   desktop environments - muss nach Cinnamon aufgerufen werden
function f_ini_gui_DE_configure() {
    sudo update-alternatives --config x-session-manager
}

#   https://docs.cloud.google.com/architecture/chrome-desktop-remote-on-compute-engine#objectives
function f_ini_gui_DE_xfce() {
    sudo DEBIAN_FRONTEND=noninteractive \
        apt install --assume-yes xfce4 desktop-base dbus-x11 xscreensaver
    sudo bash -c 'echo "exec /etc/X11/Xsession /usr/bin/xfce4-session" > /etc/chrome-remote-desktop-session'
    sudo systemctl disable lightdm.service
    sudo apt install --assume-yes task-xfce-desktop
}

function f_ini_gui_DE_cinnamon() {
    sudo apt-get install cinnamon-desktop-environment -y
    sudo apt-get tasksel
    sudo apt-get install lightdm -y
    sudo dpkg-reconfigure lightdm
    sudo apt update && sudo apt install task-cinnamon-desktop
    sudo update-alternatives --config x-session-manager
}


#   ===========================================================================
#  	m:  F.env
#   ===========================================================================

function f_env_reboot() {
    i=3
    echo "doReboot in [$i]" & sleep $i
    sudo reboot
}

function f_env_set_root() {
    sudo passwd root
}

function f_env_set_host() {
    #   parameter
    local p_sHostName=$1
    #   set
    sudo hostnamectl set-hostname $p_sHostName
    #   Find the line pointing and set name
    sudo nano /etc/hosts
    #   Verify the Change
    #   Run this command to verify that the hostname updated:
    hostnamectl
}

function f_env_prompt() {
    #   fetch parameter
    local iPrompt=$1
    #   init
    export PS1="$ "

    #   case
    if [ $iPrompt == 1 ]; then
        export PS1="\u@\h \$ "          # user & host
    elif [ $iPrompt == 2 ]; then
        export PS1="\u@\h:\w \$ "       # user & host &dirPath
    elif [ $iPrompt == 3 ]; then
        export PS1="\w \$ "             # dirPath
    elif [ $iPrompt == 4 ]; then
        export PS1="[\t] \w \$ "        # time & dirPath
    elif [ $iPrompt == 5 ]; then        # time & short dirPath
        export PS1="[\t]::[\W] \$ " 
    elif [ $iPrompt == 6 ]; then        # not working
        if [ `pwd` == $HOME ]
            then export PS1="[\t] ~ \$ "
            else export PS1="[\t] ~/\W \$ " 
        fi     
    else
        export PS1="\$ "
    fi
}

#   ===========================================================================
#  	m:  F.helper
#   ===========================================================================

#
#  s:  F.clearSreen
#

function f_fwk_clearScreen() {
    clear && echo -en "\e[3J"
}

#
#  	s:	F.alias
#

function f_fwk_aliasGet() {
    s='GET alias...'; echo "$s"; sleep 1
	alias| grep +
}

function f_fwk_aliasSet(){
    #   echo "f:aliasSet:BEG"
	#   =:= m:alias
    alias +ali='f_fwk_aliasGet'
    alias +aliSet='f_fwk_aliasSet; alias | grep +';
	#   =:= m:go
    alias +go='source $v_STARTER'
    alias +start=+go
	#   =:= m:cd
    alias +cdhome='cd $HOME && pwd'
    alias +cdcmd='cd $v_FWK_dirCommand && pwd'
    alias +cdlog='cd $v_FWK_dirLogging && pwd'
    alias +cdtmp='cd $v_FWK_scratchDir && pwd'
    alias +cdtemp=+cdtmp
    alias +cdvcs='cd $v_VCS && pwd'
    alias +cdvcs_TS='cd $v_VCS/testSuite && pwd'
	#   =:= m:cd.user
    alias +cdusr='cd $v_USR_dirDocRoot && pwd'
    alias +cdwrk='cd $v_USR_dirWorkshop && pwd'
    alias +cdwrkSrc='cd $v_USR_dirWorkshop/source && pwd'
    alias +cdwrkObj='cd $v_USR_dirWorkshop/object && pwd'
    alias +cdwrkTmp='cd $v_USR_dirWorkshop/temp && pwd'
    alias +cdwrkLog='cd $v_USR_dirWorkshop/logg && pwd'
    alias +cdprj=+cdwrkObj
	#   =:= m:cd.tutor
    alias +cdtutor='cd $v_FWK_dirTutor && pwd'
    alias +cdb='cd $v_FWK_dirTutor/bsh && pwd'
    alias +cdc='cd $v_FWK_dirTutor/c && pwd'
    alias +cdc89=+cdc
    alias +cdp='cd $v_FWK_dirTutor/pl && pwd'
    alias +cdr='cd $v_FWK_dirTutor/rb && pwd'
    alias +cdy='cd $v_FWK_dirTutor/py && pwd'
    alias +cdcpp='cd $v_FWK_dirTutor/cpp && pwd'
    alias +cdw='cd $v_FWK_dirTutor/wps && pwd'
    alias +cdwps=+cdw
	#   =:= m:interpreter
    alias +p='perl'
    alias +r='ruby'
    alias +y='python3'
	#   =:= m:interpreter.python
    alias python='python3'
	#   =:= m:clr
    alias +cls='clear'
    alias +clr='+cls'
	#   =:= m:env
    alias +fct='f_fwk_function_show'
    alias +var='f_fwk_variable_show'
	#   =:= m:ls
    alias +ls='ls -l'
    alias +ll='ls -al'
	#   =:= m:gcc
    alias +gcc='gcc -std=c89 -Wall -Werror'
    alias +g++='g++ -Wall -Werror'
	#   =:= m:remove
    alias +rm='rm -rf'
	#   =:= m:misc
    alias +reboot='f_env_reboot'
    #   echo "f:aliasSet:END"
    return 1
}

function f_fwk_aliasClear() {
    s='CLEAR alias...'; echo "$s"; sleep 1
    unalias -a
    sleep 1
    alias
    alias +alias=f_fwk_aliasSet; alias +alias
}

function f_fwk_aliasReset() {
    s='RESET alias...'; echo "$s"; sleep 1
    unalias -a
    sleep 1
    f_fwk_aliasSet
}

function f_fwk_interpreter_check() {
    echo "f:interpreterCheck"
    g++ --version
    perl --version
    python3 --version
    ruby --version
    pwsh --version
}

function f_fwk_variable_show() {
    #   echo "f:varShow"
    printenv | grep "^v_"  | sort
}

#   ===========================================================================
#  	m:  F.library
#   ===========================================================================

function f_fwk_info() {

    #   s:  var.Global
    v_SCP=`basename $BASH_SOURCE`

    #   s:  scpId
    if [ -z $1 ]; then
        v_SCP__id=$OSTYPE   # gehtNICHT
    else
        v_SCP__id=$1
    fi

    #   date
    v_DTM_long=`echo $(date '+%Y-%m-%d__%H:%M:%S')`
    echo "+ date: {$v_DTM_long}"
    echo "+ bashName: {$v_SCP}"
    echo "+ scpId: {$v_SCP__id}"

    #   Server & Sser
    v_USR=$USER
    echo "+ svr: {$HOSTNAME}"
    echo "+ usr: {$v_USR}"
}

function f_fwk_function_show() {
    declare -F | grep '^declare -f f_'
}

function f_fwk_variable_initialize () {

    #   FWK starter
    v_FWK_pthStarter=$v_STARTER && export v_FWK_pthStarter

    #   dir.DocRoot
    v_USR_dirDocRoot=$HOME/Documents && export v_USR_dirDocRoot
    #   workshop     
    v_DIR=$v_USR_dirDocRoot/workshop
    v_USR_dirWorkshop=$v_DIR && export v_USR_dirWorkshop

    #   dir.VCS
    v_VCS=$HOME/VCS  && export v_VCS

    #   dir.repo.FWK
    v_VCS_fwk=$v_VCS/fwk && export v_VCS_fwk

    #   dir.fwk.cmd
    v_DIR=$v_VCS_fwk/cmd
    v_FWK_dirCommand=$v_DIR && export v_FWK_dirCommand

    #   FWK library needed for libary
    v_FWK_pthLibrary="$v_FWK_dirCommand/LIB.inc.bsh" && export v_FWK_pthLibrary

    #   tutor
    v_DIR=$v_VCS_fwk/console
    v_FWK_dirTutor=$v_DIR && export v_FWK_dirTutor

    #   scratch == tempDir
    v_DIR=$v_VCS_fwk/temp
    v_FWK_dirScratch=$v_DIR && export v_FWK_dirScratch
    v_TMP=$v_FWK_dirScratch && export v_TMP

    #   loging Dir
    v_DIR=$v_VCS_fwk/logging
    v_FWK_dirLogging=$v_DIR && export v_FWK_dirLogging

    #   exitCode
    declare -i i=99
    v_FWK_iExit=$i && export v_FWK_iExit

}

function f_fwk_isFile {
    local bRc=$v_FALSE
    if [ -f $1 ]; then bRc=$v_TRUE; fi    
    return $bRc
}

function f_fwk_isDirectory {
    local bRc=$v_FALSE
    if [ -d $1 ]; then bRc=$v_TRUE; fi
    return $bRc
}

#   ===========================================================================
#  	b:  B.body
#   ===========================================================================

#   s:  clear host
clear

#   s:  var.Global
v_SCP=`basename $BASH_SOURCE`

#   s:  header
v_DTM=`echo $(date '+%y%m%d|%H%M%S')`
echo "=== fwk.beg::{$v_DTM}:{$HOSTNAME}"
sleep 1

#   s:  show.PWD
v_PWD=`pwd`
echo "+ pwd: {$v_PWD}"
export v_PWD

#   show starter
echo "+ str: {$v_STARTER}"

#   s:  run some
f_fwk_aliasSet

#   s:  run variable

#   echo "init.var"
f_fwk_variable_initialize

#   s:  boolean - no export
declare -i v_TRUE=0
declare -i v_FALSE=99

#   s:  set prompt - only short dirName
f_env_prompt 5

#   s:  show more if random
declare -i r=$RANDOM
v_FWK_iRandom=$r && export v_FWK_iRandom
if [ $v_FWK_iRandom -lt 1000 ]
then
    f_fwk_info
else
    echo "+ rnd: {$v_FWK_iRandom} -> noInfoMore."
fi

#   s:  footer
v_DTM=`echo $(date '+%y%m%d|%H%M%S')`
echo "=== fwk.end::{$v_DTM}:{$v_FWK_iExit}"
