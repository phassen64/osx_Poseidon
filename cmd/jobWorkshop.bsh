#!/bin/bash
#  	***************************************************************************
#   cron.job	    dtm:[2026-10-03].vcs
#  	***************************************************************************
#   copy my logBook

#   usage:
#       +   edit crontab
#           bash$   crontab -e
#           nano$   key:[PgnDwn]
#       +   show crontab entry
#           bash$   crontab -l | tail -1


sFmt="+%Y-%m-%d__%H:%M:%S"
sDtm=$(echo `date $sFmt`)

dSrc="$HOME/Documents/basic"
if [ ! -d $dSrc ]
then
    return 99
fi

dObj="$HOME/VCS/fwk/basic"
if [ ! -d $dObj ]
then
    return 99
fi

#   fileName
fnam='log-X.txt'
dObj="$HOME/VCS/fwk/basic/$fNam"
if [ ! -d $dObj ]
then
    return 99
fi

printf "=== entry:[%s]\n" "$sDtm"
printf "    dirSrc:[%s]\n" "$dSrc"
printf "    dirObj:[%s]\n" "$dObj"
printf "    logbook.copy: dirSrc -> dirObj\n"

#   perform job
cp $dSrc/log*.txt $dObj