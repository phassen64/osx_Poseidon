#!/bin/bash
#  	***************************************************************************
#   cron.job	    dtm:[2026-10-03].vcs
#  	***************************************************************************
#   copy my logBook

sFmt="+%Y-%m-%d__%H:%M:%S"
sDtm=$(echo `date $sFmt`)

dSrc="$HOME/Documents/basic"
if [ ! -d $dSrc ]
then
    return 99
fi

dObj="$HOME/VCS/fwk/basic"
if [ ! -d $dObj ]
then
    return 99
fi

printf "=== entry:[%s]\n" "$sDtm"
printf "dirSrc:[%s]\n" "$dSrc"
printf "dirObj:[%s]\n" "$dObj"
printf "logbook.copy: dirSrc -> dirObj\n"

#   perform job
cp $dSrc/*.log $dObj