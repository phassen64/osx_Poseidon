sFmt="+%Y-%m-%d__%H:%M:%S"
sDtm=$(echo `date $sFmt`)

dSrc="$HOME/Documents/workshop/object"
if [ ! -d $dSrc ]
then
    return 99
fi

dObj="$HOME/VCS/fwk/console/bsh_laboratory"
if [ ! -d $dObj ]
then
    return 99
fi

printf "=== entry:[%s]\n" "$sDtm"
printf "dirSrc:[%s]\n" "$dSrc"
