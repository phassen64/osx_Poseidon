function f_ini_nameServer() {
    sudo apt update
    sudo apt install bind9 bind9utils dnsutils
    sudo systemctl start bind9
    sudo systemctl enable bind9
}

function f_ini_Chrome_Remote_Desktop() {
    wget https://dl.google.com/linux/direct/chrome-remote-desktop_current_amd64.deb
    sudo apt install -y ./chrome-remote-desktop_current_amd64.deb
}

function f_ini_desktop_environment_cinnamon() {
    sudo apt-get install cinnamon-desktop-environment -y
    sudo apt-get tasksel
    sudo apt-get install lightdm -y
    sudo dpkg-reconfigure lightdm
    sudo apt update && sudo apt install task-cinnamon-desktop
    sudo update-alternatives --config x-session-manager
}

#   ===========================================================================
#  	m:  F.env
#   ===========================================================================

function f_env_reboot() {
    i=3
    echo "doReboot in [$i]" & sleep $i
    sudo reboot
}

function f_env_set_root() {
    sudo passwd root
}

function f_env_set_host() {
    #   parameter
    local p_sHostName=$1
    #   set
    sudo hostnamectl set-hostname $p_sHostName
    #   Find the line pointing and set name
    sudo nano /etc/hosts
    #   Verify the Change
    #   Run this command to verify that the hostname updated:
    hostnamectl
}

function f_env_prompt() {
    #   fetch parameter
    local iPrompt=$1
    #   init
    export PS1="$ "
    #   case
    if [ $iPrompt == 1 ]; then
        export PS1="\u@\h \$ "          # user & host
    elif [ $iPrompt == 2 ]; then
        export PS1="\u@\h:\w \$ "       # user & host &dirPath
    elif [ $iPrompt == 3 ]; then
        export PS1="\w \$ "             # dirPath
    elif [ $iPrompt == 4 ]; then
        export PS1="[\t] \w \$ "        # time & dirPath
    elif [ $iPrompt == 5 ]; then
        export PS1="[\t] ~/\W \$ "     # time & short dirPath
    else
        export PS1="\$ "
    fi
}

#   ===========================================================================
#  	m:  F.helper
#   ===========================================================================

#
#  s:  F.clearSreen
#

function f_fwk_clearScreen() {
    clear && echo -en "\e[3J"
}

#
#  	s:	F.alias
#

function f_fwk_aliasGet() {
    s='GET alias...'; echo "$s"; sleep 1
	alias| grep +
}


function f_fwk_aliasSet(){
    #   echo "f:aliasSet:BEG"
	#   =:= m:alias
    alias +ali='f_fwk_aliasGet'
    alias +aliSet='f_fwk_aliasSet; alias | grep +';
	#   =:= m:go
    alias +go='source $v_STARTER'
    alias +start=+go
	#   =:= m:cd
    alias +cdhome='cd $HOME && pwd'
    alias +cdcmd='cd $v_FWK_commandDir && pwd'
    alias +cdlog='cd $v_FWK_loggingDir && pwd'
    alias +cdtmp='cd $v_FWK_scratchDir && pwd'
    alias +cdtemp=+cdtmp
    alias +cdvcs='cd $v_VCS && pwd'
    alias +cdvcs_TS='cd $v_VCS/testSuite && pwd'
	#   =:= m:cd.tutor
    alias +cdtutor='cd $v_FWK_tutorDir && pwd'
    alias +cdb='cd $v_FWK_tutorDir/bsh && pwd'
    alias +cdc='cd $v_FWK_tutorDir/c && pwd'
    alias +cdc89=+cdc
    alias +cdp='cd $v_FWK_tutorDir/pl && pwd'
    alias +cdr='cd $v_FWK_tutorDir/rb && pwd'
    alias +cdy='cd $v_FWK_tutorDir/py && pwd'
    alias +cdcpp='cd $v_FWK_tutorDir/cpp && pwd'
    alias +cdw='cd $v_FWK_tutorDir/wps && pwd'
    alias +cdwps=+cdw
	#   =:= m:interpreter
    alias +p='perl'
    alias +r='ruby'
    alias +y='python3'
	#   =:= m:interpreter.python
    alias python='python3'
	#   =:= m:clr
    alias +cls='clear'
    alias +clr='+cls'
	#   =:= m:env
    alias +fct='typeset -F | grep f_'
    alias +var='f_fwk_variableShow'
	#   =:= m:ls
    alias +ls='ls -l'
    alias +ll='ls -al'
	#   =:= m:gcc
    alias +gcc='gcc -std=c89 -Wall -Werror'
    alias +g++='g++ -Wall -Werror'
	#   =:= m:remove
    alias +rm='rm -rf'
	#   =:= m:misc
    alias +reboot='f_env_reboot'
    #   echo "f:aliasSet:END"
    return 1
}

function f_fwk_aliasClear() {
    s='CLEAR alias...'; echo "$s"; sleep 1
    unalias -a
    sleep 1
    alias
    alias +alias=f_fwk_aliasSet; alias +alias
}

function f_fwk_aliasReset() {
    s='RESET alias...'; echo "$s"; sleep 1
    unalias -a
    sleep 1
    f_fwk_aliasSet
}


function f_fwk_interpreter_check() {
    echo "f:interpreterCheck"
    g++ --version
    perl --version
    python3 --version
    ruby --version
}

function f_fwk_variableShow() {
    #   echo "f:varShow"
    printenv | grep "^v_"  | sort
}

#   ===========================================================================
#  	m:  F.library
#   ===========================================================================

function f_fwk_info() {

    #   s:  var.Global
    v_SCP=`basename $BASH_SOURCE`

    #   s:  scpId
    if [ -z $1 ]; then
        v_SCP__id=$OSTYPE   # gehtNICHT
    else
        v_SCP__id=$1
    fi

    #   date
    v_DTM_long=`echo $(date '+%Y-%m-%d__%H:%M:%S')`
    echo "+ date: {$v_DTM_long}"
    echo "+ bashName: {$v_SCP}"
    echo "+ scpId: {$v_SCP__id}"

    #   Server & Sser
    v_USR=$USER
    echo "+ svr: {$HOSTNAME}"
    echo "+ usr: {$v_USR}"
}


#   ===========================================================================
#  	b:  B.body
#   ===========================================================================

#   s:  clear host
clear

#   s:  var.Global
v_SCP=`basename $BASH_SOURCE`

#   s:  header
v_DTM=`echo $(date '+%y%m%d|%H%M%S')`
echo "=== fwk.beg::{$v_DTM}:{$HOSTNAME}"
sleep 1

#   s:  var.exitCode
declare -i i=88
v_FWK_exitCode=$i
export v_FWK_exitCode

#   s:  run some
f_fwk_aliasSet

#   s:  show.PWD
v_PWD=`pwd`
echo "+ pwd: {$v_PWD}"
export v_PWD

#   show starter
echo "+ str: {$v_STARTER}"

#   show more
declare -i v_RND
v_RND=$RANDOM
if [ $v_RND -lt 1000 ]
then
    f_fwk_info
else
    echo "+ rnd: {$v_RND} -> noInfoMore."
fi
export v_RND

#   s:  set prompt - only short dirName
f_env_prompt 5


#   DocRoot
v_USR_docRoot=$HOME/Documents && export v_USR_docRoot

#   FWK starter
v_FWK_starter=$v_STARTER && export v_FWK_starter

#   dir
v_DIR=$v_USR_docRoot/cmd
v_FWK_commandDir=$v_DIR && export v_FWK_commandDir

#   FWK library needed for libary
v_FWK_library=$v_FWK_commandDir && export v_FWK_library

#   tutor
v_DIR=$v_USR_docRoot/console
v_FWK_tutorDir=$v_DIR && export v_FWK_tutorDir

#   scratch == tempDir
v_FWK_scratchDir=$v_USR_docRoot/temp && export v_FWK_scratchDir
v_TMP=$v_FWK_scratchDir && export v_TMP

#   loging Dir
v_FWK_loggingDir=$v_USR_docRoot/logging && export v_FWK_loggingDir

#   other dirs
v_VCS=$v_USR_docRoot/repository && export v_VCS

#   =*= s:  ready
v_DTM=`echo $(date '+%y%m%d|%H%M%S')`
echo "=== fwk.end::{$v_DTM}:{$v_FWK_exitCode}"
