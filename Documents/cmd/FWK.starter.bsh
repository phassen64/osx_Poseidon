function f_ini_display() {
    sudo apt-get install lightdm -y
    sudo dpkg-reconfigure lightdm
}

function f_ini_dpkg_restore() {
    sudo apt-get update
    sudo apt-get --fix-broken install
    sudo dpkg --configure -a
}

function f_ini_upgrade() {
    sudo apt-get update
    sudo apt-get list --upgradable
    sudo apt-get upgrade
}

function f_ini_fireWall() {
	sudo apt-get install ufw
	sudo ufw allow 3389/tcp
	#   Reload your firewall settings:
	sudo ufw reload
}

function f_ini_xRdp() {
	sudo apt-get update
	sudo apt-get install xrdp -y
}

#   https://docs.cloud.google.com/architecture/chrome-desktop-remote-on-compute-engine#objectives
function f_ini_DesktopEnvironment_xfce() {
    sudo DEBIAN_FRONTEND=noninteractive \
        apt install --assume-yes xfce4 desktop-base dbus-x11 xscreensaver
    sudo bash -c 'echo "exec /etc/X11/Xsession /usr/bin/xfce4-session" > /etc/chrome-remote-desktop-session'
    sudo systemctl disable lightdm.service
    sudo apt install --assume-yes task-xfce-desktop
}

