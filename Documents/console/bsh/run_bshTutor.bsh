#!/bin/bash

#
#   =*= :Tutorial 2020-08 <BSH>
#

#   m01:functions
#   m02:body

<<  =*=
    Tutorial 2020-08-18
    +   usage: $>. {thisScript} < {TC} || {opt} > [{stressFactor}:=1]
    +   Examples:
        case.h:: $> . run                   # opt:{'','?','h','help'} => show help
        case.c:: $> . run c                 # opt:{'c'}   : rm files
        case.1:: $> . run !                 # run all TC 1x
        case.2:: $> . run ! 5               # run all TC 5x
        case.2:: $> . run + 5               # run 1...max=rnd() TC 5x
        case.3:: $> . run <b01_*.bsh> 3     # run tc=b01  run:3x times
=*=

#   ===========================================================================
#   =*= :m01:functions
#   ===========================================================================

f_run_usage() {
    echo    "usage: $>. {'$v_SCP'} <opt|tc> [{stressFactor}:=1]"
    echo    "with :<opt>=   :   ..."
    echo    "'',?,h,help    :   show help"
    echo    "!              :   run all TC"
    echo    "+              :   run {1..max} TC"
    echo    "i              :   info"
    echo    "c              :   rm tmp logfiles"
    echo    "s              :   save logfiles"
}


#
#   =*= :   helper
#

function f_run_matchFiles() {
    local sRex=$1
    declare -i i
    v_iRc=0
    v_aRc=()
    for xFile in `ls`
    do
        if [ -f "$xFile" ]; then
            i+=1
            if [[ $xFile =~ $sRex ]]; then
                #   echo "matchX:[$i]:=$xFile"
                v_iRc+=1
                v_aRc+=( $xFile )
            fi
        fi
    done
    return $v_iRc
}

function f_run_rmLogFiles() {
    local bTrc=$v_FALSE
    local -i i=0
    f_lib_trace ${FUNCNAME[0]} $LINENO "remove logfiles" $bTrc
    local a="$v_DIR_LOG/b??*.log"
    local b="$v_DIR_LOG/$v_SCP_bdy*.log"
    local c="${v_DIR_LOG}/${v_IDX_lid}_*.log"
    local aLog=( $(echo "$a") )
    local bLog=( $(echo "$b") )
    local cLog=( $(echo "$c") )
    #   s="${cLog[@]}"; echo "$s"
    local xLog=( ${aLog[@]} ${bLog[@]} ${cLog[@]} )
    if [ $bTrc -eq $v_TRUE ] ; then
        declare -p xLog
        sleep 1
    fi
    for xFile in "${xLog[@]}"
    do
        i+=1
        if [ -f $xFile ]; then
            printf "remove:[%2.2d]:'%s'\n" $i $xFile
            rm -f $xFile 2> /dev/null
        fi
    done
}

function f_run_appendLogFiles() {
    local bTrc=$v_FALSE
    local vLogfile=$1
    local vRuntime=$2
    declare -i i=0
    declare -i n=0
    i=0
    echo "=L= log.HDR:automatically created at:{$vRuntime} by:${FUNCNAME[0]}" >> $vLogfile
    echo "$v_LOGSTR" > $vLogfile
    n=${#v_aLog[@]}
    for fLog in "${v_aLog[@]}"
    do
        i+=1
        if [ -f $fLog ]; then
            f__puts "=i= APPEND: fLog[$i]={$fLog} >> {$vLogfile}"
            s="=L= log.SHW:[$i/$n]:'$fLog'"
            echo $s >> $vLogfile
            #   printf "found.log:[%2.2d]:'%s'\n" $i $fLog
            cat $fLog >> $vLogfile
        else
            echo "=e= noFile[$i]: {$fLog}"
        fi
    done
    echo "=L= log.EOF" >> $vLogfile
    return 0
}

function f_run_calcExitCode() {
    #   avoid exitCode =~lineNo conflict
    #   iEc={min...max} :   error
    #   iEc={0}         :   reserved-error
    #   iEc={1}         :   reserved-error
    #   iEc={2..9}      :   reserved-warnings
    #   REM: problem: bash returns only 1byte integers
    local n=$v_iEc_max-$v_iEc_min+1
    local i=$(( ( RANDOM % $n ) + $v_iEc_min )) #   iEc:={iEcMin...iEcMax}
    f_lib_trace ${FUNCNAME[0]} $LINENO "EXIT calculated :: iEc:=<$i>" $bTrc
    return $i       # !REM: BASH never more than 255
}

function f_run_compiler() {

    local   sScp=$1
    local   iCtr=$2
    local   iEc=$3
    local   sMap=${sScp:0:3}
    local   sDir=$v_DIR_LOG
    local   sDTM=$(date $v_sFMT_now)    # each logFile has owntime
    local -i iRc=0
    local   bTrc=$v_FALSE
    local   sPrx='BSH'
    local   sBdy=$( printf "%s_%s_%3.3d" $sPrx $sMap $iCtr )
    local   sLogOut="$sDir/$sBdy.log"
    local   sLogErr="$sDir/$sBdy.err.tmp.log"

    #   echo "<<< LogOut=:$sLogOut"
    #   echo "\n<<< iEc=:$iEc"
    $v_COMPILER $sScp $iEc 1> $sLogOut 2> $sLogOut  # only 1 file
    iRc=$(echo $?)
    v_aLog+=("$sLogOut")

    #   =*= : handle return code
    iNL=$v_LIB__PRT_noNLnoPx
    if [ $iRc == $iEc ]; then
        #   meaning: has used external Ec
        f_lib_print "<<< OK! :: iRc=iEc=:<$iRc>" $iNL $v_COL_ID_green
        return $v_TRUE
    elif [ $iRc == 0 ] ; then
        #   meaning: standard OK
        f_lib_print "<<< iRc==0 ok?" $iNL $v_COL_ID_yellow
        return $v_TRUE
    elif [ $iRc == $v_iEc_glb ]; then
        #   meaning: standard old return code
        f_lib_print "<<< iRc<$iRc>==iEc.glb:ok" $iNL $v_COL_ID_blue
        return $v_TRUE
    elif [ $iRc == $v_iEc_std ]; then
        #   meaning: standard if python
        f_lib_print "<<< iRc<$iRc>==iEc.std:ok" $iNL $v_COL_ID_yellow
        return $v_TRUE
    elif [ $iRc == 1 ] ; then
        #   meaning: standard error
        f_lib_print "<<< iRc:<$iRc>:?nok" $iNL $v_COL_ID_red
        return $v_FALSE
    elif [ $iRc -lt $v_iEc_min ]; then
        #   meaning: warning
        f_lib_print "<<< iRc:<$iRc>LT<$v_iEc_min>:?warning" $iNL $v_COL_ID_yellow
        return $v_TRUE
    elif [ $iRc -gt $v_iEc_max ]; then
        #   meaning: error overflow
        f_lib_print "<<< iRc:<$iRc>:errorOverflow:?nok" $iNL $v_COL_ID_red
         return $v_FALSE
    else
        #  meaning: error
        f_lib_trace ${FUNCNAME[0]} $LINENO "if" $bTrc
        f_lib_print "<<< iRc:<$iRc>:?nok" $iNL $v_COL_ID_red
    fi

    f_lib_trace ${FUNCNAME[0]} $LINENO "End" $bTrc
    return $v_FALSE
}

#   ===========================================================================
#   =*= :m02:body
#   ===========================================================================

#   #   input
v_DIR_TMP=$v_FWK_scratchDir
v_DIR_LOG=$v_FWK_scratchDir
v_DIR_LOG_EXTENDED=$v_FWK_loggingDir

#   =*= :   header
v_SCP=`basename $BASH_SOURCE`
v_SCP_bdy="${v_SCP%.*}"
v_SCP_ext="${v_SCP##*.}"

#   =*= :   load library
source LIB.inc.bsh

#   =*= :   color
f_lib_colorInit
clear

#   =*= :   init
bTrc=$v_FALSE
bDbg=$v_FALSE  # verbose
bLog=$v_FALSE
declare -i i
declare -i n
declare -a aTc
declare -i nTc
declare -i iEc=0
declare -i iRc=0
declare -i iStressCounter=1
declare -i nStressFactor=1
declare -i iStressMax=10       # maximal 10 times stress

f_lib_trace ${FUNCNAME[0]} $LINENO "DirLog:={$v_DIR_LOG}" $bTrc
f_lib_debug  "SCP:$v_SCP"       $LINENO     $bDbg
f_lib_debug  "BDY:$v_SCP_bdy"   $LINENO     $bDbg
f_lib_debug  "EXT:$v_SCP_ext"   $LINENO     $bDbg

#   =*= :   id
v_Nme='TUTOR'
v_SID="$v_Nme:{$v_SCP}"
f_lib_debug "=i= SID:'$v_SID' at:<$LINENO>" $LINENO $bDbg

#   =*= :   init ReturnValues
declare -i v_iRc
declare v_sRc

#   =*= :   init other globals
declare -a v_aLog
v_aLog=()

#   *=* :   defined exit codes
v_iEc_min=10                # offset to Ec range
v_iEc_max=210               # => iEc:={min,...,max} <= 255
v_iEc_std=100               # used by python
v_iEc_glb=$v_FWK_exitCode   # global one
f_lib_debug "iEc:'$v_iEc_glb'" $LINENO $bDbg

#   =*= :   any NameID
v_COMPILER='bash'       #   compiler
v_IDX_sid='b'           #   script-file identifier
v_IDX_lid="BSH"         #   run bash main logFile ID
v_IDX_src=".bsh"
v_IDX_log=".log"

#   =*= :   REX
v_sRexEx_src='^b[0-9]{2}_[A-Za-z]+\.bsh$'
v_sRexEx_log='^b[0-9]{2}_[A-Za-z]+_[0-9]+\.log$'
v_sRexEx_lid='^rBS_[A-Za-z0-9]+\.log$'

#   =*= :   showDir
f_lib_trace ${FUNCNAME[0]} $LINENO "DirLog:={$v_DIR_LOG}" $bTrc
f_lib_trace ${FUNCNAME[0]} $LINENO "DirLog:={$v_DIR_TMP}" $bTrc
f_lib_trace ${FUNCNAME[0]} $LINENO "DirLog:={$v_DIR_LOG_EXTENDED}" $bTrc

#   =*= :   start timer FMT
v_sFMT_now="+%y%m%d%H%M%S"        #   "+%Y%m%d.%H%M%S"
v_sFMT_out="+%y%m%d:%H%M%S"     # !PHA:only for viewing - not calculation

#   =*= :   start timer
v_runTimer_start=$(date +%s.%N)
v_sDTM_out=$(date $v_sFMT_out)
v_sDTM_now=$(date $v_sFMT_now)    # using tutor dateTime-Format
f_lib_debug "runTimerStart:'$v_runTimer_start'" $LINENO $bDbg
f_lib_debug "DTM.now:'$v_sDTM_now'" $LINENO $bDbg

#   =*= :   Global Regular Expression Print
v_sGrepx_src="$v_IDX_sid??_*.$v_IDX_src"
v_sGrepx_cpy="$v_IDX_sid??_*.$v_IDX_log"
v_sGrepx_logStd="$v_IDX_sid??.$v_IDX_log"
v_sGrepx_logDtm="$v_IDX_sid??_?????????.$v_IDX_log"
v_sGrepx_run="$v_SCP_????????.$v_IDX_log"
f_lib_debug "grex:'v_sGrepx_src'" $LINENO $bDbg

#   =*= :   logFiles
v_LOGFILE_std="${v_DIR_LOG}/$v_SCP.log"
v_LOGFILE_tmp="${v_DIR_LOG}/$v_SCP.tmp.log"
v_LOGFILE_obj="${v_DIR_LOG}/${v_IDX_lid}_${v_sDTM_now}.log"
f_lib_debug "log.std:'$v_LOGFILE_std'" $LINENO $bDbg
f_lib_debug "log.tmp:'$v_LOGFILE_tmp'" $LINENO $bDbg
f_lib_debug "log.obj:'$v_LOGFILE_obj'" $LINENO $bDbg

#   =*= :   exit code calc and save
f_run_calcExitCode; v_iEc=$?
v_FWK_exitCode=$v_iEc      # common input variable for scripts
f_lib_debug "exitCode:'$v_FWK_exitCode'" $LINENO $bDbg

#   =*= :   match TC Files
f_run_matchFiles $v_sRexEx_src; iRc=$?
aTc=("${v_aRc[@]}")
nTc=$v_iRc
f_lib_debug "nTc={$nTc}" $LINENO $bDbg
f_lib_debug "aTc=${aTc[@]}" $LINENO $bDbg

#   check TC
if [ $nTc == 0 ]; then
    f_lib_error "REX:<$v_sRexEx_src> not found at \n\tDIR:=`pwd`" $LINENO
    exit $LINENO
fi

#   =*= :   save TC Files : copy aTcAll:=aTc
declare -a aTcAll
aTcAll=("${aTc[@]}")

#   =*= :   check number of arguments
if  [ "$#" -gt 2  ]; then
    f_lib_error "too much arguments"  $LINENO
    echo "usage: $>. {'$v_SCP'} <arg1> [<arg2>]"
    exit $LINENO
fi
n=$#
f_lib_debug "using N=<$n> args" $LINENO $bDbg

#   =*= :   clear screen
#   exit 1

n=1
f_lib_debug "I screen clear in: <$n> seconds..." $LINENO $bDbg

sleep $n
f_lib_screen_clear  # delete screen


#
#   =*= :   argument handling
#

f_lib_trace ${FUNCNAME[0]} $LINENO "checkArg1" $bTrc

if  [ "$1" == ""  ]     ||
    [ "$1" == '?' ]     ||
    [ "$1" == 'h' ]     ||
    [ "$1" == 'help' ] ; then
    #   *** case.h : help
    f_run_usage
    exit 1
elif [ "$1" == 'c' ]; then
    #   *** case.c : clean
    echo "*** clean"
    f_run_rmLogFiles
    exit 2
elif [ "$1" == 'i' ]; then
    f_lib_trace ${FUNCNAME[0]} $LINENO "info" $bTrc
    f_lib_puts "*** exitCode:'$v_FWK_exitCode'"
    f_lib_versionShow
    exit 3
elif [ "$1" == '!' ]; then
    f_lib_trace ${FUNCNAME[0]} $LINENO "tcAll" $bTrc
    aTc=("${aTcAll[@]}") # array copy
    sleep 1
elif [ "$1" == '+' ]; then
    f_lib_trace ${FUNCNAME[0]} $LINENO "shuffle" $bTrc
    #   01:shuffle
    aTmp=( $(shuf -e "${aTcAll[@]}") )
    #   02:random
    n=${#aTmp[@]}
    n=$(($n/2))
    f_lib_random $n; i=$?
    if [ $i -eq 1 ]; then
        i=2
    fi
    n=$i
    #   03:copy
    aTc=()
    for (( i=0; i < $n; i++ ));
    do
        sTc=${aTmp[$i]}
        aTc+=($sTc)
    done
else
    #   check: is TC really in tcAll?
    f_lib_trace ${FUNCNAME[0]} $LINENO "anyTc" $bTrc
    i=0
    iTc=-1
    aTc=()
    sTc=$1
    for xTc in "${aTcAll[@]}"; do
        if [ $xTc == $sTc ]; then
            iTc=$i
            break
        fi
        let "i += 1"
    done
    if [ $iTc -lt 0 ]; then
        f_lib_error "wrong TC:'$sTc'" $LINENO
    fi
    aTc+=($sTc)
fi

#   =*= :   aTc
nTc=${#aTc}; f_lib_debug "nTc+={$nTc}" $LINENO $bDbg
s="aTc=${aTc[@]}";  f_lib_debug "$s" $LINENO $bDbg
f_lib_trace ${FUNCNAME[0]} $LINENO "tcFound: nTc:=<$n>" $bTrc

#   =*= :   StressFactor
f_lib_trace ${FUNCNAME[0]} $LINENO "StressFactor" $bTrc
x=$2; f_lib_isNumeric $x; bRc=$?
if [ $bRc == $v_TRUE ] ; then
    #   INPUT: $> SCRIPT <stressfactor> *** case.1
    f_lib_trace ${FUNCNAME[0]} $LINENO ":stressFactor0:=<'$x'>" $bTrc $bLog
    nStressFactor=$x
    s="=x= $v_SID:{allTc,${nStressFactor}*}"
    f_lib_debug "$s" $LINENO $bDbg
fi

f_lib_debug "resultStress" $LINENO $bDbg
#   =*= :   result.StressFactor
if [ $bDbg == $v_TRUE ]; then
    declare -p aTc
    declare -p nStressFactor
fi

#   =*= :   header
f_lib_header "$v_SCP" $LINENO $v_iEc; v_iEc=$?; v_iRc=$v_iEc

#   =*= :   logString
v_LOGSTR=">>> RUN:$v_SID:{$v_sDTM_out}:EC={$v_iEc}"
s=$v_LOGSTR
f_lib_debug "$v_LOGSTR" $LINENO $bDbg

#
#   =*= :   run TC
#
nTc=${#aTc[@]}
f_lib_puts "<<< used Tc:=<$nTc> with iEc:=<$v_iEc>" $v_COL_ID_blue
iOk=0
iEc=0

while [ $iStressCounter -le $nStressFactor ]; do
    i=0

    for xTc in "${aTc[@]}"
    do
        i+=1
        t1="$i/$nTc"
        if [ $nStressFactor -gt 1 ]; then
            t2="$iStressCounter/$nStressFactor"
            f_lib_print "[$t1][$t2]:'$xTc': ..."
        else
            f_lib_print "[$t1]:'$xTc': ..."
        fi
        bRc=$v_FALSE
        n=$iStressCounter
#       -------------------------------------------------------------
        f_run_compiler "$xTc" "$n" "$v_iEc"; bRc=$? # call TestCase
#       -------------------------------------------------------------
        if [ $bRc == $v_TRUE ]; then
            f_lib_puts ";"
            let iOk+=1
        else
            f_lib_error "? bRc!=TRUE" $LINENO
            eTc+=($xTc)   #   noBreak
            let iEc+=1
        fi
    done
    let iStressCounter+=1
done


s="${v_aLog[@]}";  f_lib_debug "v_aLog:$s" $LINENO $bDbg
n=${#v_aLog[@]};   f_lib_debug "v_nLog:$n" $LINENO $bDbg


#   ready
f_lib_debug "<<< READY - tests  OK=<$iOk> Error=<$iEc>" $LINENO $bDbg

#   create my logfile
echo "$v_LOGSTR" > $v_LOGFILE_tmp
f_lib_info "I created a tmp file:<$v_LOGFILE_tmp>"

#   append all logfiles into tmpLogFile
f_lib_debug "append logFiles" $LINENO $bDbg
f_run_appendLogFiles $v_LOGFILE_tmp $v_sDTM_now #!CRQ-200819:


#
#   =*= :footer
#

#   calculate elapsed time

v_runTimer_stop=$(date +%s.%N); v_sDt=$(date $v_sRunDtFmt)
v_runTimer_time=$(echo "$v_runTimer_stop-$v_runTimer_start" | bc)
n=2; v_runTimer_secs=$(echo "scale=2; $v_runTimer_time / 1" | bc)   # !CRQ-200102: use bc

#   finish
v_LOGSTR="<<< STP:$v_SID:{$v_sDt}:time.elapsed:{$v_runTimer_secs}"

#   copy last line into global logfile
echo "$v_LOGSTR" >> $v_LOGFILE_tmp

#   copy: log.TMP=>log.OBJ
f_lib_puts "=e= copy log.TMP '$v_LOGFILE_tmp' => '$v_LOGFILE_obj'"
cp $v_LOGFILE_tmp $v_LOGFILE_obj

#   move: log.TMP=>log.STD
f_lib_puts "=e= rename log.TMP '$v_LOGFILE_tmp' => '$v_LOGFILE_std'..."
mv $v_LOGFILE_tmp $v_LOGFILE_std

#   copy to XOS
f_lib_show "=x= copy log.STD '$v_LOGFILE_std' => '$v_DIR_LOG_EXTENDED'"
cp $v_LOGFILE_std $v_DIR_LOG_EXTENDED

#   show logfile
f_lib_puts "=l= *created* run-logfile:'$v_LOGFILE'"  $v_COL_ID_blue

#   show last logstring
f_lib_puts "$v_LOGSTR" $v_COL_ID_magenta

f_lib_footer $v_SCP $LINENO $v_iRc
# last line