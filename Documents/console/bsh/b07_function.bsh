#!/bin/bash

#   ****************************************************************************
#   TUTORIAL BASH:function
#   ****************************************************************************

<<  =*=
    +   :01 define
    +   :02 namespace test
=*=

<<  =*=
        $@              :   array of all parameter
        $#              :   parameter-counter
        $1...$9..       :   current parameter
        $?              :   return code
        ${FUNCNAME[0]}  :   function name
=*=

#
#   =*= :   header
#

source LIB.inc.bsh

z_EXE=$BASH_SOURCE; z_SCP=`basename $z_EXE`
z_iEc=$1

f_lib_header "$z_SCP" $LINENO $z_iEc; z_iEc=$?; z_iRc=$z_iEc

#
#   =*= :   define helper integer
#

f_lib_text "define some helper variables" $LINENO

declare -i i
declare -i n

#
#   =*= :01 define
#

f_lib_menu "define" $LINENO

#   declare with 'function'
f_lib_submenu "declare by 'function'" $LINENO
function f01 {
    #   parameter '$1','$2',...
    local s=${FUNCNAME[0]}
    f_lib_puts "I am function '$s' and I get: <$1>"
    return 41   # only 0...255
}

#   declare with '()'
f_lib_submenu "declare by '()'" $LINENO
f02 () {
    local s
    declare -i i=1
    for x in "$@"
    do
        s=${FUNCNAME[0]}
        f_lib_puts "{$s}:arg[$i/$#]=$x"
        i+=1
    done
    return 82   # only 0...255
}

f_lib_submenu "call" $LINENO

#   call them
f01 "britney"; iRc1=$?
f02 "madonna" "kathy" "mariah"; iRc2=$?

#   check my return codes
f_lib_puts "return codes rc1:<$iRc1>; rc2:<$iRc2>" $v_COL_ID_yellow

#
#   =*= :02 namespace
#

#   !PHA:bash has no namespace - all variables are global in 1 script

f_lib_menu "namespace" $LINENO

#   define my values first
x=9; y=8; z=7
f_lib_puts "[main:$LINENO]:x:<$x>;y:<$y>;z:<$z>";

function f03 {
    function f04 {
        f_lib_puts "[f04:$LINENO]:x:<$x>;y:<$y>;z:<$z> ";
        f_lib_text "{f04:x:=401;local y:=402;z:=403}" $LINENO
        x=401; local y=402; z=403
        f_lib_puts "[f04:$LINENO]:x:<$x>;y:<$y>;z:<$z> ";
    }
    f_lib_puts "[f03:$LINENO]:x:<$x>;y:<$y>;z:<$z> ";
    f_lib_text "{f03:x:=37;declare y:=38;local z:=39}" $LINENO
    x=37    # this changes all 'x'
    declare -i y=38     #   define again
    local z=39          #   the same, but without type def
    f_lib_puts "[f03:$LINENO]:x:<$x>;y:<$y>;z:<$z> :call f04..."
    f04             # call subfunction
    f_lib_puts "[f03:$LINENO]:x:<$x>;y:<$y>;z:<$z> ";
}

#   define my values again
f_lib_text "{src:x:=1;declare y:=2;local z:=3}" $LINENO
x=1; y=2; z=3
f_lib_puts "[main:$LINENO]:x:<$x>;y:<$y>;z:<$z> :call f03...";
f03

#   f03 has changed x,y,z - but only 'x' was affected
f_lib_puts "[main:$LINENO]:x:<$x>;y:<$y>;z:<$z>";

#   !PHA :"local" or "declare" avoid's namespace conflicts.


#
#   =*= :   footer
#

f_lib_footer $z_SCP $LINENO $z_iRc $z_iEc