hereDoc_content_tutor__interpreter

#   p:  p.function
#   p:  p.body

#   b:  b.include
source LIB.wsp.inc.bsh
if [ "$1" == "" ]; then f_lib_configuration '+'; fi
declare -i z_iReply_iEc=$1

#   b:  b.header
f_lib_header $z_iReply_iEc

#   b:  b.main

#   m:  i.perl
f_lib_menu "python"
s=$(perl --version)
f_lib_puts "$s"

#   m:  i.ruby
f_lib_menu "ruby"
s=$(ruby --version)
f_lib_puts "$s"

#   m:  i.python
f_lib_menu "python"
s=$(python3 --version)
f_lib_puts "$s"

#   b:  b.footer
f_lib_footer 0

