#!/bin/bash

#   ***************************************************************************
#   run:[simple]        tutorial.Python 2026    ©[mATe64]       [2026-10-19]
#   ***************************************************************************
#   usage:
#       $   bash <THIS.bsh>
#   content:
#       m:  run.prepare
#       m:  run.scripts
#   ***************************************************************************

#
#   m:  prepare
#

#   s:  C.interpreter
declare -r C_INTERPRETER='python3'

#   s:  C.blackList
declare -a C_aBlackList=( \
                'y02_io.py' \
                'y10_module_m1.py' \
                'y24_function.py' \
                'y27_package.py' \
                'y32_unitTest.py' \
                'y32_unitTest_m1.py' \
                'y32_unitTest_m2.py' \
                'y32_unitTest_m3.py' \
                'y45_getOpt.py' \
                'y46_argParse.py' \
                'y47_py2py.py' \
                'y52_timing.py' \
                'y52_timing_m1.py'
)

#   s:  show
clear
declare -i iReply=$RANDOM
echo "+ run.simple:[$iReply]"

#   s:  D.sourceList
aShellArray=$(echo `ls y*.py`)

#   s:  array size
declare -i n
n=${#aShellArray[@]}; echo "n1==[$n]" # not works
#   calc manually
n=0
for xFile in $aShellArray; do
    n+=1
done
echo "n==[$n] "

#   s:  fetchDateTime
declare sFmt="+%Y-%m-%d %H:%M:%S"
declare sDtm=$(date "$sFmt")

#   ===========================================================================
#   m:  run.scripts
#   ===========================================================================

clear

printf "BEG simple.run:[%s]\n\n" "$sDtm"

declare -i i=0

for xFile in $aShellArray
do

    i+=1
    printf "*** run:[%2.2d]/[%2.2d]:'%s'\n" $i $n $xFile

    #   isFileInBlackList?
    sBlack='-'
    for xBlack in "${C_aBlackList[@]}"
    do
        if [ "$xBlack" == "$xFile" ]; then
            sBlack='!'
            break
        fi
    done
    if [ "$sBlack" == '!' ]; then
        printf "&&& SKIP:[%s]\n" $xFile
        continue
    fi

    #   run
    $C_INTERPRETER $xFile
    printf "\n\n"

done


printf "\nEND simple.run:[%s]\n\n" "$sDtm"

