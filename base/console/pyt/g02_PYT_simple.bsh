#!/bin/bash

#   ***************************************************************************
#   run:[simple]        tutorial.Python 2026    ©[mATe64]       [2026-10-19]
#   ***************************************************************************
#   usage:
#       $   bash <THIS.bsh>
#   content:
#       m:  run.prepare
#       m:  run.scripts
#   ***************************************************************************

#
#   m:  prepare
#

#   s:  interpreter
declare -r C_INTERPRETER='python3'
declare -r C_FILE_BLACK='y27_package.py'

#   s:  show
clear
declare -i iReply=$RANDOM
echo "+ run.simple:[$iReply]"

#   s:  fetch all ruby scripts in a ShellArray
a=$(echo `ls y*.py`)

#   s:  array size
declare -i n
n=${#a[@]}; echo "n1==[$n]" # not works
#   calc manually
n=0
for xFile in $a; do
    n+=1
done
echo "n==[$n] "

#   s:  fetchDateTime
declare sFmt="+%Y-%m-%d %H:%M:%S"
declare sDtm=$(date "$sFmt")

#   ===========================================================================
#   m:  run.scripts
#   ===========================================================================

clear

printf "BEG simple.run:[%s]\n\n" "$sDtm"

declare -i i=0

for xFile in $a
do
    i+=1
    printf "*** run:[%2.2d]/[%2.2d]:'%s'\n" $i $n $xFile
    if [ $C_FILE_BLACK == $xFile ]; then
        printf "&&& SKIP:[%s]\n" $xFile
        continue
    fi
    $C_INTERPRETER $xFile
    printf "\n\n"
done

printf "\nEND simple.run:[%s]\n\n" "$sDtm"

