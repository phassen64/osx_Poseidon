#!/bin/bash

#   ***************************************************************************
#   run:[simple]        tutorial.Perl 2026      ©[mATe64]       [2026-10-18]
#   ***************************************************************************
#   usage:
#       $   bash <THIS.bsh>
#   content:
#       m:  run.prepare
#       m:  run.scripts
#   ***************************************************************************

#
#   m:  prepare
#

#   s:  C.interpreter
declare -r C_INTERPRETER='perl'

#   s:  C.blackList
declare -a C_aBlackList=( \
                'p10_p2c.pl' \
)

#   s:  show
clear
declare -i iReply=$RANDOM
echo "+ run.simple:[$iReply]"

#   s:  D.sourceList
aShellArray=$(echo `ls p*.pl`)

#   s:  array size
declare -i n
n=${#aShellArray[@]}; echo "n1==[$n]" # not works
#   calc manually
n=0
for xFile in $aShellArray; do
    n+=1
done
echo "n==[$n] "

#   s:  fetchDateTime
declare sFmt="+%Y-%m-%d %H:%M:%S"
declare sDtm=$(date "$sFmt")

#   ===========================================================================
#   m:  run.scripts
#   ===========================================================================

clear

printf "BEG simple.run:[%s]\n\n" "$sDtm"

declare -i i=0
for xFile in $aShellArray
do
    i+=1
    printf "*** run:[%2.2d]/[%2.2d]:'%s'\n" $i $n $xFile

    #   isFileInBlackList?
    sBlack='-'
    for xBlack in "${C_aBlackList[@]}"
    do
        if [ "$xBlack" == "$xFile" ]; then
            sBlack='!'
            break
        fi
    done
    if [ "$sBlack" == '!' ]; then
        printf "&&& SKIP:[%s]\n" $xFile
        continue
    fi

    #   run
    $C_INTERPRETER $xFile
    printf "\n\n"

done

printf "\nEND simple.run:[%s]\n\n" "$sDtm"

