#!/bin/bash

#   ***************************************************************************
#   run:[advanced]      tutorial.WPS 2026        ©[mATe64]   [2026-11-01]
#   ***************************************************************************

#   description:
#       run all script files, logging enabled
#       using BlackList to skip scripts

#   usage:
#       $   bash <THIS.bsh>

#   content:
#       b:  function
#       b:  body

#   ***************************************************************************

#   ===========================================================================
#   b:  function
#   ===========================================================================

function f_run_script {

    #   fetch
    local p_aShellArray=$1
    local p_nStressMax=$2     # stress counter
    local p_iRnd=$3

    #   declare
    local -i i=0
    local -i n=0
    local -i iFile=0
    local -i nFile=0

    #   calc.manually shell array
    nFile=0
    for xFile in $p_aShellArray; do
        nFile+=1
    done

    #   define my runner.eXitCode [3,...199]
    local -i iEc=$v_FWK_exitStatus
    local -i iBashReply=0
    local -x sHashLine
    local -i iRc=0

    #   build sLine
    s=''; c='#'; for((i=0;i<80;i++)); do s+="$c"; done
    sHashLine=$s

    #   run
    printf "___ script nFiles:<%d>  iRnd:[%d] :#{%d}\n" $nFile $p_iRnd $iEc

    for (( n=1; n<=$p_nStressMax; n++ )); do

        printf "\n### stress :: [%3.3d]/[%3.3d]\n" $n $p_nStressMax
        iFile=0

        for xFile in $p_aShellArray
        do
            iFile+=1

            printf "\n%s\n" $sHashLine
            printf "*** run:[%2.2d]/[%3.3d]:'%s'\n" $iFile $n  $xFile
            printf "%s\n\n" $sHashLine

            #   isFileInBlackList?
            sBlack='-'
            for xBlack in "${aBlackList[@]}"
            do
                if [ "$xBlack" == "$xFile" ]; then
                    sBlack='!'
                    break
                fi
            done
            if [ "$sBlack" == '!' ]; then
                printf "&&& SKIP:[%s]\n" $xFile
                continue
            fi
            
            #   call script, save eXitCode
            $C_INTERPRETER $xFile $iEc;   iBashReply=$?

            #   check reply
            printf "\n<<< replyOf[%d]:'%s' ==:" $n $xFile
            if [ $iEc == $iBashReply ]
            then
                printf "{*true}"
            else
                printf "{NOK}:[%d]<>[%d]}" $iEc $iBashReply
                iRc+=1
            fi
            printf ".\n"
        done

    done

    printf "___ total.iRc:<%d>\n" $iRc
    return $iRc
}

#   ===========================================================================
#   b:  body
#   ===========================================================================

#
#   m:  prepare
#

#   s:  interpreter
declare -r C_INTERPRETER='pwsh'

#   s:  define blackList
declare -a aBlackList=(\
    'w00_dummy.ps1' \
    'w06_function.ps1' \
    'w11_regExpr.ps1' \
    'w17_process.ps1' \
    'w20_misc.ps1' \ 
    'w21_invoke.ps1'
)

#   s:  fetch all powershell scripts in a ShellArray
aShellArray=$(echo `ls w*.ps1`)

#   s:  fetchDateTime
declare sFmt="+%Y-%m-%d %H:%M:%S"

#   s:  calculate stressCounter
declare -i n=1  #   rndMax
declare -i iCtr=1+$RANDOM%$n
declare -i iRc=0
declare  x  #   formatStr

#   m:  run

#   s:  dateTime.Start
sDtm=$(date "$sFmt");   tDtmStart=$(date '+%s.%N')

#   s:  logFileName
v_SCP=`basename $BASH_SOURCE`
v_SCP_bdy="${v_SCP%.*}"
v_SCP_ext="${v_SCP##*.}"
fLog="$v_FWK_dirTemp/$v_SCP_bdy.log"
printf "&&& logFile:'%s'\n" "$fLog"

#   s:  header
printf -v SOut ">>> runWPS.BEG *[%d] at:[%s]." "$iCtr" "$sDtm"
printf "$SOut\n"
echo "$SOut" > $fLog

#   s:  flush.logFileName
echo "" >>  $fLog
echo "$SOut" >>  $fLog

#   s:  run
f_run_script "$aShellArray" "$iCtr" "$RANDOM" >> $fLog
#   f_run_script "$aShellArray" "$iCtr" "$RANDOM"
iRc=$?

#   build sLine
echo "" >> $fLog
s=''; c='&'; for((i=0;i<80;i++)); do s+="$c"; done
printf -v SOut "%s\n" $s
echo "$s" >> $fLog

s="*** total_sum_of_eRRoRs := [$iRc]"
printf "$s\n"
echo "$s" >> $fLog

#   s:  dateTime.Stopp
sDtm=$(date "$sFmt");   tDtmStopp=$(date '+%s.%N')

#   s:  calc.Time
fSec=$(echo "($tDtmStopp-$tDtmStart) / 1" | bc)

#   s:  footer
printf -v SOut "<<< runWPS.END *[%d] at:[%s] elapsed:[%s]." "$iCtr" "$sDtm" "$fSec"
echo "$SOut" >> $fLog
printf "$SOut\n"


