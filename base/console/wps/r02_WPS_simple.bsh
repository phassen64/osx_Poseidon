#!/bin/bash

#   ***************************************************************************
#   run:[simple]        tutorial.WPS 2026    ©[mATe64]          [2026-11-01]
#   ***************************************************************************
#   usage:
#       $   bash <THIS.bsh>
#   content:
#       m:  run.prepare
#       m:  run.scripts
#   ***************************************************************************

#
#   m:  prepare
#

#   s:  interpreter
declare -r C_INTERPRETER='pwsh'

#   s:  C.blackList
declare -a C_aBlackList=(\
#   'w02_dataType.ps1' \
    'w06_function.ps1' \
#   'w07_class.ps1' \
    'w11_regExpr.ps1' \
    'w17_process.ps1' \
    'w20_misc.ps1' \ 
    'w21_invoke.ps1'
)

#   s:  show
clear
declare -i iReply=$RANDOM
echo "+ run.simple:[$iReply]"

#   s:  D.sourceList
aShellArray=$(echo `ls w*.ps1`)

#   s:  array size
declare -i n
n=${#aShellArray[@]}; echo "n1==[$n]" # not works
#   calc manually
n=0
for xFile in $aShellArray; do
    n+=1
done
echo "n==[$n] "

#   s:  fetchDateTime
declare sFmt="+%Y-%m-%d %H:%M:%S"
declare sDtm=$(date "$sFmt")

#   ===========================================================================
#   m:  run.scripts
#   ===========================================================================

clear

printf "BEG simple.run:[%s]\n\n" "$sDtm"

declare -i i=0

for xFile in $aShellArray
do
    i+=1
    printf "*** run:[%2.2d]/[%2.2d]:'%s'\n" $i $n $xFile

    #   isFileInBlackList?
    sBlack='-'
    for xBlack in "${C_aBlackList[@]}"
    do
        if [ "$xBlack" == "$xFile" ]; then
            sBlack='!'
            break
        fi
    done
    if [ "$sBlack" == '!' ]; then
        printf "&&& SKIP:[%s]\n" $xFile
        continue
    fi

    #   run
    $C_INTERPRETER $xFile
    printf "\n\n"

done

printf "\nEND simple.run:[%s]\n\n" "$sDtm"

