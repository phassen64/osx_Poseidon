#!/bin/bash

#   ***************************************************************************
#   run:[simple]        tutorial.Perl 2026      ©[mATe64]       [2026-10-18]
#   ***************************************************************************
#   usage:
#       $   bash <THIS.bsh>
#   content:
#       m:  run.prepare
#       m:  run.scripts
#   ***************************************************************************

#
#   m:  prepare
#

#   s:  show
clear
declare -i iReply=$RANDOM
echo "+ run.simple:[$iReply]"

#   s:  fetch all perl scripts in a ShellArray
a=$(echo `ls p*.pl`)

#   s:  array size
declare -i n
n=${#a[@]}; echo "n1==[$n]" # not works
#   calc manually
n=0
for xFile in $a; do
    n+=1
done
echo "n==[$n] "

#   s:  fetchDateTime
declare sFmt="+%Y-%m-%d %H:%M:%S"
declare sDtm=$(date "$sFmt")

#   ===========================================================================
#   m:  run.scripts
#   ===========================================================================

clear

printf "BEG simple.run:[%s]\n\n" "$sDtm"

declare -i i=0
for xFile in $a
do
    i+=1
    printf "*** run:[%2.2d]/[%2.2d]:'%s'\n" $i $n $xFile
    perl $xFile
done

printf "END simple.run:[%s]\n\n" "$sDtm"

