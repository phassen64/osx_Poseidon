#!/bin/bash

#
#   =*= :   make <C>
#

#   url:https://regex101.com/
#   url:https://phoenixnap.com/kb/bash-declare

<<  =*=
    DESCRIPTIION: make c
    +   usage: $>. {thisScript} [ <single C-file>  || <opt> ]
    +   <opt>:={'?','h','c','i','!'}
    +   Examples:
        case.1:: $> . make.bsh !            # make all
        case.2:: $> . make.bsh <c-File>     # make only this file
=*=

#
#   =*= m:  include and init
#

#   source "../bsh/LIB.inc.bsh"
#   f_lib_colorInit
clear

#
#   =*= m:  functions
#

function f_mk_usage() {
    s="usage: $>. {'$v_Scp'} <P1> [<P2>]"
    echo $s
    printf "\t  P1:=: [ {File*.$v_sExt_src}  || {'','?','h','c','!'}  ]\n"
    printf "\t  P2:=: {'+'}\n"
    printf "\t  File*.$v_sExt_src : single compile\n"
    printf "!   :\t compile all\n";
    printf "?|h :\t show help\n"
    printf "i   :\t info files\n"
    printf "r   :\t run {File*.$v_sExt_obj}\n"
    printf "c   :\t clear - remove tmpFiles\n"
}

function f_mk_isFile() {
    local s='?IsFile'
    local bRc=$v_FALSE
    if [ -f $1 ]; then bRc=$v_TRUE; fi
    return $bRc
}

function f_mk_remove() {
    local sRex=$1
    declare -i i
    v_iRc=0
    echo "*** REG used:'$sRex'"
    for xFile in `ls`
    do
        if [ -f "$xFile" ]; then
            i+=1
            #   echo "??? file[$i]:$xFile"
            if [[ $xFile =~ $sRex ]]; then
                echo "--- rm[$i]:$xFile"
                rm -f $xFile 2> /dev/null
                v_iRc+=1
            fi
        fi
    done
    echo "<<< removed:<$v_iRc> files"
    return $v_iRc
}

function f_mk_compile() {
    #   IN: cNN_name.c
    #   OUT:cNN.exe
    local fSrc=$1
    iPos=5;iLen=3
    local fBdy="${fSrc%.*}"
    local fExt="${fSrc##*.}"
#   local fObj=${fSrc:0:3}.$v_sExt_obj
    local fObj="run_${fBdy}.${v_sExt_obj}"
    local sExe="gcc"
    local sOpt="-Wall -Werror"
    local sCmd="$sExe $sOpt $fSrc -o $fObj"
    echo "--- compile: \$> $sCmd"
    $sCmd
}

function f_mk_matchFiles() {
    local sRex=$1
    local sPut=$2
    declare -i i
    v_iRc=0
    v_aRc=()
    for xFile in `ls`
    do
        if [ -f "$xFile" ]; then
            if [[ $xFile =~ $sRex ]]; then
                i+=1
                if [ ! -z $sPut ]; then
                    printf "*** match '%s' : [%2.2d] := '$xFile'\n" $sPut $i
                fi
                v_iRc+=1
                v_aRc+=( $xFile )
            fi
        fi
    done
    return $v_iRc
}

#
#   do
#

function f_do_runAll() {
    sRex='^run_c[0-9]{2}_[A-Za-z]+\.bin$'
    f_mk_matchFiles $sRex; iRc=$?
    aSrc=("${v_aRc[@]}")
    nSrc=${#aSrc[@]}
    if [ $nSrc == 0 ]; then
       echo "??? notFound: REX:='$sRex'"
        return $LINENO
    fi
    for fSrc in "${aSrc[@]}"
    do
        i+=1
        printf "run:[%2.2d]:'%s'...\n" $i $fSrc
        sleep 1
        $fSrc
    done
    return 0
}



#   handle my source array
function f_do_compileAll() {
    aSrc=("${v_aRc[@]}")
    nSrc=${#aSrc[@]}
    echo "nSrc={$nSrc}"
    echo "aSrc=${aSrc[@]}"
    #   compile
    for fSrc in "${aSrc[@]}"
    do
        i+=1
        f_mk_compile $fSrc ; v_iRc=$?
    done
    return 0
}



#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#   =*= m:  body
#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

bTrc=$v_TRUE
bLog=$v_FALSE
v_Scp=`basename $BASH_SOURCE`


#   define
declare -a v_aRc
declare -i v_iRc
declare -i i=0
declare -i n=0
declare -a aSrc

#   parameter
v_sSid='c'      #   script file identifier
v_sExt_src='c'      #   script file extension
v_sExt_obj='bin'    #   output extension

#
#   =*= menu
#

#
#   =*= parameter 1
#

if  [ "$1" == ""  ]     ||
    [ "$1" == '?' ]     ||
    [ "$1" == 'h' ]     ; then
    f_mk_usage
    exit 0

elif [ "$1" == 'c' ]; then
    f_mk_remove '^c[0-9]{2}_[A-Za-z]+\.bin$'
    f_mk_remove '^run_c[0-9]{2}_[A-Za-z]+\.bin$'
    f_mk_remove '^[cC][0-9]{2}_[A-Za-z]+\.\d{3}\.txt$'
    f_mk_remove 'TUTOR_FILE_SYS\.d{3}\.txt$'
    exit 1

elif [ "$1" == 'i' ]; then
    echo "...show matche info"
    f_mk_matchFiles '^c[0-9]{2}_[A-Za-z]+\.c$' 'src' ; iRc=$?
    f_mk_matchFiles '^run_c[0-9]{2}_[A-Za-z]+\.bin$' 'run'; iRc=?
    echo "iRc=$iRc"
    f_mk_usage
    exit 1

elif [ "$1" == 'r' ]; then
    echo "*** RUN"
    f_do_runAll
    exit 1

elif [ "$1" == '!' ]; then
    #   *** case.c : clean
    f_mk_matchFiles '^c[0-9]{2}_[A-Za-z]+\.c$'; iRc=$?

else
    fSrc=$1
    if [ ! -f "$fSrc" ] ; then
        echo "noFile:$fSrc:false"
        exit 2
    fi
    echo "adfToFile:$fSrc"
    v_aRc+=($fSrc)
fi

#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#   compiling
#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

#   echo compile
echo "... compile"
f_do_compileAll; iRc=$?
echo "<<< END of Make:<$iRc>"
