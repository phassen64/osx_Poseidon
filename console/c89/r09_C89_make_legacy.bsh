#!/bin/bash

#
#   =*= :   make <C>
#

#   url:https://regex101.com/
#   url:https://phoenixnap.com/kb/bash-declare

<<  =*=
    DESCRIPTIION: make c
    +   usage: $>. {thisScript} [ <single C-file>  || <opt> ]
    +   <opt>:={'?','h','c','i','!'}
    +   Examples:
        case.1:: $> . make.bsh !            # make all
        case.2:: $> . make.bsh <c-File>     # make only this file
=*=

#
#   =*= m:  include and init
#

#   source "../bsh/LIB.inc.bsh"
#   f_lib_colorInit
clear

#
#   =*= m:  functions
#

function f_run_usage() {
    s="usage: $>. {'$v_Scp'} <P1> [<P2>]"
    echo $s
    printf "\t  P1:=: [ {File*.$v_sExt_src}  || {'','?','h','c','!'}  ]\n"
    printf "\t  P2:=: {'+'}\n"
    printf "\t  File*.$v_sExt_src : single compile\n"
    printf "!   :\t compile all\n";
    printf "?|h :\t show help\n"
    printf "i   :\t info files\n"
    printf "r   :\t run {File*.$v_sExt_obj}\n"
    printf "c   :\t clear - remove tmpFiles\n"
}

function f_run_isFile() {
    local s='?IsFile'
    local bRc=$v_FALSE
    if [ -f $1 ]; then bRc=$v_TRUE; fi
    return $bRc
}

function f_run_clean() {
    pushd $v_FWK_dirScratch > /dev/null
    declare -a aExt=('o' 'obj' 'out' 'exe' 'bin')
    for x in "${aExt[@]}"; do
        f='*.'
        f+=$x
        rm -f $f
    done
    popd > /dev/null
}

function f_run_compile_and_link() {
    #   IN: cNN_name.c
    #   OUT:cNN_name.obj cNN_name.exe at dirScratch
    #   using: $dTmp
    local fSrc=$1
    local fBdy="${fSrc%.*}"
    local fObj="${fBdy}.${v_sExt_obj}"
    local pObj="$dTmp/$fObj"
    local fExe="${fBdy}.${v_sExt_exe}"
    local fLib=$C_TUTOR_LIBRARY__OBJ
    local pLib="$dTmp/$fLib"
    local pExe="$dTmp/$fExe"
    local sCpl="gcc"
    local sOpt="-Wall -Werror"
    local sTxt="$fSrc"
    local sDoCompile="$sCpl $sOpt -c $fSrc -o $pObj"
    local sDoLinking="$sCpl $pObj $pLib -o $pExe"
    #   run command
    if [ $C_TUTOR_LIBRARY__SRC == $fSrc ]; then
        echo "--- compile only: \$> $sTxt"
        $sDoCompile
    else
        echo "--- compile+link: \$> $sTxt"
        $sDoCompile
        $sDoLinking
    fi
}

function f_run_fetchFiles() {
    local sRex=$1
    local sPut=$2
    declare -i i
    v_iRc=0
    v_aRc=()
    for xFile in `ls`
    do
        if [ -f "$xFile" ]; then
            if [[ $xFile =~ $sRex ]]; then
                i+=1
                if [ ! -z $sPut ]; then
                    printf "*** match '%s' : [%2.2d] := '$xFile'\n" $sPut $i
                fi
                v_iRc+=1
                v_aRc+=( $xFile )
            fi
        fi
    done
    return $v_iRc
}

#
#   do
#

function f_run_runAll() {
    pushd $dTmp
    f_run_fetchFiles $C_REX_EXE; iRc=$?
    popd
    aSrc=("${v_aRc[@]}")
    nSrc=${#aSrc[@]}
    if [ $nSrc == 0 ]; then
        echo "??? notFound: REX:='$sRex'"
        return $LINENO
    fi
    for fSrc in "${aSrc[@]}"
    do
        i+=1
        printf "run:[%2.2d]:'%s'...\n" $i $fSrc
        #   sleep 1
        #   $fSrc
    done
    return 0
}



#   handle my source array
function f_do_compileAll() {
    echo "&&& doCompile all"
    aSrc=("${v_aRc[@]}")
    nSrc=${#aSrc[@]}
    echo "&&& nSrc={$nSrc}"
    echo "&&& aSrc=${aSrc[@]}"
    for fSrc in "${aSrc[@]}"
    do
        i+=1
        f_run_compile_and_link $fSrc ; v_iRc=$?
    done
    echo "&&& dObjDir = '$dTmp'"
    return 0
}


#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#   =*= m:  body
#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

bTrc=$v_TRUE
bLog=$v_FALSE
dTmp=${v_FWK_dirScratch}


#   const
declare -r  C_TUTOR_LIBRARY__SRC='c00_library.c'
declare -r  C_REX_SRC='^c[0-9]{2}_[A-Za-z]+\.c$'
declare -r  C_REX_EXE='^c[0-9]{2}_[A-Za-z]+\.exe$'

#   define
declare -a v_aRc
declare -i v_iRc
declare -i i=0
declare -i n=0
declare -a aSrc

#   parameter
v_sSid='c'          #   script file identifier
v_sExt_src='c'      #   script file extension
v_sExt_obj='obj'    #   output extensionID
v_sExt_exe='exe'    #   executable extension

#   Library
s=$(basename ${C_TUTOR_LIBRARY__SRC})
s="${s%.*}"             #   Body
declare -r C_TUTOR_LIBRARY__OBJ="${s}.${v_sExt_obj}"

#
#   =*= menu
#

#
#   =*= parameter 1
#

if  [ "$1" == ""  ]     ||
    [ "$1" == '?' ]     ||
    [ "$1" == 'h' ]     ; then
    f_run_usage
    exit 0

elif [ "$1" == 'c' ]; then
    f_run_clean
    exit 1

elif [ "$1" == 'r' ]; then
    echo "*** RUN"
    f_run_runAll
    exit 1

elif [ "$1" == '!' ]; then
    #   *** case.c : clean
    f_run_fetchFiles '^c[0-9]{2}_[A-Za-z]+\.c$'; iRc=$?

else
    fSrc=$1
    if [ ! -f "$fSrc" ] ; then
        echo "noFile:$fSrc:false"
        exit 2
    fi
    echo "adfToFile:$fSrc"
    v_aRc+=($fSrc)
fi

#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#   compiling
#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

#   echo compile
echo "... compile"
f_do_compileAll; iRc=$?
echo "<<< END of Make reply:<$iRc>"
