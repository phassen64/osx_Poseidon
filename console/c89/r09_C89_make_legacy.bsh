#!/bin/bash

#   ***************************************************************************
#   run:[legacy]    tutorial.C89 v2026      ©[mATe64]           [2026-10-13]
#   ***************************************************************************

#
#   =*= :   make <C89>
#

#   url:https://regex101.com/
#   url:https://phoenixnap.com/kb/bash-declare

<<  =*=
    DESCRIPTIION: make c
    +   usage: $>. {thisScript} [ <single C-file>  || <opt> ]
    +   <opt>:={'?','h','c',,'!'}
    +   Examples:
        case.1:: $> . make.bsh !            # make all
        case.2:: $> . make.bsh <c-File>     # make only this file
=*=

#
#   =*= m:  include and init
#

#   source "../bsh/LIB.inc.bsh"
#   f_lib_colorInit
clear

#
#   =*= m:  functions
#

function f_run_usage() {
    s="usage: $>. {'$v_Scp'} <P1> [<P2>]"
    echo $s
    printf "\t  P1:=: [ {File*.$v_RUN_sExt_src}  || {'','?','h','c','!'}  ]\n"
    printf "\t  P2:=: {'+'}\n"
    printf "\t  File*.$v_RUN_sExt_src : single compile\n"
    printf "\t?|h :\t show help\n"
    printf "\ti   :\t info source files\n"
    printf "\tc   :\t clear - remove tmpFiles\n"
    printf "\t!   :\t compile[+link] all files - not execute\n";
    printf "\t+   :\t execute some of the compiled files \n"
}

function f_run_isFile() {
    local s='?IsFile'
    local bRc=$v_FALSE
    if [ -f $1 ]; then bRc=$v_TRUE; fi
    return $bRc
}

function f_run_clean() {
    pushd $v_FWK_dirTemp > /dev/null
    declare -a aExt=('o' 'obj' 'out' 'exe' 'bin')
    for x in "${aExt[@]}"; do
        f='*.'
        f+=$x
        rm -f $f
    done
    popd > /dev/null
}

function f_run_fetchFiles() {
    #   parameter and locals
    local p_sRex=$1
    local p_cDoShuffle=$2       # '+' shuffle
    local -i n=0
    local -a aSrc=()
    local -a aTmp=()
    local  xFile=''
    #   fetch shellArray
    for xFile in `ls`
    do
        if [ -f "$xFile" ]; then
            if [[ $xFile =~ $p_sRex ]]; then
                n+=1
                aSrc+=($xFile)
            fi
        fi
    done

    #   do shuffle and random
    if [ ! -z $p_cDoShuffle ] && [ $p_cDoShuffle == '+' ]; then
        aTmp=( $(shuf -e "${aSrc[@]}") )
        local -i iRnd=$RANDOM%$n
        aSrc=()
        #   copy into object
        for (( i=0; i <= ${iRnd}; i++ ));
        do
            x=${aTmp[$i]}
            aSrc+=($x)
        done
    fi

    #   reply
    v_RUN_aRc=("${aSrc[@]}")
    return $n
}

function f_run_compile_and_link() {
    #   IN: cNN_name.c
    #   OUT:cNN_name.obj cNN_name.exe at dirTemp
    #   global: dirTemp

    #   input
    local p_fSrc=$1
    local dTmp=${v_RUN_dirTemp}
    local pLib="$dTmp/${C_TUTOR_LIBRARY__OBJ}"

    #   body
    local fBdy="${p_fSrc%.*}"

    #   pathes
    local fObj="${fBdy}.${v_RUN_sExt_obj}"
    local pObj="$dTmp/$fObj"
    local fExe="${fBdy}.${v_RUN_sExt_exe}"
    local pExe="$dTmp/$fExe"

    #   compiler
    local sCpl=$C_COMPILER
    local sOpt="-Wall -Werror"
    local sTxt="$p_fSrc"
    local sDoCompile="$sCpl $sOpt -c $p_fSrc -o $pObj"
    local sDoLinking="$sCpl $pObj $pLib -o $pExe"

    #   run command
    if [ $C_TUTOR_LIBRARY__SRC == "$p_fSrc" ]; then
        echo "--- compile_only: \$> $sTxt"
        $sDoCompile
    else
        echo "--- compile+link: \$> $sTxt"
        $sDoCompile
        $sDoLinking
    fi
}

#   handle my source array
function f_run_doCompileAll() {
    #   input:v_aRc  - src
    #   output:v_aRc - exe
    echo "&&& beg:F.doCompileAll"
    nSrc=${#v_RUN_aRc[@]}
    echo "&&& nSrc={$nSrc}"
    echo "&&& aSrc=${v_RUN_aRc[@]}"
    echo "&&& dObjDir = '$v_RUN_dirTemp'"
    i=0
    for x in "${v_RUN_aRc[@]}"
    do
        i+=1
        #   printf "&&& compile[%2.2d] = '%s'\n" $i $x
        f_run_compile_and_link $x ; v_RUN_iRc=$?     # out: v_aRc
    done
    echo "&&& end:F.doCompileAll  of '$i' files"
    return 0
}

#   runAll
function f_run_doExecuteAll() {
    #   input   :   v_RUN_aRc && p_dExe
    local p_dExe=$1
    local pExe=''
    local nSrc=${#v_RUN_aRc[@]}
    #   show
    printf "\n=== show TestBase:[%d]\n" $nSrc
    declare -p v_RUN_aRc
    printf "\n"
    sleep 3
    #   execute
    for x in "${v_RUN_aRc[@]}"
    do
        i+=1
        pExe="$p_dExe/$x"
        printf "=== execute:[%2.2d]:'%s'\n" $i $pExe
        sleep 1
        $pExe
    done
}

#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#   m:  body
#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

#   s:  B.globals
declare -a v_RUN_aRc=()
declare -i v_RUN_iRc=0
declare -r v_RUN_dirTemp=${v_FWK_dirTemp}

#   s:  B.compose
v_sSid='c'          #   script file identifier
v_RUN_sExt_src='c'      #   script file extension
v_RUN_sExt_obj='obj'    #   output extensionID
v_RUN_sExt_exe='exe'    #   executable extension

#   s:  compiler
declare -r C_COMPILER='gcc'

#   s:  B.const
declare -r  C_TUTOR_LIBRARY__SRC='c00_library.c'
declare -r  C_REX_SRC='^c[0-9]{2}_[A-Za-z]+\.c$'
declare -r  C_REX_EXE='^c[0-9]{2}_[A-Za-z]+\.exe$'

#   s:  B.Library
s=$(basename ${C_TUTOR_LIBRARY__SRC})
s="${s%.*}"             #   Body
declare -r C_TUTOR_LIBRARY__OBJ="${s}.${v_RUN_sExt_obj}"

#   s:  B.define
declare -i i=0
declare -i n=0
declare -a aSrc

#
#   m:  B.main
#

#   s:  M.header
s=$(date "+%Y-%m-%d %H:%M:%S"); echo ">>> BEG.make.legacy [$s]"

#   m:  main
if  [ "$1" == ""  ]     ||
    [ "$1" == '?' ]     ||
    [ "$1" == 'h' ]     ; then
    f_run_usage
    exit 0

elif [ "$1" == 'c' ]; then
    f_run_clean
    exit 1

elif [ "$1" == 'i' ]; then
    f_run_fetchFiles '^c[0-9]{2}_[A-Za-z]+\.c$'; iRc=$?
    aSrc=("${v_RUN_aRc[@]}")
    nSrc=${#aSrc[@]}
    echo "&&& nSrc={$nSrc}"
    echo "&&& aSrc=${aSrc[@]}"

elif [ "$1" == '!' ]; then
    f_run_fetchFiles '^c[0-9]{2}_[A-Za-z]+\.c$'; iRc=$?
    echo "... compile+link only"
    f_run_doCompileAll; iRc=$?

elif [ "$1" == '+' ]; then
    #   use scratch
    dExe=$v_RUN_dirTemp
    #   fetch at TMP
    pushd $dExe
    sDoShuffle='+'
    f_run_fetchFiles '^c[0-9]{2}_[A-Za-z]+\.exe$' $sDoShuffle; iRc=$?
    popd
    #   do run
    f_run_doExecuteAll $dExe; iRc=$?

else
    echo "... error option use['?']"
fi

#   s:  M.footer
s=$(date "+%Y-%m-%d %H:%M:%S"); echo "<<< END.make.legacy [$s]; reply:<$iRc>"
