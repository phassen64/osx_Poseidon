#!/bin/bash

#   ***************************************************************************
#   run:[legacy]    tutorial.C89 v2026      ©[mATe64]           [2026-10-13]
#   ***************************************************************************

#
#   =*= :   make <C89>
#

#   url:https://regex101.com/
#   url:https://phoenixnap.com/kb/bash-declare

<<  =*=
    DESCRIPTIION: make c
    +   usage: $>. {thisScript} [ <single C-file>  || <opt> ]
    +   <opt>:={'?','h','c',,'!'}
    +   Examples:
        case.1:: $> . make.bsh !            # make all
        case.2:: $> . make.bsh <c-File>     # make only this file
=*=

#
#   =*= m:  include and init
#

#   source "../bsh/LIB.inc.bsh"
#   f_lib_colorInit
clear

#
#   =*= m:  functions
#

function f_run_usage() {
    s="usage: $>. {'$v_Scp'} <P1> [<P2>]"
    echo $s
    printf "\t  P1:=: [ {File*.$v_sExt_src}  || {'','?','h','c','!'}  ]\n"
    printf "\t  P2:=: {'+'}\n"
    printf "\t  File*.$v_sExt_src : single compile\n"
    printf "!   :\t compile all\n";
    printf "?|h :\t show help\n"
    printf "i   :\t info files\n"
    printf "r   :\t run {File*.$v_sExt_obj}\n"
    printf "c   :\t clear - remove tmpFiles\n"
}

function f_run_isFile() {
    local s='?IsFile'
    local bRc=$v_FALSE
    if [ -f $1 ]; then bRc=$v_TRUE; fi
    return $bRc
}

function f_run_clean() {
    pushd $v_FWK_dirScratch > /dev/null
    declare -a aExt=('o' 'obj' 'out' 'exe' 'bin')
    for x in "${aExt[@]}"; do
        f='*.'
        f+=$x
        rm -f $f
    done
    popd > /dev/null
}

function f_run_fetchFiles() {
    local sRex=$1
    local sPut=$2
    declare -i i
    v_RUN_iRc=0
    v_RUN_aRc=()
    for xFile in `ls`
    do
        if [ -f "$xFile" ]; then
            if [[ $xFile =~ $sRex ]]; then
                i+=1
                if [ ! -z $sPut ]; then
                    printf "*** match '%s' : [%2.2d] := '$xFile'\n" $sPut $i
                fi
                v_RUN_iRc+=1
                v_RUN_aRc+=( $xFile )
            fi
        fi
    done
    return $v_RUN_iRc
}

function f_run_compile_and_link() {
    #   IN: cNN_name.c
    #   OUT:cNN_name.obj cNN_name.exe at dirScratch
    #   using: $dTmp
    local fSrc=$1
    local fBdy="${fSrc%.*}"
    local fObj="${fBdy}.${v_sExt_obj}"
    local pObj="$dTmp/$fObj"
    local fExe="${fBdy}.${v_sExt_exe}"
    local fLib=$C_TUTOR_LIBRARY__OBJ
    local pLib="$dTmp/$fLib"
    local pExe="$dTmp/$fExe"
    local sCpl="gcc"
    local sOpt="-Wall -Werror"
    local sTxt="$fSrc"
    local sDoCompile="$sCpl $sOpt -c $fSrc -o $pObj"
    local sDoLinking="$sCpl $pObj $pLib -o $pExe"
    #   run command
    if [ $C_TUTOR_LIBRARY__SRC == $fSrc ]; then
        echo "--- compile only: \$> $sTxt"
        $sDoCompile
    else
        echo "--- compile+link: \$> $sTxt"
        $sDoCompile
        $sDoLinking
        v_RUN_aRc+=($pExe)  # store exe
    fi
}

#   handle my source array
function f_run_doCompileAll() {
    #   input:v_aRc  - src
    #   output:v_aRc - exe
    echo "&&& doCompile all"
    aSrc=("${v_RUN_aRc[@]}")
    nSrc=${#aSrc[@]}
    echo "&&& nSrc={$nSrc}"
    echo "&&& aSrc=${aSrc[@]}"
    i=0
    v_RUN_aRc=()
    for fSrc in "${aSrc[@]}"
    do
        i+=1
        f_run_compile_and_link $fSrc ; v_RUN_iRc=$?     # out: v_aRc
    done
    echo "&&& iCtr = '$i'"
    echo "&&& dObjDir = '$dTmp'"
    echo "&&& aObj=${v_RUN_aRc[@]}"
    return 0
}

#   runAll
function f_run_doExecuteAll() {

    dExe=$1
    echo "=== dExe:[$dExe]"

    #   copy into object array
    for x in "${v_RUN_aRc[@]}"
    do
        i+=1
        pExe="$dExe/$x"
        printf "execute:[%2.2d]:'%s'\n" $i $pExe
        sleep 1
        $pExe
    done

}



#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#   m:  body
#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

#   s:  B.modifier
bTrc=$v_TRUE
bLog=$v_FALSE

#   s:  B.compose
dTmp=${v_FWK_dirScratch}
v_sSid='c'          #   script file identifier
v_sExt_src='c'      #   script file extension
v_sExt_obj='obj'    #   output extensionID
v_sExt_exe='exe'    #   executable extension

#   u:  C.Library
s=$(basename ${C_TUTOR_LIBRARY__SRC})
s="${s%.*}"             #   Body
declare -r C_TUTOR_LIBRARY__OBJ="${s}.${v_sExt_obj}"

#   s:  B.const
declare -r  C_TUTOR_LIBRARY__SRC='c00_library.c'
declare -r  C_REX_SRC='^c[0-9]{2}_[A-Za-z]+\.c$'
declare -r  C_REX_EXE='^c[0-9]{2}_[A-Za-z]+\.exe$'

#   s:  B.define
declare -a v_RUN_aRc
declare -i v_RUN_iRc
declare -i i=0
declare -i n=0
declare -a aSrc

#
#   m:  B.main
#

#   s:  M.header
s=$(date "+%Y-%m-%d %H:%M:%S"); echo ">>> BEG.make.legacy [$s]"

#   m:  main
if  [ "$1" == ""  ]     ||
    [ "$1" == '?' ]     ||
    [ "$1" == 'h' ]     ; then
    f_run_usage
    exit 0

elif [ "$1" == 'c' ]; then
    f_run_clean
    exit 1

elif [ "$1" == 'r' ]; then

    dExe=$v_FWK_dirScratch
    echo "&&& run:at[$dTmp]"

    #   fetch at TMP
    pushd $dExe
    f_run_fetchFiles '^c[0-9]{2}_[A-Za-z]+\.exe$'; iRc=$?
    popd

    f_run_doExecuteAll $dExe; iRc=$?


elif [ "$1" == 'i' ]; then
    echo "&&& info src"
    f_run_fetchFiles '^c[0-9]{2}_[A-Za-z]+\.c$'; iRc=$?
    aSrc=("${v_RUN_aRc[@]}")
    nSrc=${#aSrc[@]}
    echo "&&& nSrc={$nSrc}"
    echo "&&& aSrc=${aSrc[@]}"

elif [ "$1" == '!' ]; then
    f_run_fetchFiles '^c[0-9]{2}_[A-Za-z]+\.c$'; iRc=$?
    echo "... compile"
    f_run_doCompileAll; iRc=$?
else
    echo "... error option use['?']"
fi

#   s:  M.footer
s=$(date "+%Y-%m-%d %H:%M:%S"); echo "<<< END.make.legacy [$s]; reply:<$iRc>"
