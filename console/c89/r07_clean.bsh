#!/bin/bash

#   ***************************************************************************
#   run:[simple]  Tutorial C89 2026        ©[mATe64]           [2026-10-12]
#   ***************************************************************************

#   usage:
#       $   bash [run~clean].bsh

#   ***************************************************************************

#   s:  F.clean
function f_run_clean() {

    #   declare
    declare -a aExt=('o' 'obj' 'out' 'exe' 'bin')

    #   clean local
    for x in "${aExt[@]}"; do
        f='*.'
        f+=$x
        rm -f $f
    done

    #   clean scratch
    pushd $v_FWK_dirScratch > /dev/null
    for x in "${aExt[@]}"; do
        f='*.'
        f+=$x
        rm -f $f
    done
    popd > /dev/null

}

#   s:  body
clear
f_run_clean
echo "&&& ready clean."
