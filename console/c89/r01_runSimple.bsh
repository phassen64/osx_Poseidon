#!/bin/bash

#   ***************************************************************************
#   run:[simple]  Tutorial C89 2026        ©[mATe64]           [2026-10-12]
#   ***************************************************************************

#   usage:
#       $   bash run_01_simple.bsh

#   remark:
#       only compile, not run "tutor-library"

#   content:
#       m:  run.prepare
#       m:  run.compile
#   ***************************************************************************

#
#   m:  prepare
#

#   s:  const library source
declare -r C_TUTOR_LIBRARY__SRC='c00_library.c'

#   s:  const library object
s=$(basename ${C_TUTOR_LIBRARY__SRC})
s="${s%.*}"             #   Body
declare -r C_TUTOR_LIBRARY__OBJ="${s}.obj"

#   echo "lib.obj:'$C_TUTOR_LIBRARY__OBJ'"
#   exit

#   s:  show
clear
declare -i iReply=$RANDOM
echo "+ run.simple:[$iReply]"

#   s:  fetch all bash
declare -a a=$(echo `ls c??_*.c`)

#   s:  array size
declare -i n
n=${#a[@]}; echo "n1==[$n]" # not works

#   calc manually
n=0
for xFile in $a; do
    n+=1
done
echo "n==[$n] "

#   s:  fetchDateTime
declare sFmt="+%Y-%m-%d %H:%M:%S"
declare sDtm

#   ===========================================================================
#   m:  compile
#   ===========================================================================

clear

#   s:  header
sDtm=$(date "$sFmt")
s='simple::compile+link+run'; printf "BEG %s [%s]\n\n" $s "$sDtm"

declare -i i=0

for sFile in $a
do



    declare sNam=$(basename ${sFile})     #   source baseName.src
    declare sExt="${sNam##*.}"            #   extension
    declare sBdy="${sNam%.*}"             #   Body

    declare xFile="${sBdy}.exe"        #   new fileName
    declare oFile="${sBdy}.obj"        #   object

    i+=1

    #   u:  show
    printf "&&& make[%2.2d]:'%s' of:[%d] into:'%s' \n" \
            $i $sFile $n  $xFile

    #   u:  make (compile+link)
    #   u:  check library
    if [ $sFile == "$C_TUTOR_LIBRARY__SRC" ]
    then
        printf "&&& continue library!:'%s'\n"  $C_TUTOR_LIBRARY__SRC
        gcc -c $sFile -o $C_TUTOR_LIBRARY__OBJ
        continue
    else
        gcc -c $sFile -o $oFile                         #   compile only
        gcc $oFile $C_TUTOR_LIBRARY__OBJ -o $xFile      #   linking
    fi

    #   u:  run
    printf "&&& run![%2.2d]:'%s'\n" $i $xFile
    ./$xFile

done

#   s:  footer
printf "\n"
sDtm=$(date "$sFmt")
s='simple::compile+link+run'; printf "END %s [%s]\n\n" $s "$sDtm"

