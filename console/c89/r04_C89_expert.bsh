#   encoding.UTF8:
#   !@€ƒ„…†‡ˆ‰Š‹ŒŽ +‘“”•—™š›œžŸ+¡¢£¤¥¦§¨©«¬®°±²³µ¶·¹º»¼½¾¿ÄÖÜÑ×ØÞßäæçîðñôö÷üýþÿ

#   description:
#       Build the complete tutorial.C89 and Generate Build-LogFile.
#       Compile & linking of all c??_*.c files in the
#               ScratchDirectory.
#           Step1:  compile all files to OBJ files
#                   Special - compile into c89-TutorLibrary (c00)
#           Step2:  Link(c01-cMax) to tutor c-library and generate EXE file
#           Step3:  depending on run command executes
#                   any 1, all, allRandom, someRandom objects
#       Execute options:
#       Execute options:
#           '_' :   runAll in the order of their namings source[1]..[MAX]
#           '.' :   run1 EXE    - choose randomly
#           '!' :   runAll EXE  - choose randomly
#           '+' :   runSome EXE - choose randomly
#           '4' :   special index-mode, run specfic source[4]
#
#   usage:  $   bash <SCP.bsh> [option]

#   remark: The objects and executables are stored in the
#           [FWK-TEMP-Directory].

#   remark: The first C-source, named c00_*.c, is handled as the
#           c89-TutorLibrary
#
#           [FWK-TEMP-Directory].


#   rem:    don't execute c00*.c

<<usage
    Tutorial 2026-10-14

    +   usage:
            $ bash {THIS.bsh} [cOpt]||[iIdx] =:'?' [{iStressFator(iSfr)}]=:'1'
                with:
            cOpt := { '?','h','c','.','_','+','!'}
            iIdx := [1..MAX]
            iSfr := [1..10]

    +   test-base files REX:=[^HEAD][0-9]{2}_[A-Za-z].[TAIL$]
            C_REX_head  :   first file name letter like 'c'
            C_REX_tail  :   fileExtension

    +   compile not link 'c00'

    +   Examples:
            $> . run ?     :    help
            $> . run h     :    dito
            $> . run c     :    clean temp
            $> . run .     :    1x run some file of the tutorial
            $> . run 3     :    run exact 1x index '3'source[3] * indexMode
            $> . run _     :    run all files
            $> . run !     :    run all files but random
            $> . run +     :    1/q of  all files random
            $> . run . 2   :    run 1 file 2 times
usage


<<hereDoc_content_tutor__run_expert
    content:
        p:  p.function
            m:  F.hint
            m:  F.usage
            m:  F.clean
            m:  F.bEvaluate
