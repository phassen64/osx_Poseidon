#!/bin/bash

#   ****************************************************************************
#   TUTORIAL BASH:array and hash
#   ****************************************************************************

<<  =*=
    +   :01 define
    +   :02 sizeof an array
    +   :03 add/append
    +   :04 sub/slice
    +   :05 sort
    +   :06 access
    +   :07 shuffle
    +   :08 copy
    +   :09 HASH usage
    +   :10 combine
=*=

#
#   =*= :   header
#

source LIB.inc.bsh
z_EXE=$BASH_SOURCE; z_SCP=`basename $z_EXE`; z_iEc=$1
f_lib_header "$z_SCP" $LINENO $z_iEc; z_iEc=$?; z_iRc=$z_iEc

#
#   =*= :   define helper integer
#

f_lib_text "define some helper variables" $LINENO

declare -i i
declare -i n

#
#   =*= :m: define arrays
#

f_lib_menu "define some arrays" $LINENO

declare -a aTmp
s=$(declare -p aTmp); f_lib_puts "$s"       #   aTmp

aName=()
s=$(declare -p aName); f_lib_puts "$s"       #   aName=() : show

aOs=('ubuntu' 'centos' 'redhat' 'windows' 'macOs' 'andoid')
s=$(declare -p aOs); f_lib_puts "$s"

aNum=( 1 5 6 )
s=$(declare -p aNum); f_lib_puts "$s"

#
#   =*= :m: output arrays
#

f_lib_menuS1 "output array" $LINENO
aName=( 'Anton' 'Bert' 'Cleo' 'Dora' )
s=$(declare -p aName);  f_lib_puts "out1:'$s'"  #   output way1
s="${aName[@]}";        f_lib_puts "out2:'$s'"  #   output way2

#
#   =*= :m: sizeof an array
#

f_lib_menu "sizeof" $LINENO  # or length

n=${#aTmp[@]};  f_lib_puts "sizeof(aTmp)=<$n>"
n=${#aName[@]}; f_lib_puts "sizeof(aName)=<$n>"
n=${#aOs[@]};   f_lib_puts "sizeof(aOs)=<$n>"
n=${#aNum[@]};  f_lib_puts "sizeof(aNum)=<$n>"

#
#   =*= :m: add
#

f_lib_menu "add" $LINENO     # means append

aName=('Donald') # first
aName+=('Peter')
aName+=('Britney')
aName+=('Mike')
aName+=('Ronaldo')
s='Harvey'; aName+=("$s")
s=$(declare -p aName); f_lib_puts "$s"       #   aTmp

#
#   =*= :m: sub or slice
#

f_lib_menu "slice" $LINENO

#   syntax: bsh> aNew  = "${aOld[@]:$Idx:$Num}"

f_lib_random ${#aOs[@]}; i=$?
f_lib_random ${#aOs[@]}; n=$?; n+=1
aTmp=("${aOs[@]:$i:$n}")
f_lib_text $LINENO "slice(fromIndex:$i;numberToShow:$n)"
declare -p aTmp

#
#   =*= :m: sort an array
#

f_lib_menu "sort" $LINENO

aNum=( 9 1 5 )
s=$(declare -p aNum); f_lib_puts "$s"

#   show sorted
f_lib_text "sorting..." $LINENO
for x in "${aNum[@]}"; do f_lib_puts "$x"; done | sort

#   save sorted into an array
f_lib_text "sort+save with for,sort" $LINENO
readarray -t aTmp < <( for x in "${aNum[@]}"; do echo "$x"; done | sort )
s=$(declare -p aTmp); f_lib_puts "$s"

#   the best version fort sorting
#   URL:https://stackoverflow.com/questions/7442417/how-to-sort-an-array-in-bash
f_lib_text "sort+save with printf,sort,xargs..." $LINENO
readarray -t aTmp < <( printf '%s\0' "${aNum[@]}" | sort -z | xargs -0n1 )
s=$(declare -p aTmp); f_lib_puts "$s"

#
#   =*= :m: access arrays
#

f_lib_menu "access" $LINENO

s=$(declare -p aOs); f_lib_puts "$s"

n=${#aOs[@]}
for (( j=1; j <= 5; j++ ));
do
    f_lib_random $n; i=$?;
    f_lib_print "try[$j]:$i/$n =:" $v_LIB__PRT_noNLnoPx
    x=${aOs[$i]};
    f_lib_print "OS:<$x>" $v_LIB__PRT_onNLnoPx $v_COL_ID_yellow
done

#
#   =*= :m: shuffle
#

f_lib_menu "shuffle" $LINENO    # means append

s=$(declare -p aName); f_lib_puts   "before\t:$s"
aTmp=( $(shuf -e "${aName[@]}") )
s=$(declare -p aTmp); f_lib_puts    "after\t:$s"

#
#   =*= :m: copy
#

f_lib_menu "copy" $LINENO

declare -a aAlpha
declare -a aBeta

#   init alpha array with random and shuffle
f_lib_text "init ALPHA with shuffle" $LINENO
f_lib_random 1000; i=$?;
aAlpha=( 'Anastasia' 'Britney' 'Celine' $i )
aAlpha=( $(shuf -e "${aAlpha[@]}") )
declare -p aAlpha

#   show Beta (show old values)
f_lib_text "not init BETA" $LINENO
declare -p aBeta

#   copy aBeta:=aAlpha
f_lib_text "copy ALPHA:=BETA" $LINENO
aBeta=("${aAlpha[@]}")
declare -p aBeta

#   beta.add
x='MickyMouse'
f_lib_text "BETA+=<$x>"  $LINENO
aBeta+=($x)
declare -p aBeta

#   beta.shuffle
f_lib_text "shuffle(BETA)" $LINENO
aBeta=($(shuf -e "${aBeta[@]}"))
declare -p aBeta

#   show old a - not touched?
f_lib_text "show ALPHA again" $LINENO
declare -p aAlpha

#
#   =*= :m: hash
#

f_lib_menu "hash" $LINENO       # means append

#   define as "declare -A" and not "declare -a"
declare -A hChamp
hChamp=(['Bobby']='Fischer')
hChamp+=(['mike']='tyson')
hChamp+=(['Britney']='Spears')
hChamp+=(['Michael']='Jackson')
declare -p hChamp

#   retrieve
k='Bobby'   ; v=${hChamp['Bobby']}; f_lib_puts "'$k' => '$v'"
k='Britney' ; v=${hChamp[$k]};      f_lib_puts "'$k' => '$v'"
k='mike'    ; v=${hChamp[$k]};      f_lib_puts "'$k' => '$v'"

#
#   =*= :m combine
#

#   add array a1 and a2

f_lib_menu "combine" $LINENO

declare -a Common

aCity=('NewYork' 'Chicago' 'Berlin')
aPets=('Harvey' 'Putzi' 'Whisky')
declare -p aCity
declare -p aPets
aCommon=( ${aCity[@]} ${aPets[@]} )
nCommon=${#aCommon[@]}

#   show
f_lib_menuS1 "result" $LINENO
s="cCommon:=[$nCommon]";    f_lib_text "$s" $LINENO
s="${aCommon[@]}"; f_lib_text "$s" $LINENO

declare -i i=0
for xCommon in "${aCommon[@]}"
do
    i+=1
    printf "\tcommon:[%2.2d]:'%s'\n" $i $xCommon
done

#
#   =*= :   footer
#

echo "*** iRc.footer:<$z_iRc>"
f_lib_footer $z_SCP $LINENO $z_iRc $z_iEc

