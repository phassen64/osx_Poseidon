#!/bin/bash

#   ***************************************************************************
#   run:[advavanced]  Tutorial BASH 2026        ©[mATe64]       [2026-10-03]
#   ***************************************************************************
#   usage:
#       $   bash [run_02_advanced.bsh]
#   content:
#       m:  run.prepare
#       m:  run.scripts
#   ***************************************************************************

#   ===========================================================================
#   b:  script
#   ===========================================================================

function f_run_script {

    #   fetch
    local p_aSrc=$1
    local p_nStressMax=$2     # stress counter
    local p_iRnd=$3

    #   declare
    declare -i i=0
    declare -i n=0
    declare -i iFile=0
    declare -i nFile=0

    #   calc.array FileNumber
    nFile=0
    for xFile in $p_aSrc; do
        nFile+=1
    done

    #   run
    printf "+++ script nMax:<%d>  iRnd:[%d]\n" $nFile $p_iRnd

    for (( n=1; n<=$p_nStressMax; n++ )); do
        printf "\n+++ stress:[%3.3d]\n\n" $n
        iFile=0
        for xFile in $p_aSrc
        do
            iFile+=1
            printf "*** runScr:[%3.3d].[%2.2d]:'%s'\n" $n $iFile $xFile
            bash $xFile
        done
    done

}

#   ===========================================================================
#   b:  body
#   ===========================================================================

#
#   m:  prepare
#

#   s:  fetch all bash
aTest=$(echo `ls t*.bsh`)
#   echo "test: ( $aTest )"

#   s:  fetchDateTime
declare sFmt="+%Y-%m-%d %H:%M:%S"
declare sDtm=$(date "$sFmt")
declare -i iStressCounter=2

#   m:  run
clear
printf "BEG advanced.run:[%s]\n\n" "$sDtm"

fLog='peter1.log'
f_run_script "$aTest" "$iStressCounter" "$RANDOM" > $fLog

printf "END advanced.run:[%s]\n\n" "$sDtm"

