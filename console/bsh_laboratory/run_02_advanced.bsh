#!/bin/bash

#   ***************************************************************************
#   run:[advavanced]  Tutorial BASH 2026        ©[mATe64]       [2026-10-03]
#   ***************************************************************************
#   usage:
#       $   bash [run_02_advanced.bsh]
#   content:
#       m:  run.prepare
#       m:  run.scripts
#   ***************************************************************************

#   ===========================================================================
#   b:  script
#   ===========================================================================

function f_run_script {
    #   fetch
    local p_aSrc=$1
    local p_iRnd=$2
    #   declare
    declare -i i=0
    declare -i n=0
    #   calc.arrayLen
    n=0
    for xFile in $p_aSrc; do
        n+=1
    done
    #   run
    printf "+++ scriptRun number:<%d>  rnd:[%d]\n" $n $p_iRnd
    for xFile in $p_aSrc
    do
        i+=1
        printf "*** run:[%2.2d]/[%2.2d]:'%s'\n" $i $n $xFile
        bash $xFile
    done
}

#   ===========================================================================
#   b:  body
#   ===========================================================================

#
#   m:  prepare
#

#   s:  fetch all bash
aTest=$(echo `ls t*.bsh`)
#   echo "test: ( $aTest )"

#   s:  fetchDateTime
declare sFmt="+%Y-%m-%d %H:%M:%S"
declare sDtm=$(date "$sFmt")

#   m:  run
clear
printf "BEG advanced.run:[%s]\n\n" "$sDtm"
f_run_script "$aTest" "$RANDOM"
printf "END advanced.run:[%s]\n\n" "$sDtm"

