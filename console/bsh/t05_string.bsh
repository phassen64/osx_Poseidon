#   description:    string compare

#   usage       :   $   bash t05_string

#   !url        :   https://www.w3schools.com/bash/


<< hereDoc_content_tutor__string
    content:
        b:  B.body
            b:  b.include
            b:  f.header
            b:  f.main
            •   m:  S.definition
