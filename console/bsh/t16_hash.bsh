hereDoc_content_tutor__array

#   p:  p.function
#   p:  p.body

#   b:  b.include
source LIB.wsp.inc.bsh
if [ "$1" == "" ]; then f_lib_configuration '+' '-'; fi
declare -i z_iReply_iEc=$1

#   b:  b.header
f_lib_header $z_iReply_iEc

#   b:  b.main
declare -i i
declare -i n
declare c=$v_LIB_color__blue

#   ===========================================================================
#   m:  H.define    hashArray
#   ===========================================================================

#   m:  F.menu
f_lib_menu "H.define"           # means append

#   s:  define as "declare -A" and not "declare -a"
f_lib_puts "define hash Champ" $c
declare -A hChamp

#   s:  add
hChamp=(['Bobby']='Fischer')
hChamp+=(['mike']='tyson')
hChamp+=(['Britney']='Spears')
hChamp+=(['Michael']='Jackson')
declare -p hChamp

#   s:  retrieve
f_lib_puts "\nretrieve elements" $c
k='Bobby'   ; v=${hChamp['Bobby']}; f_lib_puts "'$k' => '$v'"
k='Britney' ; v=${hChamp[$k]};      f_lib_puts "'$k' => '$v'"
k='mike'    ; v=${hChamp[$k]};      f_lib_puts "'$k' => '$v'"
k='Michael' ; v=${hChamp[$k]};      f_lib_puts "'$k' => '$v'"

#   ###########################################################################
#   b:  b.footer
#   ###########################################################################
f_lib_footer 0

#   p:  p.last