#!/bin/bash
#   ***************************************************************************
#   Library.bsh 2026        ©[mATe64]           [2026-09-30]
#   ***************************************************************************

#   input:
#           •   v_FWK_dirScratch

#   remark:
#       The lib configuration should be set to verbose

#   remark 'echo':
#       The primary options (flags) supported by the Bash echo command are:
#       Option Description Example
#       -n      Suppresses the trailing newline (keeps output on the same line)
#               example:    $   echo -n "Hello && " echo "peter"
#       -e	    Enables interpretation of backslash
#                   escape sequences (e.g., \n, \t).
#               example:    $   echo -e "Line1\nLine2"
#       -E	    Disables backslash escape interpretation
#                   (this is the default setting).
#               example:    $   echo -E "Line1\nLine2"




#   content:
#       b:  B.function
#           •   m:  F.config
#           •   m:  F.helper
#           •   m:  F.color
#               •   s:  f.define.colorEscape
#               •   s:  f.define.colorValue
#           •   m:  F.echo & F.print & F.puts
#           •   m:  F.logging
#           •   m:  F.plgs
#           •   m:  F.menu
#       b:  B.body


#   &&& b:  b.function  &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&


#   ===========================================================================
#   m:  F.config
#   ===========================================================================

function f_lib_configuration() {
    v_LIB_mode_bVerbose=$1
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.configuration :: [$v_LIB_mode_bVerbose] !"
        echo "< L.iRc :: [$v_LIB_reply_iRc]"
        echo "< L.sRc :: [$v_LIB_reply_sRc]"
    fi
    #   set my internals
    f__color_defineEscapeCode
    f__color_defineValue
    f__color_configure
}

function f_lib_info() {
    local p=$BASH_SOURCE
    local s
    s=$(stat -c %y% $p)
    echo "<  L.sLib.DTM :: [$s]"
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

#   ===========================================================================
#   m:  F.helper
#   ===========================================================================


function f_lib_who() {
    local l_sPwd=`pwd`
    local l_sScp=$BASH_SOURCE
    local l_sPth=$l_sPwd/$l_sScp
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.who :: I am file:[$l_sPth]"
    fi
}

function f_lib_where() {
    local p_sCaller=$1
    local p_iLine=$2
    local p_iValue=$3
    #   my Name
    local l_sFct=${FUNCNAME[0]}
    #   show
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.where :: Hello I am:[$l_sFct] !"
        echo "< L.where :: I was called by:[$p_sCaller] atLine:[$p_iLine]"
        echo "< L.where :: I got the value:[$p_iValue]"
    fi
}

function f_lib_caller() {
    local p_sCaller=$1
    local l_sPwd=`pwd`
    local l_sPth
    #   show
    l_sPth=$l_sPwd/$p_sCaller
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.caller :: [$l_sPth] !"
    fi
}

function f_lib_dateTime() {
    local l_sDtm=$(date $v_LIB_dtmFormatString_now)
    local s
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.dateTime :: [$l_sDtm]"
    fi
    s=$l_sDtm
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

function f_lib_sleep() {
    local i=$1
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.sleep :: [$i]"
    fi
    sleep $i
}

#   in: iMax [iMin]
function f_lib_random() {

    declare -i p_iMax=$1     #   iRnd = [iMax...iMin]
    declare -i p_iMin=$2
    declare -i n
    declare -i i

    #   return if wrong input
    if [ $p_iMax -le 0 ]; then
        return 0
    fi

    #   calc random
    n=$RANDOM

    #   modulo
    i=$(( $n % $iMax ))         #  RANDOM() => 0...nMax-1

    #   add lower boundary
    let "i += $p_iMin"          #  MIN..MAX

    #   show
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.iMax      :: [$p_iMax]"
        echo "< L.iMin      :: [$p_iMin]"
        echo "< L.random    :: [$n]"
        echo "< L.iRnd      :: [$i]"
    fi

    return $i
}



#   ===========================================================================
#   m:  F.color
#   ===========================================================================

#   s:  f.define.colorEscape

function f__color_defineEscapeCode() {

    #!URL   https://stackoverflow.com/questions/5947742/
    #               /how-to-change-the-output-color-of-echo-in-linux
    #   ansi colors
    #   Black        0;30     Dark Gray     1;30
    #   Red          0;31     Light Red     1;31
    #   Green        0;32     Light Green   1;32
    #   Brown/Orange 0;33     Yellow        1;33
    #   Blue         0;34     Light Blue    1;34
    #   Purple       0;35     Light Purple  1;35
    #   Cyan         0;36     Light Cyan    1;36
    #   Light Gray   0;37     White         1;37

    #   00:NONE
    v_LIB_COLOR_ESC_NONE='\033[0m'          #   no color or RESET

    #   Foreground: '0'
    v_LIB_COLOR_ESC_FG_black='\033[0;30m'
    v_LIB_COLOR_ESC_FG_red='\033[0;31m'
    v_LIB_COLOR_ESC_FG_green='\033[0;32m'
    v_LIB_COLOR_ESC_FG_brown='\033[0;33m'
    v_LIB_COLOR_ESC_FG_blue='\033[0;34m'
    v_LIB_COLOR_ESC_FG_magenta='\033[0;35m'
    v_LIB_COLOR_ESC_FG_cyan='\033[0;36m'
    v_LIB_COLOR_ESC_FG_Lgray='\033[0;37m'

    #   Foreground 01:class '1'
    v_LIB_COLOR_ESC_FG_gray='\033[1;30m'
    v_LIB_COLOR_ESC_FG_Lred='\033[1;31m'
    v_LIB_COLOR_ESC_FG_Lgreen='\033[1;32m'
    v_LIB_COLOR_ESC_FG_yellow='\033[1;33m'
    v_LIB_COLOR_ESC_FG_Lblue='\033[1;34m'
    v_LIB_COLOR_ESC_FG_Lpurple='\033[1;35m'
    v_LIB_COLOR_ESC_FG_Lcyan='\033[1;36m'
    v_LIB_COLOR_ESC_FG_white='\033[1;37m'

    #   Background
    v_LIB_COLOR_ESC_BG_black='\033[40m'       # Black
    v_LIB_COLOR_ESC_BG_red='\033[41m'         # Red
    v_LIB_COLOR_ESC_BG_green='\033[42m'       # Green
    v_LIB_COLOR_ESC_BG_yellow='\033[43m'      # Yellow
    v_LIB_COLOR_ESC_BG_blue='\033[44m'        # Blue
    v_LIB_COLOR_ESC_BG_magenta='\033[45m'      # Purple
    v_LIB_COLOR_ESC_BG_cyan='\033[46m'        # Cyan
    v_LIB_COLOR_ESC_BG_white='\033[47m'       # White

    # Bold
    v_LIB_COLOR_ESC_BD_black='\033[1;30m'       # Black
    v_LIB_COLOR_ESC_BD_red='\033[1;31m'         # Red
    v_LIB_COLOR_ESC_BD_green='\033[1;32m'       # Bold.Green
    v_LIB_COLOR_ESC_BD_yellow='\033[1;33m'      # Yellow
    v_LIB_COLOR_ESC_BD_blue='\033[1;34m'        # Blue
    v_LIB_COLOR_ESC_BD_magenta='\033[1;35m'      # Purple
    v_LIB_COLOR_ESC_BD_cyan='\033[1;36m'        # Cyan
    v_LIB_COLOR_ESC_BD_white='\033[1;37m'       # White

    # Underline
    v_LIB_COLOR_ESC_UL_black='\033[4;30m'       # Black
    v_LIB_COLOR_ESC_UL_red='\033[4;31m'         # Red
    v_LIB_COLOR_ESC_UL_green='\033[4;32m'       # Underline.Green
    v_LIB_COLOR_ESC_UL_yellow='\033[4;33m'      # Yellow
    v_LIB_COLOR_ESC_UL_blue='\033[4;34m'        # Blue
    v_LIB_COLOR_ESC_UL_magenta='\033[4;35m'      # Purple
    v_LIB_COLOR_ESC_UL_cyan='\033[4;36m'        # Cyan
    v_LIB_COLOR_ESC_UL_white='\033[4;37m'       # White
}

#   s:  f.define.colorValue

function f__color_defineValue() {
    #   standard
    v_LIB_COLOR_VID_none=-1
    v_LIB_COLOR_VID_black=0
    v_LIB_COLOR_VID_gray=8
    #   dark
    v_LIB_COLOR_VID_DK_red=1
    v_LIB_COLOR_VID_DK_green=2
    v_LIB_COLOR_VID_DK_yellow=3   # olive
    v_LIB_COLOR_VID_DK_blue=4
    v_LIB_COLOR_VID_DK_magenta=5
    v_LIB_COLOR_VID_DK_cyan=6
    v_LIB_COLOR_VID_DK_white=7
    #   light - not for RPi?
    v_LIB_COLOR_VID_LH_red=9
    v_LIB_COLOR_VID_LH_green=10
    v_LIB_COLOR_VID_LH_yellow=11
    v_LIB_COLOR_VID_LH_blue=12
    v_LIB_COLOR_VID_LH_magenta=13
    v_LIB_COLOR_VID_LH_cyan=14
    v_LIB_COLOR_VID_LH_white=15
}

function f__color_configure() {

#   handle color
    local iEnvId=$v_ENV__id
    local bColor=false

    #   standard
    v_LIB_COLOR_VID_none=-1
    v_LIB_COLOR_VID_black=0
    v_LIB_COLOR_VID_gray=8

#   dark
    v_LIB_COLOR_VID_DK_red=1
    v_LIB_COLOR_VID_DK_green=2
    v_LIB_COLOR_VID_DK_yellow=3   # olive
    v_LIB_COLOR_VID_DK_blue=4
    v_LIB_COLOR_VID_DK_magenta=5
    v_LIB_COLOR_VID_DK_cyan=6
    v_LIB_COLOR_VID_DK_white=7

#   light - not for RPi
    v_LIB_COLOR_VID_LH_red=9
    v_LIB_COLOR_VID_LH_green=10
    v_LIB_COLOR_VID_LH_yellow=11
    v_LIB_COLOR_VID_LH_blue=12
    v_LIB_COLOR_VID_LH_magenta=13
    v_LIB_COLOR_VID_LH_cyan=14
    v_LIB_COLOR_VID_LH_white=15

#   RPi/GIT redefine...?
    #   -z is true when a string has zero length,
    if [ -z $iEnvId ] ; then
        bColor=true
    elif [ $iEnvId -ne 3 ] && [ $iEnvId -ne 9 ] ; then
        bColor=true
    fi

    if [ $bColor ] ; then
        v_LIB_COLOR__red=$v_LIB_COLOR_VID_DK_red
        v_LIB_COLOR__green=$v_LIB_COLOR_VID_DK_green
        v_LIB_COLOR__yellow=$v_LIB_COLOR_VID_LH_yellow
        v_LIB_COLOR__blue=$v_LIB_COLOR_VID_LH_blue
        v_LIB_COLOR__magenta=$v_LIB_COLOR_VID_LH_magenta
        v_LIB_COLOR__cyan=$v_LIB_COLOR_VID_LH_cyan
        v_LIB_COLOR__white=$v_LIB_COLOR_VID_LH_white
    fi

}

#   ===========================================================================
#   m:  F.echo & F.print & F.puts
#   ===========================================================================

#   *   standard
function f_lib_echo() {
    local s=$1
    echo -E $s      #   no \t\n or EscapeChars
}

#   *   complete control but ESC inside the string

function f__print() {
    #   par1:   string to print
    #   par2:   bNewLine standard is FALSE
    #   par3:   foregroundColor_ID <integer>
    #   par4:   backgroundColor_ID <integer>
    local pStr=$1; local pNL=$2; local pFgd=$3; local pBgd=$4;
    #   number of parameters >= 1
    if [ $# == 0 ]; then
        return 0
    fi
    #   echo "L.print {$pStr}  {$pNL} {$pFgd} {$pBgd} "
    #   set colors
    if [ ! -z $pFgd ] && [ $pFgd -ne $v_LIB_COLOR_VID_none ]; then
        tput setaf $pFgd
    fi
    if [ ! -z $pBgd ] && [ $pBgd -ne $v_LIB_COLOR_VID_none ]; then
        tput setab $pBgd
    fi
    #   set NewLine
    if [ ! -z $pNL ] && [ $v_LIB_bTrue == "$pNL" ]; then
        echo -e $pStr $v_LIB_COLOR_ESC_NONE
    else
        echo -e -n $pStr $v_LIB_COLOR_ESC_NONE  # no NewLine
    fi
}

#   wrapper.print
function f_lib_print() {
    f__print "$1" "$2" "$3" "$4"
}

#   wrapper.puts
function f__puts() {
    f__print "$1" "$v_LIB_bTrue" "$2"
}

#   ===========================================================================
#   m:  F.file
#   ===========================================================================

#   in: filePath


function f_lib_file_getPath() {
    local p_sScp=$1
    local l_sPwd=`pwd`
    local s
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.pScp :: [$p_sScp]"
        echo "< L.sPwd :: [$l_sPwd]"
    fi
    s=$l_sPwd/$p_sScp
    v_LIB_reply_sRc=$s
    return ${#s}        # reply strlen
}

function f_lib_file_getName()   {
    local p=$1
    local s
    s=$(basename ${p})      #   extract filePath
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.fileGetName =: [$s]"
    fi
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

function f_lib_file_getBody()   {
    local p=$1
    local s
    #   echo "::filePath($p)"
    s=$(basename ${p})  # baseName
    s=$(echo "$s" | sed -e 's/\.[^.]*$//')  # fileBody
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

function f_lib_file_getExtension()   {
    local p=$1
    local s
    #   echo "::filePath($p)"
    # Source - https://stackoverflow.com/a/965072
    s=$(basename ${p})  # baseName
    s="${s##*.}"
    s=.$s
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

function f_lib_file_getModificationTime()   {
    #   $  stat --help | grep "time of"
    #   %w   time of file birth, human-readable; - if unknown
    #   %x   time of last access, human-readabl
    #   %X   time of last access, seconds since Epoch
    #   %y   time of last data modification, human-readable
    #   %Y   time of last data modification, seconds since Epoch
    #   %z   time of last status change, human-readable
    #   %Z   time of last status change, seconds since Epoch
    local p=$1
    local s
    s=$(stat -c %y% $p)
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}


function f_lib_file_write()   {

    local p_sFilePath=$1
    local p_sText=$2
    local p_iMod=$3
    local s=$p_sText

    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.sFpt :: [$p_sFilePath]"
        echo "< L.sTxt :: [$p_sText]"
        echo "< L.iMod :: [$p_iMod]"
    fi

    if [ 2 == $p_iMod ]; then
        echo "append file"
        echo $sTxt >> $p_sFilePath
    else
        echo "create & write file"
        echo $sTxt > $p_sFilePath
    fi

    return ${#s}    # reply strlen
}


#   ===========================================================================
#   m:  F.logging
#   ===========================================================================

#   log string create||append
function f__logs() {
    local s=$1
    local bCreate=$2
    #   create or append
    if [ $v_LIB_bTrue -eq $v_LIB_log_bEnabled ]; then
        if [ ! -z $bCreate ] && [ $v_LIB_bTrue -eq $bCreate ]; then
            echo "$s" >  $v_LIB_log_sFileName
        else
            echo "$s" >>  $v_LIB_log_sFileName
        fi
    fi
    return ${#s}
}

function f__log_determineFilePath() {

    #   filePath
    local p_pSrc=$1         #   source  sFilePath
    local p_dObj=$2         #   object  sDir
    local p_bDtm=$3         #   appendix bDateTimeString

    #   me
    local sFct=${FUNCNAME[0]}

    #   check.srcPth
    if [ ! -f $p_pSrc ]; then
        echo "? p1:[$p_pSrc] at:[$sFct;$LINENO]"
        exit
    fi
    #   check.objDir
    if [ ! -d $p_dObj ]; then
        echo "? p2:[$p_dObj] at:[$sFct;$LINENO]"
        exit
    fi

    #   getFileName and getFileBody
    s=$(basename ${p_pSrc})
    s=$(echo "$s" | sed -e 's/\.[^.]*$//')  # body

    #   logging with dateTime?
    if [ $v_LIB_bTrue  == $p_bDtm ]; then
        local l_sFmt=$v_LIB_dtmFormatString_now
        local l_sDtm=$(date $l_sFmt)
        s+='_'
        s+=$l_sDtm
        echo "< L.sDtm :: [$s]"
    fi

    #   concat
    s="$p_dObj/$s"
    s+=$v_LIB_log_sFileExtension

    #   reply
    v_LIB_reply_sRc=$s
    return ${#s}        # reply strlen
}


function f_lib_logging_getPath() {

    #   parameter
    local p_pSrc=$1
    local p_dObj=$2
    local p_bMod=$3     #   extended->DateTimeString

    #   local
    local s

    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.p_pSrc :: [$p_pSrc]"
        echo "< L.p_dObj :: [$p_dObj]"
        echo "< L.p_bMod :: [$p_bMod]"
    fi

    #   run internal
    f__log_determineFilePath $p_pSrc $p_dObj $p_bMod; iRc=$?

    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.sReply :: [$v_LIB_reply_sRc]"
    fi

    #   return
    s=$v_LIB_reply_sRc
    return ${#s}        # reply strlen
}

#   ===========================================================================
#   m:  F.plgs (print & log)
#   ===========================================================================

function f__plgs() {
    f__puts "$1" "$2"
    f__logs "$1"
    return 1
}

function f_lib_puts() {
    f__plgs "$1" "$2"
}

function f_lib_text() {
    local p_sTxt=$1
    local c=$2
    s="\t $p_sTxt"
    f__plgs "$s" "$c"
}


#   ===========================================================================
#   m:  F.menu
#   ===========================================================================

function f_lib_header() {

    local p_sScp=$1     #   callerScp
    local p_iPos=$2     #   line
    local p_iHRc=$3     #   lib headerRc
    local l_sFct=${FUNCNAME[0]}
    local l_sNow=$(date $v_LIB_dtmFormatString_now)
    local -x s

    #   save replyCode
    v_LIB_iEc=$p_HRc

    #   show header
    s="=== hdr:[$p_sScp;$p_iPos]:[$l_sNow]"
    f__puts "$s" $v_LIB_COLOR_VID_green

    #   s=">>> =h= "
    #   s=">>> "
    #   s+="$p_sScp<$v_TIME_HDR>:[$p_iLine]:{$p_iReply}";
    #   f__output "$s" $v_COL_ID_green

    #   time.Start
    v_LIB_timer_tStart=$(date +%s.%N)

    #   show
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.lFct :: [$l_sFct]"
        echo "< L.pScp :: [$p_sScp]"
        echo "< L.iPos :: [$p_iPos]"
        echo "< L.iEc  :: [$v_LIB_iEc]"
        echo "< L.tDtm.start :: [$v_LIB_timer_tStart]"
    fi

    #   get logFileName
    local bMod=$v_LIB_log_bUseDtmName      # dtmString?
    local sFpt=$p_sScp
    local sDir=$v_FWK_dirScratch
    f__log_determineFilePath $sFpt $sDir $bMod; iRc=$?

    #   save reply
    v_LIB_log_bEnabled=$v_LIB_bTrue
    v_LIB_log_sFileName=$v_LIB_reply_sRc

    #   show
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.sLogFile  :: [$v_LIB_log_sFileName]"
        echo "< L.iRc       :: [$iRc]"
    fi

    #   create+write into myLogFile
    s="--- automaticall created by '$p_sScp'"
    f__logs "$s" $v_LIB_bTrue

    #   create+write into myLogFile
    s=">>> hdr:[$p_sScp;$p_iPos]:[$l_sNow]:$p_iHRc"
    f__logs "$s"

    #   return
    return $v_LIB_iEc
}


function f_lib_footer() {

    local p_sScp=$1     #   callerScp
    local p_iPos=$2     #   line
    local p_iFRc=$3     #   current.footer.Rc

    local l_sFct=${FUNCNAME[0]}

    #   time.Stop
    v_LIB_timer_tStopp=$(date +%s.%N)

    #   show
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.lFct :: [$l_sFct]"
        echo "< L.pScp :: [$p_sScp]"
        echo "< L.iPos :: [$p_iPos]"
        echo "< L.iEc  :: [$v_LIB_iEc]"
        echo "< L.tDtm.stopp :: [$v_LIB_timer_tStopp]"
    fi

    #   diff time
    local fDiff=$(echo "($v_LIB_timer_tStopp-$v_LIB_timer_tStart) / 1" | bc)
    local sSec=$(echo $fDiff)

    #   create+write into myLogFile
    s="<<< ftr:[$p_sScp;$p_iPos]:$p_iFRc:{$sSec}"
    f__logs "$s"

    #   return
    return $v_LIB_iEc
}


#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#   b:  B.body
#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

#   s:  LIB.boolean
declare -i v_LIB_bTrue=100
declare -i v_LIB_bFalse=255

#   s:  LIB.config.setting.verbose : 1
declare -i v_LIB_mode_bVerbose=$v_LIB_bFalse
declare -i v_LIB_mode_bExtended=$v_LIB_bFalse

#   s:  LIB.replyCodes
declare -i v_LIB_reply_iRc=99
declare -x v_LIB_reply_sRc='?None'

#   s:  LIB.exitCode
declare -i v_LIB_iEc=61

#   s:  LIB.timer
declare -x v_LIB_timer_tStart
declare -x v_LIB_timer_tStopp

#   s:  LIB.timer
declare -x v_LIB_dtmFormatString_now="+%y%m%d%H%M%S"

#   s:  LIB.logging
declare -i v_LIB_log_bEnabled=$v_LIB_bFalse
declare -i v_LIB_log_bUseDtmName=$v_LIB_bFalse  # short Name
declare -x v_LIB_log_sFileExtension='.log'
declare -x v_LIB_log_sFileName

