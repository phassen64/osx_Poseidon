#   &&& b:  B.function

#   ===========================================================================
#   m:  F.lib.init
#   ===========================================================================

function f_lib_initialize(){

    #   echo "+++ lib.Init"

    #   m:  v.replyCodes
    declare -i v_LIB_reply_bRc=0    && export v_LIB_reply_bRc
    declare -i v_LIB_reply_iRc=9    && export v_LIB_reply_iRc
    declare -x v_LIB_reply_sRc='?'  && export v_LIB_reply_sRc
    declare -i v_LIB_reply_iEc=0    && export v_LIB_reply_iEc
    declare    v_LIB_reply_aRc=()   && export v_LIB_reply_aRc

    #   m:  v.timer
    declare -x v_LIB_timer_tStart   && export v_LIB_timer_tStart
    declare -x v_LIB_timer_tStopp   && export v_LIB_timer_tStopp

    #   m:  v.logging
    declare -x v_LIB_log_pFile  && export v_LIB_log_pFile

    #   m:  v.config
    declare -i v_LIB_mode_bColored=0    && export v_LIB_mode_bColored
    declare -i v_LIB_mode_bVerbose=0    && export v_LIB_mode_bVerbose
    declare -i v_LIB_mode_bExtended=0   && export v_LIB_mode_bExtended
    declare -i v_LIB_mode_bDebugging=0  && export v_LIB_mode_bDebugging

}

#   ===========================================================================
#   m:  F.lib.alias
#   ===========================================================================

function f_lib_alias_set() {
    #   echo "+++ lib.aliasSet"
    alias +color='f_lib_configuration 3'
}

#   ===========================================================================
#   m:  F.lib.config
#   ===========================================================================

function f_lib_configuration() {

    #   echo "+++ lib.Config"

    local p_cMod1=$1
    local p_cMod2=$2
    local p_cMod3=$3
    local p_cMod4=$4

    #   clear all flags
    v_LIB_mode_bVerbose=$v_LIB_bFalse
    v_LIB_mode_bExtended=$v_LIB_bFalse
    v_LIB_mode_bColored=$v_LIB_bFalse
    v_LIB_mode_bDebugging=$v_LIB_bFalse

    if [ "$p_cMod1" == '+' ]; then
            f_lib_debug "+++   libCfg.Color"
        f__color_defineEscapeCode
        f__color_defineFontValue
        f__color_configure
        v_LIB_mode_bColored=$v_LIB_bTrue

    fi
    if [ "$p_cMod2" == '+' ]; then
        f_lib_debug "+++   libCfg.Verbose"
        v_LIB_mode_bVerbose=$v_LIB_bTrue

    fi
    if [ "$p_cMod3" == '+' ]; then
        f_lib_debug "+++   libCfg.Extended"
        v_LIB_mode_bExtended=$v_LIB_bTrue
    fi
    if [ "$p_cMod4" == '+' ]; then
        f_lib_debug "+++   libCfg.Debugging"
        v_LIB_mode_bDebugging=$v_LIB_bTrue
    fi

    if [ $v_LIB_bTrue == $v_LIB_mode_bDebugging ]; then
        echo "< L.configuration :: [$v_LIB_mode_bVerbose] !"
        echo "< L.iRc :: [$v_LIB_reply_iRc]"
        echo "< L.sRc :: [$v_LIB_reply_sRc]"
    fi

    #   export
    export v_LIB_mode_bColored
    export v_LIB_mode_bVerbose
    export v_LIB_mode_bDebugging
    export v_LIB_mode_bExtended

    return 1
}

#   ===========================================================================
#   m:  F.lib.color
#   ===========================================================================

#   s:  f.color.defineEscape

function f__color_defineEscapeCode() {

    #!URL   https://stackoverflow.com/questions/5947742/
    #               /how-to-change-the-output-color-of-echo-in-linux
    #   ansi colors
    #   Black        0;30     Dark Gray     1;30
    #   Red          0;31     Light Red     1;31
    #   Green        0;32     Light Green   1;32
    #   Brown/Orange 0;33     Yellow        1;33
    #   Blue         0;34     Light Blue    1;34
    #   Purple       0;35     Light Purple  1;35
    #   Cyan         0;36     Light Cyan    1;36
    #   Light Gray   0;37     White         1;37

    #   00:NONE
    v_LIB_COLOR_ESC_RESET='\e[0m'           #   RESET
    v_LIB_COLOR_ESC_NONE='\033[0m'          #   no color or RESET

    #   foreground:a:'regular'
    v_LIB_COLOR_ESC_FG_R_black='\033[0;30m'
    v_LIB_COLOR_ESC_FG_R_red='\033[0;31m'
    v_LIB_COLOR_ESC_FG_R_green='\033[0;32m'
    v_LIB_COLOR_ESC_FG_R_yellow='\033[0;33m'    #   * brown
    v_LIB_COLOR_ESC_FG_R_blue='\033[0;34m'
    v_LIB_COLOR_ESC_FG_R_magenta='\033[0;35m'
    v_LIB_COLOR_ESC_FG_R_cyan='\033[0;36m'
    v_LIB_COLOR_ESC_FG_R_gray='\033[0;37m'

    #   foreground:b:'bold'
    v_LIB_COLOR_ESC_FG_B_gray='\033[1;30m'
    v_LIB_COLOR_ESC_FG_B_red='\033[1;31m'
    v_LIB_COLOR_ESC_FG_B_green='\033[1;32m'
    v_LIB_COLOR_ESC_FG_B_yellow='\033[1;33m'
    v_LIB_COLOR_ESC_FG_B_blue='\033[1;34m'
    v_LIB_COLOR_ESC_FG_B_purple='\033[1;35m'
    v_LIB_COLOR_ESC_FG_B_cyan='\033[1;36m'
    v_LIB_COLOR_ESC_FG_B_white='\033[1;37m'

    #   background:d:'dark'
    v_LIB_COLOR_ESC_BG_D_black='\033[40m'       # Black
    v_LIB_COLOR_ESC_BG_D_red='\033[41m'         # Red
    v_LIB_COLOR_ESC_BG_D_green='\033[42m'       # Green
    v_LIB_COLOR_ESC_BG_D_yellow='\033[43m'      # Yellow
    v_LIB_COLOR_ESC_BG_D_blue='\033[44m'        # Blue
    v_LIB_COLOR_ESC_BG_D_magenta='\033[45m'      # Purple
    v_LIB_COLOR_ESC_BG_D_cyan='\033[46m'        # Cyan
    v_LIB_COLOR_ESC_BG_D_white='\033[47m'       # White

    #   background:l':light
    v_LIB_COLOR_ESC_BG_L_black='\033[1;30m'     # Black
    v_LIB_COLOR_ESC_BG_L_red='\033[1;31m'       # Red
    v_LIB_COLOR_ESC_BG_L_green='\033[1;32m'     # Bold.Green
    v_LIB_COLOR_ESC_BG_L_yellow='\033[1;33m'    # Yellow
    v_LIB_COLOR_ESC_BG_L_blue='\033[1;34m'      # Blue
    v_LIB_COLOR_ESC_BG_L_magenta='\033[1;35m'   # Purple
    v_LIB_COLOR_ESC_BG_L_cyan='\033[1;36m'      # Cyan
    v_LIB_COLOR_ESC_BG_L_white='\033[1;37m'     # White

    #   Underline
    v_LIB_COLOR_ESC_UL_Z_black='\033[4;30m'     # Black
    v_LIB_COLOR_ESC_UL_Z_red='\033[4;31m'       # Red
    v_LIB_COLOR_ESC_UL_Z_green='\033[4;32m'     # Underline.Green
    v_LIB_COLOR_ESC_UL_Z_yellow='\033[4;33m'    # Yellow
    v_LIB_COLOR_ESC_UL_Z_blue='\033[4;34m'      # Blue
    v_LIB_COLOR_ESC_UL_Z_magenta='\033[4;35m'   # Purple
    v_LIB_COLOR_ESC_UL_Z_cyan='\033[4;36m'      # Cyan
    v_LIB_COLOR_ESC_UL_Z_white='\033[4;37m'     # White
}

#   s:  f.color.defineFontValue

function f__color_defineFontValue() {

    #   standard
    v_LIB_COLOR_VID_none=-1
    v_LIB_COLOR_VID_black=0
    v_LIB_COLOR_VID_gray=8

    #   dark
    v_LIB_COLOR_VID_DK_red=1
    v_LIB_COLOR_VID_DK_green=2
    v_LIB_COLOR_VID_DK_yellow=3   # olive
    v_LIB_COLOR_VID_DK_blue=4
    v_LIB_COLOR_VID_DK_magenta=5
    v_LIB_COLOR_VID_DK_cyan=6
    v_LIB_COLOR_VID_DK_white=7

    #   light
    v_LIB_COLOR_VID_LH_red=9
    v_LIB_COLOR_VID_LH_green=10
    v_LIB_COLOR_VID_LH_yellow=11
    v_LIB_COLOR_VID_LH_blue=12
    v_LIB_COLOR_VID_LH_magenta=13
    v_LIB_COLOR_VID_LH_cyan=14
    v_LIB_COLOR_VID_LH_white=15
}

#   s:  f.color.configure

function f__color_configure() {

    #   handle color
    local iEnvId=$v_ENV__id
    local bColor=false

    if [ -z $iEnvId ] ; then
        bColor=true
    elif [ $iEnvId -ne 3 ] && [ $iEnvId -ne 9 ] ; then
        bColor=true
    fi

    #   map best colors
    if [ $bColor ] ; then
        v_LIB_color__none=$v_LIB_COLOR_VID_none
        v_LIB_color__black=$v_LIB_COLOR_VID_black
        v_LIB_color__red=$v_LIB_COLOR_VID_DK_red
        v_LIB_color__green=$v_LIB_COLOR_VID_DK_green
        v_LIB_color__yellow=$v_LIB_COLOR_VID_LH_yellow
        v_LIB_color__blue=$v_LIB_COLOR_VID_LH_blue
        v_LIB_color__magenta=$v_LIB_COLOR_VID_LH_magenta
        v_LIB_color__cyan=$v_LIB_COLOR_VID_LH_cyan
        v_LIB_color__gray=$v_LIB_COLOR_VID_gray
        v_LIB_color__white=$v_LIB_COLOR_VID_LH_white
    fi

}

#   s:  f.color.test

function f__color_test() {

    printf "\n>>> colorTest::begin \n"

    declare -x x=$v_LIB_COLOR_ESC_RESET

    #   font
    f__puts "\n+   colorTest.font"
    f__puts "1:black"   $v_LIB_color__black
    f__puts "2:green"   $v_LIB_color__green
    f__puts "3:yellow"  $v_LIB_color__yellow
    f__puts "4:blue"    $v_LIB_color__blue
    f__puts "5:magenta" $v_LIB_color__magenta
    f__puts "6:cyan"    $v_LIB_color__cyan
    f__puts "7:white"   $v_LIB_color__white
    f__puts "8:gray"    $v_LIB_color__gray


    #   foreground
    f__puts "\n+   colorTest.foreground.FG"

    echo -e "1: $v_LIB_COLOR_ESC_FG_R_black<rBlack>     $v_LIB_COLOR_ESC_FG_B_black<bBlack>"
    echo -e "2: $v_LIB_COLOR_ESC_FG_R_red<rRed>         $v_LIB_COLOR_ESC_FG_B_red<bRed>"
    echo -e "3: $v_LIB_COLOR_ESC_FG_R_green<rGreen>     $v_LIB_COLOR_ESC_FG_B_green<bGreen>"
    echo -e "4: $v_LIB_COLOR_ESC_FG_R_yellow<rYellow>   $v_LIB_COLOR_ESC_FG_B_yellow<bYellow>"
    echo -e "5: $v_LIB_COLOR_ESC_FG_R_blue<rBlue>       $v_LIB_COLOR_ESC_FG_B_blue<bBlue>"
    echo -e "6: $v_LIB_COLOR_ESC_FG_R_magenta<rMagenta> $v_LIB_COLOR_ESC_FG_B_magenta<bMagenta>"
    echo -e "7: $v_LIB_COLOR_ESC_FG_R_cyan<rCyan>       $v_LIB_COLOR_ESC_FG_B_cyan<bCyan>"
    echo -e "8: $v_LIB_COLOR_ESC_FG_R_gray<rGray>       $v_LIB_COLOR_ESC_FG_B_gray<bGray>"
    echo -e "$v_LIB_COLOR_ESC_RESET"

    #   background
    f__puts "\n+   colorTest.background.BG"

    echo -e "1: $v_LIB_COLOR_ESC_BG_D_black<dBlack>$x $v_LIB_COLOR_ESC_BG_L_black<lBlack>$x"
    echo -e "2: $v_LIB_COLOR_ESC_BG_D_red<dRed>$x $v_LIB_COLOR_ESC_BG_L_red<lRed>$x"
    echo -e "3: $v_LIB_COLOR_ESC_BG_D_green<dGreen>$x $v_LIB_COLOR_ESC_BG_L_green<lGreen>$x"
    echo -e "4: $v_LIB_COLOR_ESC_BG_D_yellow<dYellow>$x   $v_LIB_COLOR_ESC_BG_L_green<lYellow>$x"
    echo -e "5: $v_LIB_COLOR_ESC_BG_D_blue<dBlue>$x       $v_LIB_COLOR_ESC_BG_L_blue<lBlue>$x"
    echo -e "6: $v_LIB_COLOR_ESC_BG_D_magenta<dMagenta>$x $v_LIB_COLOR_ESC_BG_L_magenta<lMagenta>$x"
    echo -e "7: $v_LIB_COLOR_ESC_BG_D_cyan<dCyan>$x       $v_LIB_COLOR_ESC_BG_L_cyan<lCyan>$x"
    echo -e "8: $v_LIB_COLOR_ESC_BG_D_gray<dGray>$x       $v_LIB_COLOR_ESC_BG_L_gray<lGray>$x"

    #   underline
    f__puts "\n+   colorTest.underline"

    echo -e "1: $v_LIB_COLOR_ESC_UL_Z_black<zBlack>$x"
    echo -e "2: $v_LIB_COLOR_ESC_UL_Z_red<zRed>$x"
    echo -e "3: $v_LIB_COLOR_ESC_UL_Z_green<zGreen>$x"
    echo -e "4: $v_LIB_COLOR_ESC_UL_Z_yellow<zYellow>$x"
    echo -e "5: $v_LIB_COLOR_ESC_UL_Z_magenta<zMagenta>$x"
    echo -e "6: $v_LIB_COLOR_ESC_UL_Z_cyan<zCyan>$x"
    echo -e "7: $v_LIB_COLOR_ESC_UL_Z_white<zWhite>$x"

    #   eof.test
    f__puts "\n- colorTest::finished."

}


#   ===========================================================================
#   m:  F.lib.helper
