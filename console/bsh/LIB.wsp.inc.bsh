declare -i v_LIB_reply_bRc=$v_LIB_bFalse
declare -i v_LIB_reply_iRc=-19
declare -x v_LIB_reply_sRc='?None'
declare -i v_LIB_reply_iEc=61
#
#   #   array
declare v_LIB_reply_aRc=()
#
#   #   m:  v.timer
