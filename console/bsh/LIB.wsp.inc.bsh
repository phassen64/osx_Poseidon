#   s:  f.info
function f_lib_info() {
    local p=$BASH_SOURCE
    local s
    s=$(stat -c %y% $p)
    echo "<  L.sLib.DTM :: [$s]"
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

#   s:  f.who
function f_lib_who() {
    local p_pBash=${BASH_SOURCE[1]}     #   caller.bscp
    local l_sPwd=`pwd`
    local l_sPth=$l_sPwd/$p_pBash
    #   show
    printf "< L.who.srce    '%s'\n"  $p_pBash
    printf "< L.who.sDir    '%s'\n"  $l_sPwd
    printf "< L.who.sPth    '%s'\n"  $l_sPth
}

#   s:  f.where
function f_lib_where() {
    local p_pBash=${BASH_SOURCE[1]}     #   caller.bscp
    local p_iLine=${BASH_LINENO[0]}     #   caller.lineNo
    local p_sFctn=${FUNCNAME[0]}        #   caller.fctn
    #   show
    printf "< L.where.srce  '%s'\n"  $p_pBash
    printf "< L.where.line  '%s'\n"  $p_iLine
    printf "< L.where.fctn  '%s'\n"  $p_sFctn
}

#   s:  f.caller            replies: $< { this() main() }
function f_lib_caller() {
    declare -i i
    declare -i n=${#FUNCNAME[@]}
    declare -x s=''
    printf "< found '%d' caller\n" $n
    for (( i=0; i<$n; i++ )); do
        s=${FUNCNAME[$i]}
        printf "caller[%d] : '%s' \n"  $i $s
    done
}

#   s:  f.dateTime
function f_lib_dateTime() {
    local l_sDtm=$(date $v_LIB_dtmFormatString_now)
    local s
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.dateTime :: [$l_sDtm]"
    fi
    s=$l_sDtm
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

#   s:  f.sleep
function f_lib_sleep() {
    local i=$1
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.sleep :: [$i]"
    fi
    sleep $i
}

#   s:  f.random
function f_lib_random() {
    #   usage:
    #       $   f_lib_random        #   returns 1..100
    #       $   f_lib_random 5      #   returns 1..5
    declare -i p_iMax=$1
    if [ -z $1 ]; then
        p_iMax=100
    fi
    echo $(( (RANDOM % $p_iMax) + 1 ))
}


#   s:  f.randomMore
#   in: iMax [iMin]
function f_lib_randomMore() {

    declare -i p_iMax=$1     #   iRnd = [iMax...iMin]
    declare -i p_iMin=$2
    declare -i n
    declare -i i

    #   return if wrong input
    if [ $p_iMax -le 0 ]; then
        return 0
    fi

    #   calc random
    n=$RANDOM

    #   modulo
    i=$(( $n % $iMax ))         #  RANDOM() => 0...nMax-1

    #   add lower boundary
    let "i += $p_iMin"          #  MIN..MAX

    #   show
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.iMax      :: [$p_iMax]"
        echo "< L.iMin      :: [$p_iMin]"
        echo "< L.random    :: [$n]"
        echo "< L.iRnd      :: [$i]"
    fi

    return $i
}

#   ===========================================================================
#   m:  F.lib.converter
#   ===========================================================================

#   s:  f.converter.b2s
function f_lib_dataTypeConverter_b2s {
    if [ $v_LIB_bTrue == $1 ]; then
        v_LIB_reply_sRc="T R U E !"
    else
        v_LIB_reply_sRc="F A L S E ?"
    fi
    return 1
}

#   ===========================================================================
#   m:  F.lib.isPath
#   ===========================================================================

#   s:  f.isDirectory
function f_lib_isDirectory {
    if [ -d $1 ]; then
        return $v_LIB_bTrue
    else
        return $v_LIB_bFalse
    fi
}

#   s:  f.isFile
function f_lib_isFile {
    if [ -f $1 ]; then
        return $v_LIB_bTrue
    else
        return $v_LIB_bfalse
    fi
}

#   ===========================================================================
#   m:  F.lib.exprHelper
#   ===========================================================================


function f__echoExpr() {
    local p_sInfo=$1        #   ?isSpace
    local p_sExpr=$2        #   'p ter'
    local p_bRcVa=$3        #   100
    if [ $v_LIB_bTrue -eq  $p_bRcVa ]
        then sRc="TRUE"
        else sRc="FALSE"
    fi
    printf -v x "    %s('%s') \t=:\t[%s]" "$p_sInfo" "$p_sExpr" "$sRc"
    printf "%s\n" "$x"
    f__logs "$x"
}

#   ===========================================================================
#   m:  F.lib.isType
#   ===========================================================================


#   s:  f.isNumeric
function f_lib_isNumeric() {
    if [ $(echo $1 | egrep "^[0-9]+$") ]; then
        return $v_LIB_bTrue
    else
        return $v_LIB_bfalse
    fi
}

#   s:  f.isAlpha
function f_lib_isAlpha() {
    local bRc=$v_LIB_bFalse;
    if [ $(echo $1 | egrep "^[A-Za-z]+$") ]
    then bRc=$v_LIB_bTrue; fi
    return $bRc
}

#   s:  f.isAlnum
function f_lib_isAlnum() {
    local bRc=$v_LIB_bFalse;
    if [ $(echo $1 | egrep "^[A-Za-z0-9]+$") ]
    then bRc=$v_LIB_bTrue; fi
    return $bRc
}

#   s:  f.isHexNum
function f_lib_isHexnum() {
    local bRc=$v_LIB_bFalse;
    if [ $(echo $1 | egrep "^[{a-f}{0-9}{A-F}]+$") ]
    then bRc=$v_LIB_bTrue; fi
    return $bRc
}

#   s:  f.isPunct
function f_lib_isPunct() {
    local bRc=$v_LIB_bFalse;
    if [ $(echo $1 | egrep "^[{\,}{\.}{\;}]+$") ]
    then bRc=$v_LIB_bTrue; fi
    return $bRc
}

#   s:  f.isUpper
function f_lib_isUpper() {
    local bRc=$v_LIB_bFalse;
    if [ $(echo $1 | egrep "^[A-Z]+$") ]
    then bRc=$v_LIB_bTrue; fi
    return $bRc
}

#   s:  f.isLower
function f_lib_isLower() {
    local bRc=$v_LIB_bFalse;
    if [ $(echo $1 | egrep "^[a-z]+$") ]
    then bRc=$v_LIB_bTrue; fi
    return $bRc
}

#   s:  f.isCntrl
function f_lib_isCntrl() {
    local bRc=$v_LIB_bFalse;
    if [[ "$1" =~ [[:cntrl:]] ]]
#   if [ $(echo $1 | egrep "[:cntrl]") ]
    then bRc=$v_LIB_bTrue; fi
    return $bRc
}

#   s:  f.isSpace
function f_lib_isSpace() {
    local bRc=$v_LIB_bFalse;
    if [[ "$1" =~ [[:space:]] ]]
    then bRc=$v_LIB_bTrue; fi
    return $bRc
}

#   ===========================================================================
#   m:  F.lib.print
#   ===========================================================================

#   s:  f.echo
function f_lib_echo() {
    local s=$1
    echo -E $s      #   no \t\n or EscapeChars
}

#   *   complete control but ESC inside the string - internal

#   s:  f.~~print
function f__print() {
    #   par1:   string to print
    #   par2:   bNewLine standard is FALSE
    #   par3:   foregroundColor_ID <integer>
    #   par4:   backgroundColor_ID <integer>
    local pStr=$1; local pNL=$2; local pFgd=$3; local pBgd=$4;
    #   number of parameters >= 1
    if [ $# == 0 ]; then
        return 0
    fi

    #   m:  v.boolType
    #   declare -i v_LIB_bTrue=100
    #   declare -i v_LIB_bFalse=199
    #   declare -i v_LIB_mode_bVerbose=1
    #   declare -i v_LIB_mode_bExtended=1
    declare -i v_LIB_mode_bColored=$v_LIB_bTrue
    #   declare -i v_LIB_mode_bDebugging=1

    #   set colors
    #   echo "setColor {$v_LIB_mode_bColored} "
    if [ $v_LIB_bTrue == $v_LIB_mode_bColored ]
    then
        if [ ! -z $pFgd ] && [ $pFgd -ne $v_LIB_COLOR_VID_none ]; then
            tput setaf $pFgd
        fi
        if [ ! -z $pBgd ] && [ $pBgd -ne $v_LIB_COLOR_VID_none ]; then
            tput setab $pBgd
        fi
    fi

    #   set NewLine
    if [ ! -z $pNL ] && [ $v_LIB_bTrue == "$pNL" ]; then
        echo -e $pStr $v_LIB_COLOR_ESC_NONE
    else
        echo -e -n $pStr $v_LIB_COLOR_ESC_NONE  # no NewLine
    fi
}

#   wrapper.print - no background option

#   s:  f.print
function f_lib_print() {
    f__print "$1" "$2" "$3" $v_LIB_COLOR_VID_none
}

#   s:  f.~~puts
function f__puts() {
    f__print "$1" "$v_LIB_bTrue" "$2"
}

#   ===========================================================================
#   m:  F.lib.fileInfo
#   ===========================================================================

#   in: filePath

#   s:  f.file.GetPath
function f_lib_file_getPath() {
    local p_sScp=$1
    local l_sPwd=`pwd`
    local s
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.pScp :: [$p_sScp]"
        echo "< L.sPwd :: [$l_sPwd]"
    fi
    s=$l_sPwd/$p_sScp
    v_LIB_reply_sRc=$s
    return ${#s}        # reply strlen
}

#   s:  f.file.GetName
function f_lib_file_getName()   {
    local p=$1
    local s
    s=$(basename ${p})      #   extract filePath
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.fileGetName =: [$s]"
    fi
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

#   s:  f.file.GetBody
function f_lib_file_getBody()   {
    local p=$1
    local s
    #   echo "::filePath($p)"
    s=$(basename ${p})  # baseName
    s=$(echo "$s" | sed -e 's/\.[^.]*$//')  # fileBody
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

#   s:  f.file.GetExtension
function f_lib_file_getExtension()   {
    local p=$1
    local s
    #   echo "::filePath($p)"
    # Source - https://stackoverflow.com/a/965072
    s=$(basename ${p})  # baseName
    s="${s##*.}"
    s=.$s
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

#   s:  f.file.GetModificationTime
function f_lib_file_getModificationTime()   {
    #   $  stat --help | grep "time of"
    #   %w   time of file birth, human-readable; - if unknown
    #   %x   time of last access, human-readabl
    #   %X   time of last access, seconds since Epoch
    #   %y   time of last data modification, human-readable
    #   %Y   time of last data modification, seconds since Epoch
    #   %z   time of last status change, human-readable
    #   %Z   time of last status change, seconds since Epoch
    local p=$1
    local s
    s=$(stat -c %y% $p)
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

#   ===========================================================================
#   m:  F.lib.fileHandling
#   ===========================================================================

#   s:  f.~~fputs
function f__fputs()   {
    local p_pFile=$1
    local p_sString=$2
    local p_bCreate=$3
    #   create or append
    if [ ! -z $p_bCreate ] && [ $v_LIB_bTrue -eq $p_bCreate ]; then
        echo "$p_sString" > $p_pFile
    else
        echo "$p_sString" >> $p_pFile
    fi
    return ${#p_sString}    # reply strlen
}

#   s:  f.file.write < wrapper() >
function f_lib_file_write()   {
    local p_pFile=$1
    local p_sString=$2
    local p_bCreate=$3
    echo "--- L.fileWrite:[$v_LIB_mode_bVerbose]"
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "+++ fileWrite"
        echo "< L.pFpt :: [$p_pFile]"
        echo "< L.sStr :: [$p_sString]"
        echo "< L.bCrt :: [$p_bCreate]"
    fi
    #   run internal
    #   f__fputs $p_pFile "$p_sString" $p_bCreate; iRc=$?
    f__fputs $p_pFile "$p_sString" "100"; iRc=$?
    return $iRc
}

#   ===========================================================================
#   m:  F.lib.logging
#   ===========================================================================

#   s:  f.~~logs
#   log string create||append
function f__logs() {
    local p_sString=$1      # String
    local p_bCreate=$2
    #   check
    if [ $v_LIB_bTrue -ne $v_LIB_log_bEnabled ]; then
        return 0
    fi
    #   run internal
    f__fputs $v_LIB_log_pFile "$p_sString" $p_bCreate; iRc=$?
    return $iRc
}

#   s:  f.log.determineFilePath
function f__log_determineFilePath() {

    #   filePath
    local p_pSrc=$1         #   source  sFilePath
    local p_dObj=$2         #   object  sDir
    local p_bDtm=$3         #   appendix bDateTimeString request is True

    #   me
    local sFct=${FUNCNAME[0]}

     #   show
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< +++ L.determinePath"
        echo "< L.p1:: [$1]"
        echo "< L.p2:: [$2]"
        echo "< L.p3:: [$3]"
    fi

    #   check.srcPth
    if [ ! -f $p_pSrc ]; then
        echo "? p1:[$p_pSrc] at:[$sFct;$LINENO]"
        exit
    fi
    #   check.objDir
    if [ ! -d $p_dObj ]; then
        echo "? p2:[$p_dObj] at:[$sFct;$LINENO]"
        exit
    fi

    #   getFileName and getFileBody
    s=$(basename ${p_pSrc})
    s=$(echo "$s" | sed -e 's/\.[^.]*$//')  # body

    #   logging with dateTime?
    if [ $v_LIB_bTrue  == $p_bDtm ]; then
        local l_sFmt=$v_LIB_dtmFormatString_now
        local l_sDtm=$(date $l_sFmt)
        s+='_'
        s+=$l_sDtm
        echo "< L.sDtm :: [$s]"
    fi

    #   concat
    s="$p_dObj/$s"
    s+=$v_LIB_log_sFileExtension

    #   reply
    v_LIB_reply_sRc=$s
    return ${#s}        # reply strlen
}

#   s:  f.log.GetPath < wrapper() >
function f_lib_logging_getPath() {
    f__log_determineFilePath "$1" "$2" "$3"; iRc=$?
     #   show
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< +++ L.loggingGetPath"
        echo "< L.p1:: [$1]"
        echo "< L.p2:: [$2]"
        echo "< L.p3:: [$3]"
    fi
    return $iRc
}

#   ===========================================================================
#   m:  F.lib.plgs (print & log)
#   ===========================================================================

#   s:  f.~~plgs
function f__plgs() {
    f__puts "$1" "$2"
    #   remove tabs & newLine of $1 before logging
    x=$(printf "%b\n" "$1")
    f__logs "$x"
    return 1
}

#   s:  f.lib.puts  < wrapper() >
function f_lib_puts() {
    f__plgs "$1" "$2"
}

#   s:  f.lib.text
function f_lib_text() {
    local t=$1
    local c=$2
    printf "    %s\n" "$t"  #   print directly
    f__logs "$t" "$c"
}

#   ===========================================================================
#   m:  F.lib.menu
#   ===========================================================================

#   s:  f.header
function f_lib_header() {

    #   reply rc
    local p_iReply=$1     #   lib headerRc

    #   bash stack variables
    local p_pBash=${BASH_SOURCE[1]}     #   caller.bscp
    local p_iLine=${BASH_LINENO[0]}     #   caller.lineNo
    local p_sFctn=${FUNCNAME[0]}        #   caller.fctn

    #   ${BASH_LINENO[0]}

    local l_sNow=$(date $v_LIB_dtmFormatString_now)
    local -x s
    local -x sHeaderText

    #   save replyCode
    v_LIB_reply_iEc=$p_iReply

    #   show header
    sHeaderText="=== hdr:[$p_pBash;$p_iLine]:[$l_sNow]:[$v_LIB_reply_iEc]."
    f__puts "$sHeaderText\n " $v_LIB_color__green

    #   time.Start
    v_LIB_timer_tStart=$(date +%s.%N)

    #   show
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.pScp :: [$p_pBash]"
        echo "< L.iPos :: [$p_iLine]"
        echo "< L.dFct :: [$p_sFctn]"
        echo "< L.iEc  :: [$v_LIB_reply_iEc]"
        echo "< L.tDtm.start :: [$v_LIB_timer_tStart]"
    fi

    #   get logFileName
    local sScp=$p_pBash
    local sDir=$v_LIB_dirScratch
    local bMod=$v_LIB_log_bUseDtmName      # dtmString?
    f__log_determineFilePath $sScp $sDir $bMod; iRc=$?

    #   save reply
    v_LIB_log_bEnabled=$v_LIB_bTrue
    v_LIB_log_pFile=$v_LIB_reply_sRc

    #   show
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.sLogFile  :: [$v_LIB_log_pFile]"
        echo "< L.iRc       :: [$iRc]"
    fi

    #   create+write into myLogFile
    s="--- automaticall created by:'$p_sScp'."
    f__logs "$s" $v_LIB_bTrue

    #   create+write into myLogFile
    s=$sHeaderText
    f__logs "$s"

    #   return
    return $v_LIB_reply_iEc
}


#   s:  f.footer
function f_lib_footer() {

    #   fetch parameter
    local p_iReply=$1     #   current.footer.Rc

    #   bash stack variables
    local p_pBash=${BASH_SOURCE[1]}     #   caller.bscp
    local p_iLine=${BASH_LINENO[0]}     #   caller.lineNo
    local p_sFctn=${FUNCNAME[0]}        #   caller.fctn

    #   time.Stop
    v_LIB_timer_tStopp=$(date +%s.%N)

    #   show
    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.pScp :: [$p_pBash]"
        echo "< L.iPos :: [$p_iLine]"
        echo "< L.lFct :: [$p_sFctn]"
        echo "< L.iRc  :: [$p_iReply]"
        echo "< L.iEc  :: [$v_LIB_reply_iEc]"
        echo "< L.tDtm.stopp :: [$v_LIB_timer_tStopp]"
    fi

    #   diff time
    local fDiff=$(echo "($v_LIB_timer_tStopp-$v_LIB_timer_tStart) / 1" | bc)
    local sSec=$(echo $fDiff)

    #   show logFile
    s=$v_LIB_log_pFile
    f__puts "\n+++ logged into:'$s'." $v_LIB_color__blue

    #   create+write into myLogFile
    local iRc=$v_LIB_reply_iEc
    s="=== ftr:[$p_pBash;$p_iLine]:[$iRc] elapsed:<$sSec> seconds."
    f__puts "\n$s" $v_LIB_color__green
    f__logs "$s"

    #   return
    return $v_LIB_reply_iEc
}

#   s:  f.menu.M
function f_lib_menu() {
    local p_sText=$1
    local p_pBash=${BASH_SOURCE[1]}     # stack.caller
    local p_iLine=${BASH_LINENO[0]}     # stack.lineNo
    v_LIB_menuS0_iCtr+=1
    v_LIB_menuS1_iCtr=0
    v_LIB_menuS2_iCtr=0
    printf -v x "[%2.2d]" "$v_LIB_menuS0_iCtr"
    s="=== m:$x:'$p_sText' at:[$p_pBash;$p_iLine]"
    f__puts "\n$s" $v_LIB_color__green
    f__logs "$s"
}

#   s:  f.menu.S1
function f_lib_menuS1() {
    local p_sText=$1
    local p_iLine=${BASH_LINENO[0]}     # stack.lineNo
    v_LIB_menuS1_iCtr+=1
    v_LIB_menuS2_iCtr=0
    printf -v x "[%2.2d.%2.2d]" "$v_LIB_menuS0_iCtr" "$v_LIB_menuS1_iCtr"
    s="=== s:$x:'$p_sText' at:[$p_iLine]"
    f__puts "\n$s" $v_LIB_color__green
    f__logs "$s"
}

#   s:  f.menu.S2
function f_lib_menuS2() {
    local p_sText=$1
    local p_iLine=${BASH_LINENO[0]}     # stack.lineNo
    v_LIB_menuS2_iCtr+=1
    printf -v x "[%2.2d.%2.2d.%2.2d]"\
        "$v_LIB_menuS0_iCtr"  "$v_LIB_menuS1_iCtr" "$v_LIB_menuS2_iCtr"
    s="=== u:$x:'$p_sText' at:[$p_iLine]"
    f__puts "\n$s" $v_LIB_color__green
    f__logs "$s"
}


#   s:  f.debug.Trace(sFct,iLine,sText,[bEnabled=true])
function f_lib_trace()   {

    #   fetch
    local p_sText="$1"
    local p_bFlag="$2"
    local p_iLine=${BASH_LINENO[0]}     #   stack.lineNo
    local p_sFctn=${FUNCNAME[1]}        #   stack.fctn

    #   check flag (empty || true)
    if [ -z $p_bFlag ]; then
        p_bFlag=$v_LIB_bTrue
    elif [ $p_bFlag != $v_LIB_bTrue ]; then
        return 0    # no
    fi

    if [ $v_LIB_bTrue == $v_LIB_mode_bVerbose ]; then
        echo "< L.sFct :: [$p_sFctn]"
    fi

    #   prepare text
    local s="--- T:[$p_sFctn;$p_iLine]:'$p_sText'"

    #   show
    f__puts "$s" $v_LIB_color__magenta
    f__logs "$s"

}


#   s:  f.lib.debug
function f_lib_debug() {
    if [ $v_LIB_bTrue ==  $v_LIB_mode_bDebugging ]; then
        printf "=== debugString : [%s]\n" $1
    fi
}

#   ===========================================================================
#   m:  F.lib.test
#   ===========================================================================

function f_lib_test() {
    f__puts "+++ libTest.begin" $v_LIB_color__blue
    f__print "\t"
    f__print "1:red."        $v_LIB_bFalse   $v_LIB_color__red
    f__print "2:yellow."     $v_LIB_bFalse   $v_LIB_color__yellow
    f__print "3:green."      $v_LIB_bFalse   $v_LIB_color__green
    f__print "4:blue."       $v_LIB_bFalse   $v_LIB_color__blue
    f__print "5:magenta."    $v_LIB_bFalse   $v_LIB_color__magenta
    f__print "6:cyan."       $v_LIB_bTrue    $v_LIB_color__cyan
    f__puts "+++ libTest.ending" $v_LIB_color__blue
    #   test
    f__color_test
}

