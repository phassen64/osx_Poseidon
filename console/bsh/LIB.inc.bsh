#   ===========================================================================
#   *** m:  helper color
#   ===========================================================================


#
#   =*= f:  color.setId
#

function f__color_setId() {

#   handle color
    local iEnvId=$v_ENV__id
    local bColor=false

    #   standard
    v_COL_ID_none=-1
    v_COL_ID_black=0
    v_COL_ID_gray=8
#   dark
    v_COL_ID_red=1
    v_COL_ID_green=2
    v_COL_ID_yellow=3   # olive
    v_COL_ID_blue=4
    v_COL_ID_magenta=5
    v_COL_ID_cyan=6
    v_COL_ID_white=7
#   light - not for RPi
    v_COL_ID_Lred=9
    v_COL_ID_Lgreen=10
    v_COL_ID_Lyellow=11
    v_COL_ID_Lblue=12
    v_COL_ID_Lmagenta=13
    v_COL_ID_Lcyan=14
    v_COL_ID_Lwhite=15
#   RPi/GIT redefine...?

    if [ -z $iEnvId ] ; then
        bColor=true
    elif [ $iEnvId -ne 3 ] && [ $iEnvId -ne 9 ] ; then
        bColor=true
    fi

    if [ $bColor ] ; then
        v_COL_ID_red=$v_COL_ID_Lred
        v_COL_ID_green=$v_COL_ID_Lgreen
        v_COL_ID_yellow=$v_COL_ID_Lyellow
        v_COL_ID_blue=$v_COL_ID_Lblue
        v_COL_ID_magenta=$v_COL_ID_Lmagenta
        v_COL_ID_cyan=$v_COL_ID_Lcyan
        v_COL_ID_white=$v_COL_ID_Lwhite
    fi
}

#
#   =*= f:  color.setCode
#

function f__color_setCode() {

    #!URL   https://stackoverflow.com/questions/5947742/
    #               /how-to-change-the-output-color-of-echo-in-linux
    #   ansi colors
    #   Black        0;30     Dark Gray     1;30
    #   Red          0;31     Light Red     1;31
    #   Green        0;32     Light Green   1;32
    #   Brown/Orange 0;33     Yellow        1;33
    #   Blue         0;34     Light Blue    1;34
    #   Purple       0;35     Light Purple  1;35
    #   Cyan         0;36     Light Cyan    1;36
    #   Light Gray   0;37     White         1;37

    #   00:NONE
    v_COL_NONE='\033[0m'              #   no color or RESET

    #   Foreground: '0'
    v_COL_FG_black='\033[0;30m'
    v_COL_FG_red='\033[0;31m'
    v_COL_FG_green='\033[0;32m'
    v_COL_FG_brown='\033[0;33m'
    v_COL_FG_blue='\033[0;34m'
    v_COL_FG_magenta='\033[0;35m'
    v_COL_FG_cyan='\033[0;36m'
    v_COL_FG_Lgray='\033[0;37m'

    #   Foreground 01:class '1'
    v_COL_FG_gray='\033[1;30m'
    v_COL_FG_Lred='\033[1;31m'
    v_COL_FG_Lgreen='\033[1;32m'
    v_COL_FG_yellow='\033[1;33m'
    v_COL_FG_Lblue='\033[1;34m'
    v_COL_FG_Lpurple='\033[1;35m'
    v_COL_FG_Lcyan='\033[1;36m'
    v_COL_FG_white='\033[1;37m'

    #   Background
    v_COL_BG_black='\033[40m'       # Black
    v_COL_BG_red='\033[41m'         # Red
    v_COL_BG_green='\033[42m'       # Green
    v_COL_BG_yellow='\033[43m'      # Yellow
    v_COL_BG_blue='\033[44m'        # Blue
    v_COL_BG_magenta='\033[45m'      # Purple
    v_COL_BG_cyan='\033[46m'        # Cyan
    v_COL_BG_white='\033[47m'       # White

    # Bold
    v_COL_BD_black='\033[1;30m'       # Black
    v_COL_BD_red='\033[1;31m'         # Red
    v_COL_BD_green='\033[1;32m'       # Bold.Green
    v_COL_BD_yellow='\033[1;33m'      # Yellow
    v_COL_BD_blue='\033[1;34m'        # Blue
    v_COL_BD_magenta='\033[1;35m'      # Purple
    v_COL_BD_cyan='\033[1;36m'        # Cyan
    v_COL_BD_white='\033[1;37m'       # White

    # Underline
    v_COL_UL_black='\033[4;30m'       # Black
    v_COL_UL_red='\033[4;31m'         # Red
    v_COL_UL_green='\033[4;32m'       # Underline.Green
    v_COL_UL_yellow='\033[4;33m'      # Yellow
    v_COL_UL_blue='\033[4;34m'        # Blue
    v_COL_UL_magenta='\033[4;35m'      # Purple
    v_COL_UL_cyan='\033[4;36m'        # Cyan
    v_COL_UL_white='\033[4;37m'       # White

}

#   ===========================================================================
#   *** m:  helper print
#   ===========================================================================

#
#   =*= f:  print   : colored printing - no logging
#

function f__print() {
    #   par1:   string to print
    #   par2:   foregroundColor_ID <integer>
    #   par3:   backgroundColor_ID <integer>
    #   par4:   NewLine  '!CRQ-200825:STANDARD is noFF
    local pStr=$1; local pNL=$2; local pFgd=$3; local pBgd=$4;
    #   set colors
    if [ ! -z $pFgd ] && [ $pFgd -ne $v_COL_ID_none ]; then
        tput setaf $pFgd
    fi
    if [ ! -z $pBgd ] && [ $pBgd -ne $v_COL_ID_none ]; then
        tput setab $pBgd
    fi
    #   set NewLine
    if [ ! -z $pNL ] && [ "$pNL" == 1 ]; then
        echo -e $pStr $v_COL_NONE
    else
        echo -e -n $pStr $v_COL_NONE
    fi
}

#
#   =*= f:  puts    : colored printing - no logging
#

function f__puts() {
    #   pFgd:foregroundColor_ID
    #   pBgd:backgroundColor_ID <integer>
    local pStr=$1; local pFgd=$2; local pBgd=$3
    f__print "$pStr" 1 $pFgd $pBgd      # always with NL
}

#
#   =*= f:  logging
#

function f__logs() {
    #   $1: string
    #   $2: new logFileName
    #   $3: create==TRUE else ignore and no logging
    local sStr=$1
    local sFile=$2
    local bCrt=$3
    declare -i i
    declare -i iLen=5    # minimal fileName length "p.log"
    declare -x s

    #   echo "f.doLogging of [$#]"

    case $# in

        1)
            #   echo "logMode ==1"
            if [ "$v_sLogfile" == "" ]; then
                f__puts "?logfile 'v_sLogfile' undefined.:[$LINENO]" $v_COL_ID_red
                return
            fi

            #   append text into logfile
            #   !CRQ-260930:remove else chars
            s=$(echo $sStr | tr -cd [:print:])
            echo "$s" >> $v_sLogfile

            bCrt=$v_FALSE;;
        2)
            #   echo "logMode ==2"
            return $LINENO;;

        3)
            #   echo "logMode ==3"
            #   =*= check fileName length
            i=${#sFile}

            if [ $i -lt $iLen ]; then
                echo "??? : too small logFileNname"
                return $LINENO
            fi

            #   =*= creation flag
            if [ $bCrt != $v_TRUE ]; then
                return $LINENO
            fi

            #   =*= save new logfile name
            sFile=`basename $sFile`
            v_sLogfile=$v_FWK_dirScratch/$sFile
            echo "--- logFile.new ={$v_sLogfile}"

            #   =*= create new logfile
            echo "!L: =*= create logfile:$v_sLogfile"

            #   perform create
            echo -E "$sStr" > $v_sLogfile;;

        *)
            echo "logMode ==default"
            return $LINENO;;
    esac
    return 0

}   #f~~logs

#
#   =*= f:  output
#

function f__output() {
    #   combine ~puts and ~logs
    local s=$1; local pFgd=$2
    f__puts "$s" $pFgd
    if [ "$v_sLogfile" != "" ]; then
        f__logs "$s"
    fi
}

#
#   =*= f:  show - removed
#

#
#   =*= f:  trace
#

function f__trace() {
    #   lineno shows relative lineNumber to function start
    local sFct=$1; local iLine=$2; local sStr=$3; local bTrc=$4; local bLog=$5
    #   echo "bTrc==<$bTrc>; bLog==<$bLog>"
    #   echo "sFct:<$sFct> iLin:<$iLine> sStr:<$sStr> bTrc:<$bTrc> bLog:<$bLog>"

    #   check: numeric body => first parameter is numeric ?
    local bRc=$v_FALSE
    if [ $(echo $1 | egrep "^[0-9]+$") ]
    then bRc=$v_TRUE; fi
    if [ $bRc == $v_TRUE ]; then
        sFct="Body"
        iLine=$1
        sStr=$2
        bTrc=$3
        bLog=$4
    fi

    #   empty input?
    if [ -z $bTrc ]; then
        bTrc=$v_TRUE
    fi
    if [ -z $bLog ]; then
        bLog=$v_FALSE
    fi

    n=$#
    #   echo "bTrc==<$bTrc>; vTrue==<$v_TRUE>; vFalse==<$v_FALSE>"
    #   echo "n:=:<$n>"
    s="--- T:[$sFct;$iLine]:$sStr"
    if [ $# -lt 3 ]; then
        f__puts "??? f~Trace: <=4" $v_COL_ID_red
        return
    elif [ $bTrc == $v_TRUE ] ||  [ $v_bTrace == $v_TRUE ] ; then
        f__puts "$s" $v_COL_ID_magenta
    fi
    if [ $# -lt 5 ]; then
        return
    elif [ $bLog == $v_TRUE ] ; then
        f__logs "$sStr"
    fi
}


#   ===========================================================================
#   *** m:  console
#   ===========================================================================

#
#   =*= f:  terminal
#

function f_lib_term() {
    local iTerm=$1
    if [ -z $iTerm ]; then
        iTerm=1
    fi
    if [ $iTerm == 1 ]; then
        export TERM=xterm-256color
    else
        export TERM=xterm-mono
    fi
    echo "+ TERMINAL:<$TERM>"
}

#
#   =*= f:  screen
#

function f_lib_screen_clear() {
    #   clear only, if no scp arg
    if [ "$1" == "" ]; then
        clear && echo -en "\e[3J"
    fi
}

#
#   =*= f:  color.Init
#

function f_lib_colorInit() {
    f__trace ${FUNCNAME[0]} $LINENO "start" $v_bTrace
    f__color_setId
    f__trace ${FUNCNAME[0]} $LINENO "code" $v_bTrace
    f__color_setCode
}

#
#   =*= f:  color.Test
#

function f_lib_colorTest() {

    #   standard
    echo "echo foreground test...."; sleep 1

    echo -e "TEST 1: $v_COL_FG_gray<Gray> $v_COL_FG_Lgray<LGray>"
    echo -e "TEST 2: $v_COL_FG_red<Red> $v_COL_FG_Lred<LRed>"
    echo -e "TEST 3: $v_COL_FG_green<Green> $v_COL_FG_Lgreen<LGreen>"
    echo -e "TEST 4: $v_COL_FG_brown<Brown> $v_COL_FG_yellow<Yellow>"
    echo -e "TEST 5: $v_COL_FG_blue<Blue> $v_COL_FG_Lblue<LBlue>"
    echo -e "TEST 6: $v_COL_FG_magenta<Purple> $v_COL_FG_Lpurple<LPurple>"
    echo -e "TEST 7: $v_COL_FG_cyan<Cyan> $v_COL_FG_Lcyan<LCyan>"
    echo -e "TEST 8: $v_COL_FG_black<Black> $v_COL_FG_white<white>"
    echo -e "TEST 9:  $v_COL_BD_green<bGreen> $v_COL_NON +  $v_COL_BD_magenta<bPurple>"
    echo -e "TEST 10: $v_COL_UL_red<URed> $v_COL_NON +  $v_COL_UL_blue<uBlue>"

    #   echo -e "$v_COL_NONE"

    echo "echo background test....";  sleep 1

    echo -e "$v_COL_BG_magenta Purple"  ; sleep 1
    echo -e "$v_COL_BG_yellow Yellow"  ; sleep 1
    echo -e "$v_COL_BG_blue Blue"    ; sleep 1
    echo -e "$v_COL_BG_cyan Cyan"    ; sleep 1
    echo -e "$v_COL_BG_white White"   ; sleep 1
    echo -e "$v_COL_BG_black Black"   ; sleep 1

    echo "puts test...."; sleep 1;

    f__puts "blue+white" $v_COL_ID_blue $v_COL_ID_white
    f__puts "red"        $v_COL_ID_red
    f__puts "green"      $v_COL_ID_green
    f__puts "yellow"     $v_COL_ID_yellow
    f__puts "blue"       $v_COL_ID_blue
    f__puts "none"
    f__puts "magenta"    $v_COL_ID_magenta
    f__puts "yellow+green" $v_COL_ID_yellow $v_COL_ID_green
    f__puts "cyan"       $v_COL_ID_cyan
    f__puts "white"      $v_COL_ID_white

    echo "test finished"; sleep 1
}

#
#   =*= f:  prompt
#

function f_lib_prompt() {
: '
    \u: the username of the current user.
    \h: the hostname up to the first dot (.)
        in the Fully-Qualified Domain Name.
    \w: the full dirname
    \W: the basename of the current working directory
    \$: If the current user is root, display #, $ ot

    oherwise.
    example:PS1="[\u@\H \W \!]$"
'

#   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '

    if [ "$1" == "" ]; then     #   * noColor
        PS1="${v_COL_NONE}\$ "
    elif [ "$1" == 1 ]; then    #   * color standard
        PS1='${debian_chroot:+($debian_chroot)}\[\033[1;32m\]\u@\h\[\033[00m\]:\[\033[1;34m\]\w\[\033[00m\]\$ '
    elif [ "$1" == 2 ]; then    #   prompt='$ ' yellow
        PS1="${v_COL_FG_yellow}\$ ${v_COL_NONE}"
    elif [ "$1" == 3 ]; then    #   p='usr@tron$ '
        PS1="${v_COL_FG_yellow}\u@\h${v_COL_NONE}\$ "
    elif [ "$1" == 4 ]; then    #   p='usr@tron:$ '
        PS1="${v_COL_FG_Lgreen}\u@\h${v_COL_NONE}:${v_COL_FG_yellow}\$${v_COL_NONE} "
    elif [ "$1" == 5 ]; then    #   p='usr@tron:<RELPATH> $ '
        PS1="${v_COL_FG_green}\u@\h${v_COL_NONE}:${v_COL_FG_Lblue}\W${v_COL_NONE}\$ "
    elif [ "$1" == 6 ]; then    #   p='usr@tron:<RELLPATH> $ '
        PS1="${v_COL_FG_Lgreen}@\h${v_COL_NONE}:${v_COL_FG_Lblue}\W${v_COL_FG_yellow}\$${v_COL_NONE} "
    elif [ "$1" == 7 ]; then    #   p='usr@tron:<FULLPATH> $ '
        PS1="${v_COL_FG_Lgreen}\u@\h${v_COL_NONE}:${v_COL_FG_Lblue}\w${v_COL_NONE}\$ "
    else
        PS1="${v_COL_NONE}\$ "
    fi

}

#
#   =*= f:  DTM
#

function f_lib_DTM() {
    f__trace ${FUNCNAME[0]} $LINENO "begin"
    v="+%y%m%d::%H%M%S"        #   "+%Y%m%d.%H%M%S"
    export v_ENV__DTM=$(date -r $v_FWK_STARTER $v)
}

#
#   =*= f:  exitCode
#

function f_lib_calcExitCode() {
    #   avoid exitCode =~lineNo conflict
    #   iEc={min...max} :   error
    #   iEc={0}         :   reserved-error
    #   iEc={1}         :   reserved-error
    #   iEc={2..9}      :   reserved-warnings
    #   REM: problem: bash returns only 1byte integers
    f__trace ${FUNCNAME[0]} $LINENO "lib.exit" $v_bTrace
    local n=$v_LIB__iEc_max-$v_LIB__iEc_min+1
    local i=$(( ( RANDOM % $n ) + $v_LIB__iEc_min )) #   iEc:={iEcMin...iEcMax}
    v_LIB__iEc=$i
    return $i       # !REM: BASH never more than 255
}

#   ===========================================================================
#   *** m:  isType
#   ===========================================================================

#
#   =*= f:  helper.echoExpression
#

function f__echoExpr() {
    #   IN: iFunction   :   >1: do echo
    #   IN: bValue      :   TRUE/FALSE
    #   IN: sInfo       :   "more text"
    #   IN: sParameter  :   original input
    declare -i iFc=$1
    local bVal=$2
    local sInfo=$3
    local sPar=$4
    local sRc
    #   echo "bRc:'$bVal'"
    #   echo "sPar:'$sPar'"
    #   return

    if [ "$iFc" == "" ] || [ $iFc -eq 0 ] ; then
        return #   echo "empty mode"
    fi
    if [ $iFc -ge 1 ]; then
        if [ "$sInfo" == "" ]; then
            sInfo=""
        elif [ $iFc -eq 1 ]  ; then
            sInfo="";
        elif [ $iFc -eq 2 ]  ; then
            sInfo+=":";
        else
            sInfo+="('$sPar')"
        fi
        if [ $bVal -eq $v_TRUE ]
            then    sRc="TRUE"
            else    sRc="FALSE"
        fi
        if [ $iFc -gt 2 ]; then
            printf "%s\t:\t%s\n" $sInfo $sRc
        else
            printf "%s%s\n" $sInfo $sRc
        fi
    fi
}

#
#   =*= f:  isNumeric
#

function f_lib_isNumeric() {
    local s='?IsNumeric'
    local bRc=$v_FALSE; declare -i iFc=$2
    if [ $(echo $1 | egrep "^[0-9]+$") ]
    then bRc=$v_TRUE; fi
    f__echoExpr $iFc $bRc $s $1
    return $bRc
}

#
#   =*= f:  isAlpha
#

function f_lib_isAlpha() {
    local s='?IsAlpha'
    local bRc=$v_FALSE; declare -i iFc=$2
    if [ $(echo $1 | egrep "^[A-Za-z]+$") ]
    then bRc=$v_TRUE; fi
    f__echoExpr $2 $bRc $s $1
    return $bRc
}

#
#   =*= f:  isAlnum
#

function f_lib_isAlnum() {
    local s='?IsAlnum'
    local bRc=$v_FALSE; declare -i iFc=$2
    if [ $(echo $1 | egrep "^[A-Za-z0-9]+$") ]
    then bRc=$v_TRUE; fi
    f__echoExpr $2 $bRc $s $1
    return $bRc
}

#
#   =*= f:  isHexNum
#
function f_lib_isHexnum() {
    local s='?IsHexnum'
    local bRc=$v_FALSE; declare -i iFc=$2
    if [ $(echo $1 | egrep "^[{a-f}{0-9}{A-F}]+$") ]    #!PHA: 'ab,3' : OK
    then bRc=$v_TRUE; fi
    f__echoExpr $2 $bRc $s $1
    return $bRc
}

#
#   =*= f:  isPunct
#

function f_lib_isPunct() {
    local s='?IsPunct'
    local bRc=$v_FALSE; declare -i iFc=$2
    if [ $(echo $1 | egrep "^[{\,}{\.}{\;}]+$") ]       #!PHA:not works ','
    then bRc=$v_TRUE; fi
    f__echoExpr $2 $bRc $s $1
    return $bRc
}

#
#   =*= f:  isUpper
#

function f_lib_isUpper() {
    local s='?IsUpper'
    local bRc=$v_FALSE; declare -i iFc=$2
    if [ $(echo $1 | egrep "^[A-Z]+$") ]
    then bRc=$v_TRUE; fi
    f__echoExpr $2 $bRc $s $1
    return $bRc
}

#
#   =*= f:  isLower
#

function f_lib_isLower() {
    local s='?IsLower'
    local bRc=$v_FALSE; declare -i iFc=$2
    if [ $(echo $1 | egrep "^[a-z]+$") ]
    then bRc=$v_TRUE; fi
    f__echoExpr $iFc $bRc $s $1
    return $bRc
}

#
#   =*= f:  isControlChar
#

function f_lib_isCntrl() {
    local s='?IsCntrl'
    local bRc=$v_FALSE; declare -i iFc=$2
    if [ $(echo $1 | egrep "[:cntrl]") ]    # !PHA:true
    then bRc=$v_TRUE; fi
    f__echoExpr $iFc $bRc $s '$1'
    return $bRc
}

#
#   =*= f:  isSpace
#

function f_lib_isSpace() {
    local s='?IsSpace'
    local bRc=$v_FALSE; declare -i iFc=$2
    if [ $(echo '$1' | egrep "[:space]") ]   # !PHA:true fix
    then bRc=$v_TRUE; fi
    f__echoExpr $iFc $bRc $s $1
    return $bRc
}

#
#   =*= f:  isWord
#

function f_lib_isWord() {
    # !PHA: how I tell only 1 parameter? => use: "'" braces
    #   use: $> f_lib_isWord 'word1 word2 word3'
    local s='?IsWord'
    local sTxt=$1
    local bRc=$v_FALSE; declare -i iFc=$2
    local x=$(echo $1 | egrep "[:word]")
    local l=${#x}
    if [ $l -gt 0 ]
    then bRc=$v_TRUE; fi
    f__echoExpr $iFc $bRc $s "$1"
    return $bRc
}

#   ===========================================================================
#   *** m:  isType.Special
#   ===========================================================================

#
#   =*= f:  isInteger
#

#   usage:  $>f_lib_isInteger 3 2
#           $<?isInteger('3'):True!
function f_lib_isInteger() {
    local s="?isInteger('$1')"
    local bRc=$v_FALSE; declare -i iFc=$2   # function
    if [ $(echo $1 | egrep "^[0-9]+$") ]
    then bRc=$v_TRUE; fi
    f__echoExpr $iFc $bRc $s $1
    return $bRc
}

#
#   =*= f:  isFile
#

function f_lib_isFile {
    local s='?IsFile'
    local bRc=$v_FALSE; declare -i iFc=$2
    if [ -f $1 ]; then bRc=$v_TRUE; fi
    f__echoExpr $iFc $bRc $s $1
    return $bRc
}

#
#   =*= f:  isDir
#

function f_lib_isDir {
    local s='?IsDir'
    local bRc=$v_FALSE; declare -i iFc=$2
    if [ -d $1 ]; then bRc=$v_TRUE; fi
    f__echoExpr $iFc $bRc $s $1
    return $bRc
}

#   ===========================================================================
#   *** m:  print && logging
#   ===========================================================================

#
#   =*= f:  print.lib   :   newline, prefix printing, logging, no colors!
#

function f_lib_print ()   {
    local sText=$1
    local bMode=$2
    local iCol=$3
    local s
    if [ -z $iCol ] || [ "$iCol" == "" ]; then
        iCol=$v_COL_ID_none
    fi
    if [ "$bMode" == "" ]; then
        #   NL:=No     Prefix:=No
        s="$sText"
        echo -e -n "$s"
    elif [ "$bMode" == $v_LIB__PRT_noNLnoPx ]; then
        #   NL:=No      Prefix:=No
        s="$sText"
        # echo -n -e "$s"
        f__print "$s" 0 $iCol $v_COL_ID_none   # echo -n -e "$s"
        s="... $sText"  # for logging
    elif [ "$bMode" == $v_LIB__PRT_onNLnoPx ]; then
        #   NL:=Yes     Prefix:=No      # *** default
        s="$sText"
        f__print "$s" 1 $iCol $v_COL_ID_none   # echo -e "$s"
    elif [ "$bMode" == $v_LIB__PRT_noNLonPx ]; then
        #   NL:=No      Prefix:=Yes
        s="--- t: $sText"
        f__print "$s" 0 $iCol $v_COL_ID_none   # echo -n -e "$s"
        s="... $sText"  # for logging
    elif [ "$bMode" == $v_LIB__PRT_onNLonPx ]; then
        #   NL:=Yes     Prefix:=Yes
        s="--- t: $sText"
        f__print "$s" 1 $iCol $v_COL_ID_none   # echo -e "$s"
    else
       #    echo "*** MODE:any"
        s="$sText"
        echo -e "$s"
    fi
    #   logging?
    if [ "$v_sLogfile" != "" ]; then    # !CRQ-240313:noLogCheck
        f__logs "$sText"
    fi
}

#
#   =*= f:  puts.lib    :   with prefix and logging
#

function f_lib_puts ()   {
    #   $1:string
    #   $2:foregroundColor_ID
    #   REM: with logging
    local pStr=$1; local pFgd=$2
#   local s="--- p:$pStr"
    local s="$pStr"
    f__output "$s" $pFgd
}

#
#   =*= f:  show        :   puts &&cyan
#

function f_lib_show()   {
    #   $1:string
    local pStr=$1; local pFgd=$v_COL_ID_cyan
    local s="--- s:$pStr"
    f__output "$s" $pFgd
}

#
#   =*= f:  info        :   puts &&yellow
#

function f_lib_info()   {
    local sText=$1
    local iLine=$2
    local s="$sText"
    s="--- i:$s"
    if [ ! -z $iLine ]; then
        s="$s [$iLine]"
    fi
    f__output "$s" $v_COL_ID_yellow
}

function f_lib_declare() {
    local   sMode=$1
    if [ -z $sMode ]; then
        sMode=h
    fi
    if [ $sMode == 'a' ]; then
        alias | grep '+'
    elif [ $sMode == 'f' ]; then
        declare -f \
                |   grep '^f_' \
                |   sed -E 's/^[[:space:]]+/ /g'
    elif [ $sMode == 'v' ]; then
        env | grep 'v_'
    else
        echo "usage :: $>f_lib_declare [a|f|v]"
    fi
}


function f_lib_error()   {
    local sText=$1
    local iLine=$2
    local s="$sText"
    s="=e= Error:$s"
    f__output "$s at:[$iLine]" $v_COL_ID_red
}

#   ===========================================================================
#   m:  F.DTM
#   ===========================================================================

function f_lib_time_getDateTimeString()   {
    local p_sDtmFmt=$1
    s=$(date $p_sDtmFmt)
    g_LIB__sRc=$s
    return ${#s}    # reply strlen
}

#   ===========================================================================
#   m:  F.file
#   ===========================================================================

#   in: filePath

function f_lib_file_getName()   {
    local p=$1
    #   echo "::filePath($p)"
    s=$(basename ${p})      # extract filePath
    g_LIB__sRc=$s
    return ${#s}    # reply strlen
}

function f_lib_file_getBody()   {
    local p=$1
    #   echo "::filePath($p)"
    s=$(basename ${p})  # baseName
    s=$(echo "$s" | sed -e 's/\.[^.]*$//')  # fileBody
    g_LIB__sRc=$s
    return ${#s}    # reply strlen
}

function f_lib_file_getExtension()   {
    local p=$1
    #   echo "::filePath($p)"
    # Source - https://stackoverflow.com/a/965072
    s=$(basename ${p})  # baseName
    s="${s##*.}"
    s=.$s
    g_LIB__sRc=$s
    return ${#s}    # reply strlen
}

function f_lib_file_getPath()   {
    local p=$1
    s=$(dirname ${p})
    g_LIB__sRc=$s
    return ${#s}    # reply strlen
}


#   ===========================================================================
#   m:  F.logging
#   ===========================================================================

#   in: filePath  out:filePath

#   in: p_iMod:1 - std p_iMod:2 with dtm
function f_lib_logging_getFilePath()   {
    #   parameter
    local p_sFilePath=$1  # input caller path
    local p_iMode=$2
    #   fileParameter
    sDir=$v_FWK_dirScratch
    sFnm=$(basename ${p_sFilePath})  # file.ext
    sBdy=$(echo "$sFnm" | sed -e 's/\.[^.]*$//')
    sExt=".log"
    #   prepare name
        s=$sBdy
    #   mode:2 => insert dateTimeString
    if [ $p_iMode == 2 ]
    then
        sDtm=$(date $v_LIB__DTM_FORMAT_now)
        s+='_'
        s+=$sDtm
    fi
    #   add file extension
    s+=$sExt
    #   filePath
    sRc="$sDir/$s"
    #   return.code
    g_LIB__sRc=$sRc
    return ${#sRc}    # reply strlen
}

#   ===========================================================================
#   *** m:  misc
#   ===========================================================================

#
#   =*= f:  random
#

function f_lib_random() {
    #   f~lib_random <nMax> <nMin>
    local -i iMax=$1
    local -i i
    if [ $iMax -le 0 ]; then
        return 0
    fi
    i=$(( RANDOM % $iMax ))     #  RANDOM() => 0...nMax-1
    let "i += 1"             #  1..MAX
    return $i   # returns => 1..nMax
}

#
#   =*= f:  sleep
#

function f_lib_sleep() {
    local i=$1
    echo "sleep('$i')"
    sleep $i
}

#   ===========================================================================
#   *** m:  menu functions
#   ===========================================================================

#
#   =*= f:  header
#

function f_lib_header() {

    local p_sScp=$1
    local p_iLine=$2
    local p_iReply=$3

    #   show my parameter
    #   echo "+ libHeader.p1=[$p_sScp]"
    #   echo "+ libHeader.p2=$p_iLine"
    #   echo "+ libHeader.p3=$p_iReply"
    #   show my globals
    #   echo "+ libHeader.g_sId=$g_sId"
    #   echo "+ libHeader.g_bLogMode=$g_bLogModeDate"

    local   sFileName=`basename $p_sScp`
    local   sName=$(echo "$sFileName" | sed -e 's/\.[^.]*$//')  # cut FileExtension

    #   timer globals
    v_TIMER_start=$(date +%s.%N)
    v_TIME_NOW=$(date $v_LIB__DTM_FORMAT_now)
    v_TIME_SRC=$(date -r $p_sScp $v_LIB__DTM_FORMAT_src)
    v_TIME_HDR=$(date $v_LIB__DTM_FORMAT_hdr)

    #   make my logFile
    local sLogfileId=${p_sScp:0:3}
    local   sLogfileId=$sName
    if [ "$p_iReply" == "" ]; then
        p_iReply=0  # undefined or OK
    fi

    local pLog='?'
    if [ $g_LIB__logMode == 2 ]        # !CRQ-260929
    then
        pLog="${v_DIR_LOG}/${sLogfileId}_${v_TIME_NOW}.log"
    else
        pLog="${v_DIR_LOG}/${sLogfileId}.log"
    fi
    #   echo "+ libHeader.pLog=[$pLog] "

    #   current funcname
    local sFct=${FUNCNAME[0]}

    #   logging
    s="*** hdr.created pos:[$p_sScp;$sFct;$p_iLine] tms:[$v_TIME_NOW]"
    #   echo "+ libHeader.LogPa=[$s]"
    f__logs "$s" "$pLog" $v_TRUE

    #   p_sScp=$(caller 0)
    export v_CALLER=$p_sScp

    #   init
    f_lib_colorInit

    #   fileTime
#   s=">>> =h= "
    s=">>> "
    s+="$p_sScp<$v_TIME_HDR>:[$p_iLine]:{$p_iReply}";
    f__output "$s" $v_COL_ID_green

    return $p_iReply
}

#
#   =*= f:  footer
#

function f_lib_footer() {
    local sScp=$1
    local p_iLine=$2
    local iRc=$3    #   current
    #   echo "&&&& iRc:=$iRc; iEc:=$v_LIB__iEc"
    local sTimer;
    local s
    local n=2       # format digits
    sleep 1
    local v_TIMER_stop=$(date +%s.%N)
    v_TIME_NOW=$(date $v_LIB__DTM_FORMAT_now)
    v_TIME_HDR=$(date $v_LIB__DTM_FORMAT_hdr)
    local fDiff=$(echo "($v_TIMER_stop-$v_TIMER_start) / 1" | bc)
    local sSec=$(echo $fDiff)   # !CRQ-200102: use bc
    s="... logFile.ftr<'$v_sLogfile'> by LIB created and written."
    f__output "$s" $v_COL_ID_blue
    s="<<< "
#   s="<<< =h= "
    s+="$sScp<$v_TIME_HDR>:{$v_TIME_NOW}:[$p_iLine]"
    s+=":{$iRc}"
    s+=";elapsed:<$sSec> seconds."
    f__output "$s" $v_COL_ID_green
    #   exit ?
    f_lib_exit $iRc
}

#
#   =*= f:  exit
#

function f_lib_exit() {
    local iEcTmp=$1
    local iEcLib=$v_LIB__iEc
    #   overwrite
    #   exit, only when valid exit code
    #   an, when called like $> SCRIPT iExitCode
    #   echo "iEcTmp=<$1>; iEcLib=<$2>"
    local sFct="${FUNCNAME[0]}"
    #if ( [ $iEcLib == 0 ] || [ $iEcLib == 1 ] || [ $iEcLib -gt 220 ] ) ; then
        # echo "<$iEcLib>={0|1|220+} at:[$sFct;$LINENO]"
        #   return # disable exit handling with {0,1}
    #fi
    if f_lib_isInteger $iEcTmp; then
        #   if [ $iEcTmp == $iEcLib ]; then
        #       echo "! exit <$iEcTmp>:OK :[$sFct;$LINENO]"
        #   else
        #       echo "? exit <$iEcTmp> != <$iEcLib> at:[$sFct;$LINENO]"
        #fi
        exit $iEcTmp
    fi
}

#
#   =*= f:  trace.lib
#

function f_lib_trace()   {
    local bNumeric=$v_FALSE
    if [ $(echo $1 | egrep "^[0-9]+$") ]
    then bNumeric=$v_TRUE; fi
    if [ $bNumeric == $v_TRUE ]; then
        sFctn="Body"
        iLine=$1
        sText=$2
        bTrcp=$3
    else
        sFctn=$1
        iLine=$2
        sText=$3
        bTrcp=$4
    fi
    #   empty input?
    if [ -z $bTrcp ]; then
        bTrcp=$v_TRUE
    fi
    if [ $bTrcp != $v_TRUE ]; then
        return
    fi
    local s="$sText"
    s="--- T:[$sFctn;$iLine]:'$s'"
    f__output "$s" $v_COL_ID_magenta
}

function f_lib_debug()   {
    local sText=$1
    local iLine=$2
    local bTrcp=$3
    local s="$sText"
    s="&&& d:$s [$iLine]"
    if [ -z $bTrcp ]; then
        bTrcp=$v_TRUE
    fi
    if [ $bTrcp != $v_TRUE ]; then
        return
    fi
    f__output "$s" $v_COL_ID_yellow
}


#
#   =*= f:  menu
#

function f_lib_menu() { #   [string] $p_sText, [int] $p_iLine = -1)
    local sText=$1
    local iLine=$2
    g_iMenu+=1
    g_iSmen=0
    printf -v x "[%2.2d]" "$g_iMenu"
    s="=== m$x : $sText at:[$iLine]"
    f__output "$s" $v_COL_ID_green
}

#
#   =*= f:  subMenu
#

function f_lib_menuS1() {
    local sText=$1
    local iLine=$2
    g_iSmen+=1
    printf -v x "[%2.2d]" "$g_iSmen"
    s="--- s$x : $sText at:[$iLine]"
    f__output "$s" $v_COL_ID_green
}

#
#   =*= f:  text
#

function f_lib_text() {
    local sText=$1
    local iLine=$2
    local s
    s="\t$sText"
    if [ ! -z $iLine ]; then
        s="$s [$iLine]"
    fi
    f__output "$s"
}

#
#   =*= f:  version
#

function f_lib_versionShow() {
    local s=$BASH_VERSION
    echo "*** libVersion"
    s="=v= Library:<$v_LIB__EXE> Version:<'$v_LIB__TIME'> BASH:<'$s'>"
    f__output "$s" $v_COL_ID_cyan
}

#   ===========================================================================
#   *** m:  environment
#   ===========================================================================

#
#   =*= f:  envCheck
#

function f_lib_env_check() {     # bXos bVerbose

    #   parameter
    local bXos=$1
    local bVerbose=$2

    #   empty input?
    if [ -z $bXos ]; then
        bXos=$v_FALSE
    fi
    if [ -z $bVerbose ]; then
        bVerbose=$v_FALSE
    fi

    #   init
    local i; local x
    local iDir; local aDir
    local iRc

    #   array
    f__trace ${FUNCNAME[0]} $LINENO "array" $v_bTrace

    #   standard
    aDir=( $v_ENV__DIR_tmp $v_ENV__DIR_log )
    aDir+=($v_DIR_CMD_BSH)
    aDir+=($v_DIR_CMD_PRL)
    aDir+=($v_DIR_CMD_PYT)
    aDir+=($v_DIR_CMD_RBY)
    aDir+=($v_DIR_CMD_CPP)
    aDir+=($v_DIR_CMD_C89)
    aDir+=($v_DIR_CMD_JVA)

    #   with XOS?
    if [ $bXos == $v_TRUE ]; then
        aDir+=($v_DIR_XOS_LOG)
        aDir+=($v_DIR_XOS_TMP)
    fi

    declare -p aDir
    declare -i i=0

    #   check
    f__trace ${FUNCNAME[0]} $LINENO "check Dirs" $v_bTrace
    for iDir in "${aDir[@]}"; do
        if [ $bVerbose == $v_TRUE ]; then
            echo -n "*** dir[$i]:check:<$iDir>:"
        fi
        x=$iDir
        if [ ! -d $x ]; then
            echo "??? path:=<{$x}>"; sleep 1
            return 99
        fi
        if [ $bVerbose == $v_TRUE ]; then
            echo ":OK" #    "OK:path" $v_iTRC
        fi
        i+=1
    done

    return 0
}

#
#   =*= f:  pathSet
#

function f_lib_pathSet(){
    f__trace ${FUNCNAME[0]} $LINENO "start"
    export PATH=
    export PATH=/usr/local/sbin
    export PATH=$PATH:/usr/local/bin
    export PATH=$PATH:/usr/sbin
    export PATH=$PATH:/usr/bin
    export PATH=$PATH:/bin
}

#
#   =*= f:  configureLib
#

function f_lib_configuration() {
    local bTrc=$1
    export v_bTrace=$bTrc
    return 0
}

#
#   =*= f:  aliasSet
#

function f_lib_aliasSet() {
    f__trace ${FUNCNAME[0]} $LINENO "MyAlias"
    alias   +cls='f_lib_screen_clear'
#   alias   +lib='source "$v_DIR_CMD_BSH" LIB.inc.bsh'
    alias   +put='f__puts'      # color
    alias   +egrep='egrep --color=auto'
    alias   +fgrep='fgrep --color=auto'
    alias   +grep='grep --color=auto'
    alias   +lsC='ls --color=auto'
    alias   +df='df -h'       # disk free
    alias   +hi='history'     # bsh>!4711 # calls hisEntry '4711'
    alias   +ip='ifconfig'
    alias   +run='run_bshTutor.bsh'
    alias   +info_a='f_lib_declare a'
    alias   +info_f='f_lib_declare f'
    alias   +info_v='f_lib_declare v'
    alias   +ldr="../bsh/LIB.inc.bsh"
}


#
#   =*= f:  variableSet
#

function f_lib_variableSet(){
    local iEnvId=$v_ENV__id
    f__trace ${FUNCNAME[0]} $LINENO "varSet:<$iEnvId>"
    if [ $iEnvId == 1 ]; then
        f__trace ${FUNCNAME[0]} $LINENO "varSet::WSL"
    else
        f__trace ${FUNCNAME[0]} $LINENO "varSet::ANY"
    fi
}

#   ===========================================================================
#   *** m:  body
#   ===========================================================================

#   echo "===   LIB.body.begin"

#   s:  constant
declare -i v_TRUE=100
declare -i v_FALSE=255

#   s:  add into environment vars
declare -i v_LIB__iEc=0
declare -i v_LIB__iEc_min=10            # offset to Ec range
declare -i v_LIB__iEc_max=210           # => iEc:={min,...,max} <= 255
declare -i v_LIB__iEc_std=100

#   s:  formatVar
v_LIB__DTM_FORMAT_now="+%y%m%d%H%M%S"
v_LIB__DTM_FORMAT_obj="+%y%m%d::%H%M%S"
v_LIB__DTM_FORMAT_src="+%Y-%m-%d.%H:%M:%S"
v_LIB__DTM_FORMAT_hdr="+%Y.%m.%d__%H:%M:%S"

#  s:   baseName
v_FWK_LIBRARY=`basename $BASH_SOURCE`
#   echo "+     FWK.library =[$v_FWK_LIBRARY]"

#  s:   time
v_LIB__TIME=$(date -r $v_FWK_LIBRARY $v_LIB__DTM_FORMAT_obj)

#   s:  printVarff
v_LIB__PRT_noNLnoPx=51
v_LIB__PRT_onNLnoPx=52
v_LIB__PRT_noNLonPx=53
v_LIB__PRT_onNLonPx=54

#   s:  libConfig
f_lib_configuration $v_FALSE    #   && echo "*** libloaded"

#   s:  globals inside Lib
declare -i g_iMenu=0
declare -i g_iSmen=0

#   s:  globals for caller
declare -i g_LIB__iRc=0
declare -x g_LIB__sRc='?Any'

#   s:  set tabSize
tabs 4

#   s:  init missing
v_DIR_LOG=$v_FWK_dirScratch
v_DIR_TMP=$v_FWK_dirScratch

#   s:  logMode
declare -i g_LIB__logMode=1


#   echo "===   LIB.body.end"


