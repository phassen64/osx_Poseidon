#   content:
#       b:  B.function
#           •   m:  F.config
#           •   m:  F.helper
#           •   m:  F.color
#               •   s:  f.define.colorEscape
#               •   s:  f.define.colorValue
#           •   m:  F.echo & F.print & F.puts
#       b:  B.body

#   remark:
#       The lib configuration should be set to verbose

#   remark 'echo':
#       The primary options (flags) supported by the Bash echo command are:
#       Option Description Example
#       -n      Suppresses the trailing newline (keeps output on the same line)
#               example:    $   echo -n "Hello && " echo "peter"
#       -e	    Enables interpretation of backslash
#                   escape sequences (e.g., \n, \t).
#               example:    $   echo -e "Line1\nLine2"
#       -E	    Disables backslash escape interpretation
#                   (this is the default setting).
#               example:    $   echo -E "Line1\nLine2"


#   &&& b:  b.function  &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&


#   ===========================================================================
#   m:  F.config
#   ===========================================================================

function f_lib_configuration() {
    v_LIB_bVerbose=$1
    if [ $v_LIB_bTrue == $v_LIB_bVerbose ]; then
        echo "< L.configuration :: [$v_LIB_bVerbose] !"
        echo "< L.iRc :: [$v_LIB_reply_iRc]"
        echo "< L.sRc :: [$v_LIB_reply_sRc]"
    fi
    #   set my internals
    f_lib_color_defineEscapeCode
    f_lib_color_setValue
}

function f_lib_info() {
    local i=$v_LIB_COLOR_ESC_NONE
    if [ $v_LIB_bTrue == $v_LIB_bVerbose ]; then
        echo "< L.info.color :: ['$i']"
    fi
}

#   ===========================================================================
#   m:  F.helper
#   ===========================================================================

function f_lib_who() {
    local l_sPwd=`pwd`
    local l_sScp=$BASH_SOURCE
    local l_sPth=$l_sPwd/$l_sScp
    if [ $v_LIB_bTrue == $v_LIB_bVerbose ]; then
        echo "< L.who :: I am file:[$l_sPth]"
    fi
}

function f_lib_where() {
    local p_sCaller=$1
    local p_iLine=$2
    local p_iValue=$3
    #   my Name
    local l_sFct=${FUNCNAME[0]}
    #   show
    if [ $v_LIB_bTrue == $v_LIB_bVerbose ]; then
        echo "< L.where :: Hello I am:[$l_sFct] !"
        echo "< L.where :: I was called by:[$p_sCaller] atLine:[$p_iLine]"
        echo "< L.where :: I got the value:[$p_iValue]"
    fi
}

function f_lib_caller() {
    local p_sCaller=$1
    local l_sPwd=`pwd`
    local l_sPth
    #   show
    l_sPth=$l_sPwd/$p_sCaller
    if [ $v_LIB_bTrue == $v_LIB_bVerbose ]; then
        echo "< L.caller :: [$l_sPth] !"
    fi
}

function f_lib_dateTime() {
    local l_sFmt="+%Y-%m-%d_%H%M%S"
    local l_sDtm=$(date $l_sFmt)
    if [ $v_LIB_bTrue == $v_LIB_bVerbose ]; then
        echo "< L.dateTime :: [$l_sDtm]"
    fi
}

function f_lib_sleep() {
    local i=$1
    if [ $v_LIB_bTrue == $v_LIB_bVerbose ]; then
        echo "< L.sleep :: [$i]"
    fi
    sleep $i
}


#   ===========================================================================
#   m:  F.color
#   ===========================================================================

#   s:  f.define.colorEscape

function f_lib_color_defineEscapeCode() {

    #!URL   https://stackoverflow.com/questions/5947742/
    #               /how-to-change-the-output-color-of-echo-in-linux
    #   ansi colors
    #   Black        0;30     Dark Gray     1;30
    #   Red          0;31     Light Red     1;31
    #   Green        0;32     Light Green   1;32
    #   Brown/Orange 0;33     Yellow        1;33
    #   Blue         0;34     Light Blue    1;34
    #   Purple       0;35     Light Purple  1;35
    #   Cyan         0;36     Light Cyan    1;36
    #   Light Gray   0;37     White         1;37

    #   00:NONE
    v_LIB_COLOR_ESC_NONE='\033[0m'          #   no color or RESET

    #   Foreground: '0'
    v_LIB_COLOR_ESC_FG_black='\033[0;30m'
    v_LIB_COLOR_ESC_FG_red='\033[0;31m'
    v_LIB_COLOR_ESC_FG_green='\033[0;32m'
    v_LIB_COLOR_ESC_FG_brown='\033[0;33m'
    v_LIB_COLOR_ESC_FG_blue='\033[0;34m'
    v_LIB_COLOR_ESC_FG_magenta='\033[0;35m'
    v_LIB_COLOR_ESC_FG_cyan='\033[0;36m'
    v_LIB_COLOR_ESC_FG_Lgray='\033[0;37m'

    #   Foreground 01:class '1'
    v_LIB_COLOR_ESC_FG_gray='\033[1;30m'
    v_LIB_COLOR_ESC_FG_Lred='\033[1;31m'
    v_LIB_COLOR_ESC_FG_Lgreen='\033[1;32m'
    v_LIB_COLOR_ESC_FG_yellow='\033[1;33m'
    v_LIB_COLOR_ESC_FG_Lblue='\033[1;34m'
    v_LIB_COLOR_ESC_FG_Lpurple='\033[1;35m'
    v_LIB_COLOR_ESC_FG_Lcyan='\033[1;36m'
    v_LIB_COLOR_ESC_FG_white='\033[1;37m'

    #   Background
    v_LIB_COLOR_ESC_BG_black='\033[40m'       # Black
    v_LIB_COLOR_ESC_BG_red='\033[41m'         # Red
    v_LIB_COLOR_ESC_BG_green='\033[42m'       # Green
    v_LIB_COLOR_ESC_BG_yellow='\033[43m'      # Yellow
    v_LIB_COLOR_ESC_BG_blue='\033[44m'        # Blue
    v_LIB_COLOR_ESC_BG_magenta='\033[45m'      # Purple
    v_LIB_COLOR_ESC_BG_cyan='\033[46m'        # Cyan
    v_LIB_COLOR_ESC_BG_white='\033[47m'       # White

    # Bold
    v_LIB_COLOR_ESC_BD_black='\033[1;30m'       # Black
    v_LIB_COLOR_ESC_BD_red='\033[1;31m'         # Red
    v_LIB_COLOR_ESC_BD_green='\033[1;32m'       # Bold.Green
    v_LIB_COLOR_ESC_BD_yellow='\033[1;33m'      # Yellow
    v_LIB_COLOR_ESC_BD_blue='\033[1;34m'        # Blue
    v_LIB_COLOR_ESC_BD_magenta='\033[1;35m'      # Purple
    v_LIB_COLOR_ESC_BD_cyan='\033[1;36m'        # Cyan
    v_LIB_COLOR_ESC_BD_white='\033[1;37m'       # White

    # Underline
    v_LIB_COLOR_ESC_UL_black='\033[4;30m'       # Black
    v_LIB_COLOR_ESC_UL_red='\033[4;31m'         # Red
    v_LIB_COLOR_ESC_UL_green='\033[4;32m'       # Underline.Green
    v_LIB_COLOR_ESC_UL_yellow='\033[4;33m'      # Yellow
    v_LIB_COLOR_ESC_UL_blue='\033[4;34m'        # Blue
    v_LIB_COLOR_ESC_UL_magenta='\033[4;35m'      # Purple
    v_LIB_COLOR_ESC_UL_cyan='\033[4;36m'        # Cyan
    v_LIB_COLOR_ESC_UL_white='\033[4;37m'       # White
}

#   s:  f.define.colorValue

function f_lib_color_setValue() {

#   handle color
    local iEnvId=$v_ENV__id
    local bColor=false

    #   standard
    v_LIB_COLOR_VID_none=-1
    v_LIB_COLOR_VID_black=0
    v_LIB_COLOR_VID_gray=8

#   dark
    v_LIB_COLOR_VID_DK_red=1
    v_LIB_COLOR_VID_DK_green=2
    v_LIB_COLOR_VID_DK_yellow=3   # olive
    v_LIB_COLOR_VID_DK_blue=4
    v_LIB_COLOR_VID_DK_magenta=5
    v_LIB_COLOR_VID_DK_cyan=6
    v_LIB_COLOR_VID_DK_white=7

#   light - not for RPi
    v_LIB_COLOR_VID_LH_red=9
    v_LIB_COLOR_VID_LH_green=10
    v_LIB_COLOR_VID_LH_yellow=11
    v_LIB_COLOR_VID_LH_blue=12
    v_LIB_COLOR_VID_LH_magenta=13
    v_LIB_COLOR_VID_LH_cyan=14
    v_LIB_COLOR_VID_LH_white=15

#   RPi/GIT redefine...?
    #   -z is true when a string has zero length,
    if [ -z $iEnvId ] ; then
        bColor=true
    elif [ $iEnvId -ne 3 ] && [ $iEnvId -ne 9 ] ; then
        bColor=true
    fi

    if [ $bColor ] ; then
        v_LIB_COLOR_VID_red=$v_LIB_COLOR_VID_DK_red
        v_LIB_COLOR_VID_green=$v_LIB_COLOR_VID_LH_green
        v_LIB_COLOR_VID_yellow=$v_LIB_COLOR_VID_LH_yellow
        v_LIB_COLOR_VID_blue=$v_LIB_COLOR_VID_LH_blue
        v_LIB_COLOR_VID_magenta=$v_LIB_COLOR_VID_LH_magenta
        v_LIB_COLOR_VID_cyan=$v_LIB_COLOR_VID_LH_cyan
        v_LIB_COLOR_VID_white=$v_LIB_COLOR_VID_LH_white
    fi

}

#   ===========================================================================
#   m:  F.echo & F.print & F.puts
#   ===========================================================================

#   *   standard
function f_lib_echo() {
    local s=$1
    echo -E $s      #   no \t\n or EscapeChars
}

#   *   complete control but ESC inside the string

function f_lib_print() {
    #   par1:   string to print
    #   par2:   bNewLine standard is FALSE
    #   par3:   foregroundColor_ID <integer>
    #   par4:   backgroundColor_ID <integer>
    local pStr=$1; local pNL=$2; local pFgd=$3; local pBgd=$4;
    #   set colors
    if [ ! -z $pFgd ] && [ $pFgd -ne $v_LIB_COLOR_VID_none ]; then
        tput setaf $pFgd
    fi
    if [ ! -z $pBgd ] && [ $pBgd -ne $v_LIB_COLOR_VID_none ]; then
        tput setab $pBgd
    fi
    #   set NewLine
    if [ ! -z $pNL ] && [ $v_LIB_bTrue == "$pNL" ]; then
        echo -e $pStr $v_LIB_COLOR_ESC_NONE
    else
        echo -e -n $pStr $v_LIB_COLOR_ESC_NONE  # no NewLine
    fi
}

function f_lib_puts() {
    #   par1:   string to print
    #   par2:   foregroundColor_ID <integer>
    local s=$1; local c=$2;
    f_lib_print $s $v_LIB_bTrue $c
}

#   ===========================================================================
#   m:  F.file
#   ===========================================================================

#   in: filePath


function f_lib_file_getPath() {
    local p_sScp=$1
    local l_sPwd=`pwd`
    local s
    if [ $v_LIB_bTrue == $v_LIB_bVerbose ]; then
        echo "< L.pScp :: [$p_sScp]"
        echo "< L.sPwd :: [$l_sPwd]"
    fi
    s=$l_sPwd/$p_sScp
    v_LIB_reply_sRc=$s
    return ${#s}        # reply strlen
}

function f_lib_file_getName()   {
    local p=$1
    local s
    s=$(basename ${p})      #   extract filePath
    if [ $v_LIB_bTrue == $v_LIB_bVerbose ]; then
        echo "< L.fileGetName :: [$p]"
        echo "< L.fileGetName =: [$s]"
    fi
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

function f_lib_file_getBody()   {
    local p=$1
    local s
    #   echo "::filePath($p)"
    s=$(basename ${p})  # baseName
    s=$(echo "$s" | sed -e 's/\.[^.]*$//')  # fileBody
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}

function f_lib_file_getExtension()   {
    local p=$1
    local s
    #   echo "::filePath($p)"
    # Source - https://stackoverflow.com/a/965072
    s=$(basename ${p})  # baseName
    s="${s##*.}"
    s=.$s
    v_LIB_reply_sRc=$s
    return ${#s}    # reply strlen
}


#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
#   b:  B.body
#   &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

#   s:  LIB.boolean
declare -i v_LIB_bTrue=100
declare -i v_LIB_bFalse=255

#   s:  LIB.config.setting.verbose : 1
declare -i v_LIB_bVerbose=0

#   s:  LIB.replyCodes
declare -i v_LIB_reply_iRc=99
declare -x v_LIB_reply_sRc='?None'

