#!/bin/bash

#   !url:
#   https://www.w3schools.com/bash/


#   header
clear

#   include
source LIB.wsp.inc.bsh
#   f_lib_configuration  1

#   libHeader
f_lib_header $BASH_SOURCE $LINENO 123

#   Ausgabe mit externer Funktion
f_lib_puts "\trun :MyTest..." $v_LIB_COLOR__magenta

#   libText mit auto tabe
f_lib_text "Harvey & Peter" $v_LIB_COLOR__red

#   Ausgabe mit externer Funktion
f_lib_puts "\tI have finished :MyTest." $v_LIB_COLOR__magenta

#   libfooter
f_lib_footer $BASH_SOURCE $LINENO 761
