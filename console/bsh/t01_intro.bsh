#!/bin/bash

#   description:    tester for my new BashLibrary

#   usage   :   $   bash t01_intro.bsh

#   content:
#       m:  F.header
#       m:  F.helper
#       m:  F.printing
#       m:  F.file
#       m:  F.logging
#       m:  F.footer

#   ===========================================================================
#   m:  F.header
#   ===========================================================================

clear
echo "=== header runMe($BASH_SOURCE) [`date`]"

#   s:  declare my variables
declare -x s
declare -i i
declare -i iRc
declare -x sRc

#   s:  include
echo ""
echo "* include library 'LIB'"
source LIB.wsp.inc.bsh

#   s:  lib.configuration
echo ""
echo "$ call LIB.config"
i=$v_LIB_bTrue
f_lib_configuration $i

#   s:  lib.header - take out exitCode
echo ""
echo "$ call LIB.header"
f_lib_header $BASH_SOURCE $LINENO $v_FWK_iEc
exit

#   s:  info
echo ""
echo "$ call LIB.info"
f_lib_info

#   ===========================================================================
#   m:  F.helper
#   ===========================================================================

#   s:  who
echo ""
echo "$ call LIB.who"
f_lib_who

#   s:  where
echo ""
echo "$ call LIB.where"
f_lib_where  $BASH_SOURCE $LINENO $RANDOM

#   s:  caller
echo ""
echo "$ call LIB.caller"
f_lib_caller  $BASH_SOURCE

#   s:  show.DateTime
echo ""
echo "$ call LIB.DateTime"
f_lib_dateTime
iRc=$?
sRc=$v_LIB_reply_sRc
echo "< m.sRc =: [$sRc]"
echo "< m.iRc =: [$iRc]"

#   s:  sleep
echo ""
echo "$ call LIB.sleep [1]"
f_lib_sleep 1

#   ===========================================================================
#   m:  F.printing
#   ===========================================================================

#   s:  echo
echo -e "\n$ call LIB.echo"
f_lib_echo "Hello Peter !"

#   s:  print (foreground & background)
echo ""

#   u:  print.easy
echo "$ call LIB.print any"
f_lib_print "A normal text printed" $v_LIB_bTrue

#   u:  print.multiple in 1 line and colored
f_lib_print "1:red."        $v_LIB_bFalse   $v_LIB_COLOR_VID_red
f_lib_print "2:yellow."     $v_LIB_bFalse   $v_LIB_COLOR_VID_yellow
f_lib_print "3:green."      $v_LIB_bFalse   $v_LIB_COLOR_VID_green
f_lib_print "4:blue."       $v_LIB_bFalse   $v_LIB_COLOR_VID_blue
f_lib_print "5:magenta."    $v_LIB_bFalse   $v_LIB_COLOR_VID_magenta
f_lib_print "6:cyan."       $v_LIB_bTrue    $v_LIB_COLOR_VID_cyan

#   s:  puts (implicitely NL)
echo -e "\n$ call LIB.puts"
f_lib_puts "1:red!"         $v_LIB_COLOR_VID_red
f_lib_puts "2:yellow!"      $v_LIB_COLOR_VID_yellow
f_lib_puts "3:green!"       $v_LIB_COLOR_VID_green

#   s:  puts (NoColor)
f_lib_puts "9:noColor"

#   ===========================================================================
#   m:  F.file
#   ===========================================================================

echo ""
echo "* LIB.file"

#   s:  L.filePath
echo ""
echo "$ call LIB.file.getPath"
f_lib_file_getPath $BASH_SOURCE

#   save return code
iRc=$?

#   fetch global lib reply code
sRc=$v_LIB_reply_sRc

#   show main variables
echo "< m.sRc =: [$sRc]"
echo "< m.iRc =: [$iRc]"

#   s:  L.fileName
echo ""
echo "$ call LIB.file.name"
f_lib_file_getName $BASH_SOURCE
iRc=$?
sRc=$v_LIB_reply_sRc
echo "< m.sRc =: [$sRc]"
echo "< m.iRc =: [$iRc]"

#   s:  L.fileBody
echo ""
echo "$ call LIB.file.body"
f_lib_file_getBody $BASH_SOURCE
iRc=$?
sRc=$v_LIB_reply_sRc
echo "< m.sRc =: [$sRc]"
echo "< m.iRc =: [$iRc]"

#   s:  L.fileExtension
echo ""
echo "$ call LIB.file.extension"
f_lib_file_getExtension $BASH_SOURCE
iRc=$?
sRc=$v_LIB_reply_sRc
echo "< m.sRc =: [$sRc]"
echo "< m.iRc =: [$iRc]"

#   s:  L.fileModificationTime
echo ""
echo "$ call LIB.file.ModificationTime"
f_lib_file_getModificationTime $BASH_SOURCE
iRc=$?
sRc=$v_LIB_reply_sRc
echo "< m.sRc =: [$sRc]"
echo "< m.iRc =: [$iRc]"


#   ===========================================================================
#   m:  F.logging
#   ===========================================================================

echo ""
echo "* LIB.logging"

#   fetch random value[1,2]
echo ""
declare -i iMax=2
declare -i iMin=1
echo "$ call LIB.random ($iMax,$iMin)"
f_lib_random $iMax $iMin; iRnd=$?
echo "< m.iRnd =: [$iRnd]"

#   show logFilePath
echo ""
echo "$ call LIB.logging.GetPath"

#   bMod : logging with dateTimeString?
bMod=$v_LIB_bFalse
i=$iRnd%2
if [ $i == 0 ]; then
    bMod=$v_LIB_bTrue
fi

#   run
pSrc=$BASH_SOURCE
dObj=$HOME
f_lib_logging_getPath $pSrc $dObj $bMod iRc=$?; sRc=$v_LIB_reply_sRc

#   reply
echo "< m.sRc =: [$sRc]"
echo "< m.iRc =: [$iRc]"
declare -x pTestFilePath=$v_LIB_reply_sRc

#   write/append file
echo ""
echo "$ call LIB.writeFile"
sTxt="peter:[`date`]"
iMod=1
f_lib_file_write $pTestFilePath $sTxt $iMod; iRc=$?
echo "< m.iRc =: [$iRc]"


#   ===========================================================================
#   m:  F.footer
#   ===========================================================================

echo ""
echo "$ call LIB.footer"
f_lib_footer $BASH_SOURCE $LINENO ; iRc=$?
echo "< m.iRc =: [$iRc]"

echo -e "\n=== footer [`date`]."
