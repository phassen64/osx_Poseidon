<<CONTENT_T1
    content:
        •   include library
        •   F.lib.header
        •   F.lib.puts
        •   F.lib.text
        •   F.lib.footer
CONTENT_T1

#   header
#   clear

#   include
source LIB.wsp.inc.bsh

#   libConfigure
f_lib_configuration
if [ "$1" == "" ]; then
    #   clear
    f_lib_configuration '+' '-' '-' '-'     #   apply colorMode
    p_sCaller='Dummy'
else
    p_sCaller=$1
fi

#   libHeader
iEc=123
f_lib_header $iEc

#   show my caller
f_lib_echo "+ callerScript:{'"$p_sCaller"'}"

#   Ausgabe mit externer Funktion
f_lib_puts "\trun :MyTest($1)..." $v_LIB_COLOR__magenta

#   libText mit auto tabe
f_lib_text "Harvey & Peter" $v_LIB_COLOR__red

#   Ausgabe mit externer Funktion
f_lib_puts "\tI have finished :MyTest." $v_LIB_COLOR__magenta

#   libfooter
iEc=761
f_lib_footer $iEc
