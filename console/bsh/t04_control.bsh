#
#   &&& b:  B.function
#

#   m:  F.test.Number
function f_test_number {
    f_lib_print "${FUNCNAME[0]} :: number('$1')"
    case $1 in
        [1-3])
            f_lib_puts ": is between 1 and 3"
        ;;
        [4-8])
            f_lib_puts ": is between 4 and 8"
        ;;
        *)
            f_lib_puts "default"
        ;;
    esac
}

#   m:  F.test.Name
function f_test_name {
    f_lib_print "${FUNCNAME[0]} :: name('$1')"
    case $1 in
        'Luke')
            f_lib_print "'first name'"
        ;;
        'Skywalker')
            f_lib_print "'second name'"
        ;;
        *)
            f_lib_print "'?:unknown name'"
        ;;
    esac
    f_lib_puts ";"
}

#   m:  F.test.Char
function f_test_char {
    f_lib_print "${FUNCNAME[0]} :: char('$1'):"
    case $1 in
        [a-j]*)
            f_lib_puts "'lowcase letter:a-j'"
        ;;
        [A-J]*)
            f_lib_puts "'upper letter:A-J'"
        ;;
        [A-Za-z]*)
            f_lib_puts "'letters'"
        ;;
        [0-9]*)
            f_lib_puts "'digits'"
        ;;
        [+*-/]*)
            f_lib_puts "'arithmetics'"
        ;;
        *)
            f_lib_puts "'any chars'"
        ;;
    esac
}

#
#   &&& b:  B.body
#

#   b:  include
source LIB.wsp.inc.bsh
if [ "$1" == "" ]; then f_lib_configuration '+' '-'; fi
declare -i z_iEc=$1

#   b:  F.header
f_lib_header $z_iEc

#
#   b:  main
#

#   local integer
declare -i i=-1
declare -i j=-1
declare -i n=-1
declare -x x='-'    # string or number

#   local array
declare -a aNumber=(\
'One' 'Two' 'Three' 'Four' 'Five')
declare -a aFruit=(\
'Apple' 'Banana' 'Cherry' 'Duran' 'Eggfruit' 'Fig' 'Grapefruit' 'Huckleberry')

#   ===========================================================================
#   m:  C.if
#   ===========================================================================

#   m:  F.menu
f_lib_menu "if"

#   s:  if-then-else-fi
f_lib_menuS1 "if-then-else-fi"
x=1
f_lib_puts "? (x == 1)"
if [ $x == 1 ]
then
    f_lib_text "<<< true: x==1"
else
    f_lib_text "<<< false: x is not 1"
fi

#   s:  if-thenelse-fi
f_lib_menuS1 "if-thenelse-fi"

#   get a random number 0...9
n=10
x=$(f_lib_random $n)
f_lib_puts "random x := <$x>" $v_LIB_color__cyan

f_lib_puts "? (x == 5 || x > 1)"
if [ $x == 5 ] || [ $x -gt 1 ]
    then f_lib_text "<<< true: x==2 or >1"
    else f_lib_text "<<< false: x is not found"
fi

#   s:  if-fi short
f_lib_menuS1 "if-fi:short"

#   u:  block
f_lib_puts "?(x == 5)" $v_LIB_color__cyan
[ $x == 5 ] &&      f_lib_puts "<<< true: x==5"     $v_LIB_color__green \
            ||      f_lib_puts "<<< false: x != 5"  $v_LIB_color__red

#   u:  all in 1 line
f_lib_puts "?(x == i)" $v_LIB_color__cyan
i=1
x=2
if [ $x -eq $i ]; then s='TRUE!'; else s='false'; fi
f_lib_text "<<< x==i :[$s]"

#   u:  all in 1 line and no else
f_lib_puts "?(x != i)" $v_LIB_color__cyan
i=1
x=2
if [ $x -ne $i ]; then s='TRUE!'; fi
f_lib_text "<<< x!=i :[$s]"


#   ===========================================================================
#   m:  C.case-esac
#   ===========================================================================

#   m:  F.menu
f_lib_menu "case"

#   ----------------------------------------------------------------------------
#   s:  F.case.number
#   ----------------------------------------------------------------------------

f_lib_menuS1 "test a number"

#   fetch a number random and run test

i=1
n=10

#   test1
f_lib_randomMore $n; x=$?;
i+=1
f_lib_puts "+ using x[$i] := <$x>" $v_LIB_color__blue
f_test_number $x

#   test2
i+=1
f_lib_randomMore $n; x=$?;
f_lib_puts "+ using x[$i] := <$x>" $v_LIB_color__blue
f_test_number $x

#   test3
i+=1
f_lib_randomMore $n; x=$?;
f_lib_puts "+ using x[$i] := <$x>" $v_LIB_color__blue
f_test_number $x

#   ----------------------------------------------------------------------------
#   s:  F.case.name
#   ----------------------------------------------------------------------------

f_lib_menuS1 "test a name"

f_test_name 'Luke'
f_test_name 'Skywalker'
f_test_name 'Yoda'

#   ----------------------------------------------------------------------------
#   s:  F.case.char
#   ----------------------------------------------------------------------------

f_lib_menuS1 "test a char"

# only the first char is relevant
f_test_char 'aBC'    #  lowerCase
f_test_char 'AbC'    #  upperCase
f_test_char '123'    #  digits
f_test_char '+'      #  arithmetics
f_test_char '/'      #  arithmetics
f_test_char '!'      #  any

#   ===========================================================================
#   m:  C.loop.while
#   ===========================================================================

#   m:  F.menu
f_lib_menu "loop.while"

#   s:  loop.while.easy
f_lib_menuS1 "example 1:easy"

i=0;n=3
f_lib_text "while [ i < n ] ... "
f_lib_print "<<< "

while [ $i -lt $n ]; do
   f_lib_print "[$i]" $v_LIB_bFalse $v_LIB_color__red
   let i++
done

f_lib_puts ";"

#   s:  loop.while.complex
f_lib_menuS1 "example 2:complex"

i=0;j=0;n=4;m=9

f_lib_text "while [ i < n && j < m ] ..."
f_lib_print "<<< "

while [[ $i -lt $n && $j -lt $m ]]; do
   f_lib_print "[$i/$j]" $v_LIB_bFalse  $v_LIB_color__red
   let i++
   let j+=2
done

f_lib_puts ";"

#   ===========================================================================
#   m:  C.loop.repeat
#   ===========================================================================

#   m:  F.menu
f_lib_menu "loop.until"

n=5; i=10

f_lib_text "until [ i < n ] ..."
f_lib_print "<<< "

until [ $i -lt $n ]; do
   f_lib_print "[$i/$n]" $v_LIB_bFalse  $v_LIB_color__red
   let i--
done

f_lib_puts ";"

#   ===========================================================================
#   m   C.loop.for
#   ===========================================================================

f_lib_menu "loop.for"

#   ----------------------------------------------------------------------------
#   s:  loop.for.index  : C-style
#   ----------------------------------------------------------------------------

f_lib_menuS1 "forIndex C-style"

#   u:  max
n=${#aNumber[@]}

#   u:  loop
for (( i=0; i < ${n}; i++ ));
do
    x=${aNumber[$i]}
    f_lib_print "\tFruit[$i]/[$n] : "
    f_lib_puts "$x" $v_LIB_color__red    # One Two Three Four Five
done

#   ----------------------------------------------------------------------------
#   s:  loop.for.each
#   ----------------------------------------------------------------------------

f_lib_menuS1 "forEach"

#   u:  max
n=${#aFruit[@]}

#   u:  loop
i=0
for x in "${aFruit[@]}"; do
    f_lib_print "\tFruit[$i]/[$n] : "
    f_lib_puts "$x" $v_LIB_color__red   # Apple Banana ... Huckleberry
    i+=1
done


#   ----------------------------------------------------------------------------
#   s:  loop.for.range
#   ----------------------------------------------------------------------------

f_lib_menuS1 "forRange"

f_lib_menuS2 "forRange.default"

#   u:  max
n=${#aNumber[@]}

#   u:  loop
for i in {1..3}
do
    x=${aNumber[$i]}
    f_lib_print "\tFruit[$i]/[$n] : "
    f_lib_puts "$x" $v_LIB_color__red       # Two Three Four
done


f_lib_menuS2 "forRange.stepSize"

#   u:  max
n=${#aFruit[@]}

#   u:  loop
for i in {0..7..2}
do
    x=${aFruit[$i]}
    f_lib_print "\tFruit[$i]/[$n] : "
    f_lib_puts "$x" $v_LIB_color__red       # Apple Cherry Eggfruit Grapefruit
done

#   b:  F.footer
f_lib_footer 1


#   &&& b:  B.lastLine