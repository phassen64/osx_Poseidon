<<usage
    Tutorial 2026-10-10

    +   usage:
            $>. {thisScript} [cOpt]=:'h' [{iStressFator(iSfr)}]=:'1'
                with:
            cOpt := { 'h','c','.','_','+','!'}
            iSfr := [1..10]

    +   Examples:
            $> . run h     :    help
            $> . run c     :    clean temp
            $> . run .     :    run some file of the tutorial
            $> . run +     :    1/4
            $> . run 4     :    run tutorFile ¼ of tutor randomly
            $> . run !     :    run all TC
            $> . run . 5   :    run someFile 5 times
            $> . run 3 3   :    b03 3x
usage


<<hereDoc_content_tutor__run_expert
    content:
        p:  p.function
            m:  f.hlp.hint
            m:  f.hlp.usage
            m:  f.hlp.bEvaluate
            m:  f.hlp.aMatchFiles
        p:  p.body
            b:  b.include
            b:  b.header
            b:  b.main
                m:  paramter-fetch
                m:  run match
                m:  prepare object-array
            b:  b.footer
        p:  p.last
hereDoc_content_tutor__run_expert

#   ===========================================================================
#   p:  p.function
#   ===========================================================================

#   m:  f.hlp.hint
function f_run_hint() {
    local p_pBash=${BASH_SOURCE[1]}     #   caller.bscp
    c='$'
    printf "\t%c $p_pBash h  # get help\n" "$c"
    exit
}

#   m:  f.hlp.usage
function f_run_usage() {
    local p_pBash=${BASH_SOURCE[1]}     #   caller.bscp
    c='$'
    printf "&&& usage:\n"   "$c"
    printf "\t%c [$p_pBash] [cOpt]=:'h' [iSfr]=:'1' \n" "$c"
    printf "\t\tcOpt := { 'h','c','.','_','+','!'}\n"
    printf "\t\t\t";    printf " . : 1x random[1..MAX]; n=1\n"
    printf "\t\t\t";    printf " _ : [1..max]; n=max\n"
    printf "\t\t\t";    printf " ! : random[1...max]; n=max \n"
    printf "\t\t\t";    printf " + : some random[i..j]; n=max4\n"
    printf "\t\tiSfr := := [1..10]\n"
    exit
}


#   m:  f.hlp.evaluate
function f_run_bEvaluate {
    #   usage:  $ echo $(F $bVal)
    local -i b=$1
    if [ $b == $v_RUN_bTrue ]; then x='true'; else x='false' ; fi
    echo "$x"
}

#   m:  f.hlp.aMatchFiles
function f_run_matchFiles() {

    local p_sRex=$1           #   like: '^t[0-9]{2}_[A-Za-z]+\.bsh$'
    local -i p_bOpt=$2        #   doShuffle

    declare -i i=0
    declare -a aTmp=()

    #   init globals
    v_RUN_iRc=0
    v_RUN_aRc=()

    #   Get files with pattern
    for xFile in `ls`
    do
        if [ -f "$xFile" ]; then
            i+=1
            if [[ $xFile =~ $p_sRex ]]; then
                v_RUN_iRc+=1
                aTmp+=( $xFile )
            fi
        fi
    done
    declare -p aTmp

    #   shuffle aTmp
    if [ ! -z $p_bOpt ] && [ $p_bOpt == $v_RUN_bTrue ]; then
        echo "### F_run_matchFiles:doShuffle"
        aTmp=( $(shuf -e "${aTmp[@]}") )
    fi

    #   reply
    v_RUN_aRc=("${aTmp[@]}")

    #   return

    return $i
}


function f_run_main() {

    #   s:  logFileName
    local v_SCP=`basename $BASH_SOURCE`
    local v_SCP_bdy="${v_SCP%.*}"
    local v_SCP_ext="${v_SCP##*.}"

    local x
    local s
    local iRc

    local fLog="$v_FWK_dirScratch/$v_SCP_bdy.log"
    local xLog

    local iCtr
    local sDtm; local tDtmStart; local tDtmStopp

    printf -v xLog "&&& logFile:'%s'" "$fLog"
    printf "$xLog\n"

    #   s:  dateTime.Start
    sDtm=$(date "$sFmt");   tDtmStart=$(date '+%s.%N')

    #   s:  header
    printf -v x ">>> runner.BEG *[%d] at:[%s]." "$iCtr" "$sDtm"
    printf "$x\n"
    echo "$x" > $fLog

    #   s:  flush.logFileName
    echo "" >>  $fLog
    echo "$xLog" >>  $fLog

    #   s:  run
    #   f_run_script "$aTest" "$iCtr" "$RANDOM" >> $fLog
    #   iRc=$?
    iRc=0
    s="# total_sum_of_eRRoRs := [$iRc]"
    printf "\t$s\n"
    echo "$s" >> $fLog

    #   f_run_script "$aTest" "$iCtr" "$RANDOM"
    #   s:  dateTime.Stopp
    sDtm=$(date "$sFmt");   tDtmStopp=$(date '+%s.%N')

    #   s:  calc.Time
    fSec=$(echo "($tDtmStopp-$tDtmStart) / 1" | bc)

    #   s:  footer
    printf -v x "<<< runner.END *[%d] at:[%s] elapsed:[%s]." "$iCtr" "$sDtm" "$fSec"
    echo "$x" >> $fLog
    printf "$x\n"

}

#   ===========================================================================
#   p:  p.body
#   ===========================================================================

#   fetch parameter
declare -r p_cOpt=$1
declare -r p_iSfr=$2
declare -r p_sScp=$BASH_SOURCE

#   define my local booleans
declare -r -i v_RUN_bTrue=100
declare -r -i v_RUN_bFalse=199

#   define debug flag
declare -r -i v_RUN_flag__bDebug=$v_RUN_bTrue
echo "### debugFlag:[$v_RUN_flag__bDebug]"

#   declare else
declare -i i=0
declare -i n=0
declare -x s='?'
declare -x x='-'

#   declare globals
declare -i v_RUN_iSrc=-1
declare -i v_RUN_iObj=-1
declare -i v_RUN_iRnd=-1
declare -x v_RUN_sObj='?'   #   single target

declare -r -i v_RUN_iPlusDivisor=4  # max/4
declare -r -i v_RUN_iStressMax=10  # maximal 10x

#   declare REX
declare -r -x v_RUN_sRexEx_src='^t[0-9]{2}_[A-Za-z]+\.bsh$'
declare -r -x v_RUN_sRexEx_log='^t[0-9]{2}_[A-Za-z]+_[0-9]+\.log$'
v_RUN_sRexEx_lid='^rBS_[A-Za-z0-9]+\.log$'

#   init some vars
declare -r sFmt="+%Y-%m-%d %H:%M:%S"
declare -r sDtm=$(date "$sFmt")
printf "### run.{%s} dtm:[%s]\n" "$p_sScp" "$sDtm"

#   my temp var
declare -i bDoRun=$v_RUN_bFalse
declare -x xSrcSelected='?'
declare -i iSrcIndexSelected=-1
declare -i bDoEvaluateRexParameter=$v_RUN_bFalse
declare -i bDoShuffle=$v_RUN_bFalse

#
#   m:  paramter-fetch
#

if [ -z $p_cOpt ];
    then echo "??? option::NONE"; f_run_hint
elif [ $p_cOpt == 'h' ]; then   f_run_usage
elif [ $p_cOpt == '?' ]; then   f_run_usage
elif [ $p_cOpt == '.' ]; then   bDoRun=$v_RUN_bTrue
elif [ $p_cOpt == '_' ]; then   bDoRun=$v_RUN_bTrue
elif [ $p_cOpt == '+' ]; then
    bDoRun=$v_RUN_bTrue; bDoShuffle=$v_RUN_bTrue
elif [ $p_cOpt == '!' ]; then   bDoRun=$v_RUN_bTrue
    bDoRun=$v_RUN_bTrue; bDoShuffle=$v_RUN_bTrue
else
    s=$p_cOpt;  r='^[0-9]+$';  [[ $s =~ $r ]]; iRc=$?
    if [ 0 == $iRc ]; then
        iSrcIndexSelected=$p_cOpt
        bDoEvaluateRexParameter=$v_RUN_bTrue
        bDoRun=$v_RUN_bTrue
        if [ $v_RUN_bTrue == $v_RUN_flag__bDebug ]; then
            echo "### iSrcIndexSelected==[$iSrcIndexSelected]"
        fi
    else
        printf "??? option::is_invalid :[%s]\n" $p_cOpt
        f_run_hint
    fi
fi

#   show run status
b2sRc=$(f_run_bEvaluate $bDoRun)
if [ $v_RUN_bTrue == $v_RUN_flag__bDebug ]; then
    echo "### bDoRunStatus:[$b2sRc]"
fi

#   quit if no run
if [ $bDoRun != $v_RUN_bTrue ]; then
    printf "=== program finished.\n"
    exit 0
fi

#   match my sources
declare -a v_RUN_aRc=()
declare -i v_RUN_iRc=-1

#
#   m:  run match
#

f_run_matchFiles \
        $v_RUN_sRexEx_src \
    $bDoShuffle
iRc=$?

#   show
if [ $v_RUN_bTrue == $v_RUN_flag__bDebug ]; then

    printf "### input.bShuffle :[$bDoShuffle]\n"
    printf "### reply.iRc:=[$iRc]\n"
    printf "### reply.global_Rc:=[$v_RUN_iRc]\n"
    printf "### show aSrc...\n"

    i=0
    for x in "${v_RUN_aRc[@]}"; do
        printf "### aRun[%2.2d] == '%s'\n" $i $x
        i+=1
    done

fi

#   copy matched files  2x
declare -a aSrc=("${v_RUN_aRc[@]}")
declare -i nSrc=${#aSrc[@]}

if [ $v_RUN_bTrue == $v_RUN_flag__bDebug ]; then
    printf "### show nSrc:[$nSrc]\n"
    i=0
    for x in "${aSrc[@]}"; do
        printf "### aSrc[%2.2d] == '%s'\n" $i $x
        i+=1
    done
fi


#   declare objet
declare -a aObj=()

#
#   m:  prepare object-array
#

if [ $v_RUN_bTrue ==  $bDoEvaluateRexParameter ]; then

    echo "=== option::evaluate"

    i=$iSrcIndexSelected
    n=$nSrc

    if [ $iSrcIndexSelected -gt $nSrc ]; then
        printf "??? option::overflow [iOpt=%d > iMax=%d]\n" $i $n
        exit
    fi

    #   use and decrement
    i=$iSrcIndexSelected
    let "i -= 1"

    #   fetch
    x=${aSrc[$i]};

    #   push
    aObj+=($x)

    #   save
    xSrcSelected=$x
    if [ $v_RUN_bTrue == $v_RUN_flag__bDebug ]; then
        echo "### index.selected := [$iSrcIndexSelected] : [$x]"
        echo "### opt.[x] : xSrcSelected:[$xSrcSelected]"
    fi

elif [ $p_cOpt == '.' ]; then

    echo "=== option::'.'"

    declare -i iSrcIndexRandom=$(( 1 + RANDOM % $nSrc ))
    if [ $v_RUN_bTrue == $v_RUN_flag__bDebug ]; then
        echo "### iSrcIndexRandom:[$iSrcIndexRandom] of:[$nSrc]"
    fi

    i=0
    s=''
    for x in "${aSrc[@]}"; do
        i+=1
        #   printf "### aSrc[%2.2d] == '%s'\n" $i $x
        if [ $i == $iSrcIndexRandom ]; then
            s=$x
            break
        fi
    done

    if [ $s == '' ]; then
        echo "??? not found index"
        f_run_usage
    fi

    #   save
    xSrcSelected=$x
    if [ $v_RUN_bTrue == $v_RUN_flag__bDebug ]; then
        echo "### opt.[.] : xSrcSelected:[$xSrcSelected]"
    fi

    #   push
    aObj+=($x)

elif [ $p_cOpt == '+' ]; then

    i=0
    q=4
    n=$(($nSrc/$q))

    echo "=== option::'+' ($n)/($nSrc)"

    aObj=()

    for (( i=0; i < ${n}; i++ ));
    do
        x=${aSrc[$i]}
        aObj+=($x)
    done


elif [ $p_cOpt == '!' ]; then

    echo "=== option::'!'"
    aObj=("${aSrc[@]}")

elif [ $p_cOpt == '_' ]; then

    echo "=== option::'_'"
    aObj=("${aSrc[@]}")

fi


#   s:  show finalize
if [ $v_RUN_bTrue == $v_RUN_flag__bDebug ]; then
    echo "### show finalized : aObj"
    declare -p  aObj
fi

#   s:  run main
f_run_main