<<usage
    Tutorial 2026-10-10

    +   usage:
            $>. {thisScript} [cOpt]=:'h' [{iStressFator(iSfr)}]=:'1'
                with:
            cOpt := { 'h','c','.','_','+','!'}
            iSfr := [1..10]

    +   Examples:
            $> . run h     :    help
            $> . run c     :    clean temp
            $> . run .     :    1x run some file of the tutorial
            $> . run _     :    run all files
            $> . run !     :    run all files but random
            $> . run +     :    1/4 of  all files random
            $> . run 4     :    run tutorFile 4
usage


<<hereDoc_content_tutor__run_expert
    content:
