#!/bin/bash

#   ***************************************************************************
#   run:[advavanced]  Tutorial BASH 2026        ©[mATe64]       [2026-10-03]
#   ***************************************************************************
#   usage:
#       $   bash [run_02_advanced.bsh]
#   content:
#       m:  run.prepare
#       m:  run.scripts
#   ***************************************************************************

#   ===========================================================================
#   b:  script
#   ===========================================================================

function f_run_script {

    #   fetch
    local p_aSrc=$1
    local p_nStressMax=$2     # stress counter
    local p_iRnd=$3

    #   declare
    declare -i i=0
    declare -i n=0
    declare -i iFile=0
    declare -i nFile=0

    #   calc.array FileNumber
    nFile=0
    for xFile in $p_aSrc; do
        nFile+=1
    done

    #   run
    printf "___ script nFiles:<%d>  iRnd:[%d]\n" $nFile $p_iRnd

    for (( n=1; n<=$p_nStressMax; n++ )); do
        printf "\n### stress :: [%3.3d]/[%3.3d]\n\n" $n $p_nStressMax
        iFile=0
        for xFile in $p_aSrc
        do
            iFile+=1
            printf "*** runScr:[%3.3d].[%2.2d]:'%s'\n" $n $iFile $xFile
            bash $xFile "x"
        done
    done

}

#   ===========================================================================
#   b:  body
#   ===========================================================================

#
#   m:  prepare
#

#   s:  fetch all bash
aTest=$(echo `ls t*.bsh`)
#   echo "test: ( $aTest )"

#   s:  fetchDateTime
declare sFmt="+%Y-%m-%d %H:%M:%S"

#   s:  calculate stressCounter
declare -i iCtr=1+$RANDOM%1

#   m:  run
clear
#   f_lib_configuration  "1"  # init

#   time.Start
tDtmStart=$(date '+%s.%N')
sDtm=$(date "$sFmt")

printf ">>> BEG run*[%d] at:[%s]\n" "$iCtr" "$sDtm"

#   logFileName
fLog="$v_LIB_dirScratch/run.log"
printf "+   logFile : '%s'\n" "$fLog"


#   call runner
#   f_run_script "$aTest" "$iCtr" "$RANDOM" > $fLog
f_run_script "$aTest" "$iCtr" "$RANDOM"

exit

#   show time
sDtm=$(date "$sFmt")

#   calc time STOPP
tDtmStopp=$(date '+%s.%N')
fSec=$(echo "($tDtmStopp-$tDtmStart) / 1" | bc)

printf "<<< END run*[%d] at:[%s] elapsed:[%s]\n" "$iCtr" "$sDtm" "$fSec"


