#!/bin/bash

#   ****************************************************************************
#   TUTORIAL BASH:file
#   ****************************************************************************

<<  =*=
    +   :01 create
    +   :02 write
    +   :03 read file
    +   :04 read from IO
    +   :05 redirect stderr

=*=

<<  UNIXstreams
       '#0'  :stdin
       '#1'  :stdout
       '#2'  :stderr
UNIXstreams

#
#   =*= :   functions
#

function f_tmp_fileRemove {
    #   rm all files at tmp - '*' not in ""
    f_lib_text "remove old files" $LINENO
    pushd $v_DIR_TMP 1> /dev/null
    rm *.tmp.txt 2> /dev/null
    popd 1> /dev/null
}

function f_tmp_fileCreate {
    sleep 1
    local x; local y; local s; local f; d=$(date "+%y%m%d%H%M%S"); e='tmp.txt'
    f="${v_DIR_TMP}/$z_SCP-$d-$LINENO.$e"
    f_lib_puts "try: \$> create:<$f>..."
    :> $f      #    create an empty file
    f_lib_text "empty FILE:<$f> created!" $LINENO
}

function f_tmp_fileWrite() {
    #   URL:https://unix.stackexchange.com/questions/446193/ls-with-a-wildcard
    #   The double quotes tell the shell to leave the * as-is
    #   instead of expanding it. This will work:
    sleep 1
    local x; local y; local s; local f; d=$(date "+%y%m%d%H%M%S"); e='tmp.txt'
    x='b??'; y='bsh'; s="$x*.$y"; f="${v_DIR_TMP}/$z_SCP-$d-$LINENO.$e"
    f_lib_puts "try: \$> write:<$f>..."
    echo "AnyText" > $f
    f_lib_text "FILE:<$f> created and written!" $LINENO
}

function f_tmp_ioRead() {
    #   read from keyboard - using timeout,delimiter,maxChars
    #   URL: https://www.unix.com/shell-programming-and-scripting/252856-read-timeout.html
    local l; d=$(date "+%y%m%d%H%M%S"); e='tmp.txt';
    local f="${v_DIR_TMP}/$z_SCP-$d-$LINENO.$e"
    local iTmt=5;   #   timeout
    local cDel=';'  #   delimiter
    local iChr=10;  #   maximal chars
    f_lib_puts "try: \$> read from IO in $iTmt seconds...stop with '<ENTER>'"
    f_lib_puts "Timeout:<$iTmt>"
    f_lib_puts "Delimiter:<$cDel>"
    f_lib_puts "nChars:<$iChr>"
    #   read input from console
    read -t $iTmt -d $cDel -n $iChr -p "write:" sRc
    f_lib_text "ready!" $LINENO
    f_lib_puts "written text :<$sRc>"
    #   read input into a file
    l=${#sRc}
    if [ $l -gt 0 ]; then
        echo $sRc > $f
        f_lib_text "io:<$f> written!" $LINENO
    else
        f_lib_text "io:no input"
    fi
}

function f_tmp_stderr2Logfile(){
    sleep 1
    local d=$(date "+%y%m%d%H%M%S"); e='tmp.txt';
    local f="${v_DIR_TMP}/$z_SCP-$d-$LINENO.$e"
    local sFileTmp='otto4711.txt'  # not exists!
    f_lib_text "try: \$ls '$sFileTmp'" $LINENO
    ls $sFileTmp 2>$f
    f_lib_text "FILE:<$f> logfile" $LINENO
}

function f_tmp_stderr2Null(){
    sleep 1
    #   redirect standard error stream '#2' into '/dev/null'
: '
    Fehlerausgabe von normaler Ausgabe trennen
    Wir erinnern uns an das Problem mit den angezeigten Fehlermeldungen von find.
    Wenn wir dem "Umleitungszeichen" eine Ziffer voran stellen,
    können wir nur normale oder nur Fehlermeldungen umleiten.
    Um die  Fehlermeldungen (2) nicht mehr zu sehen,
    können wir sie in eine ganz spezielle Datei umleiten.
    "/dev/null" ist ein "schwarzes Loch" und alles,
    was wir dort hin schreiben, ist unwiederbringlich verschwunden.
        $ find /var -name syslog 2> /dev/null
    Wir können aber auch die normalen Ausgaben (1) in eine Datei schreiben
    und Fehlermeldungen verwerfen:
        $ find /var -name syslog 2> /dev/null 1> syslogpfad.txt
    Ein less syslogpfad.txt überzeugt uns,
    dass nur der Pfad von "syslog" in die Datei geschrieben wurde.
'
    local s='peter'
    f_lib_text "try: \$>find /var -name $s" $LINENO
    find /var -name "$s" 2> /dev/null
}

function f_tmp_fileRead() {
    #   subfunction also global!
    function f_file_isReadable {
        if [ -r $1 ]; then
            echo "<<< true"
            return 0
        else
            echo "<<< false"
            return 1
        fi
    }
    function f_isFile {
        if [ -f $1 ]; then
            echo "<<< true"
            return 0
        else
            echo "<<< false"
            return 1
        fi
    }
    function f_fileSize {
        #   wc:     URL: https://wiki.ubuntuusers.de/wc/
        #   stat:   URL:https://www.computerhope.com/unix/stat.htm
        local f=$1
        local iRcSize=$(wc -c $f | awk '{print $1}');
        local iRcSize=$(stat -c%s $f)
        echo "<<< $iRcSize"
        return $iRcSize
    }
    declare -i i=0
    local d=$(date "+%y%m%d%H%M%S"); e='tmp.txt';
    local f="${v_DIR_TMP}/$z_SCP-$d-$LINENO.$e"
    local s="ABCDEFGHIJ"; local x;
    echo $s > $f
    f_lib_text "read FILE:<$f> " $LINENO
    sleep 1

    #   =*=: file readable?
    f_lib_puts "?readable"
    s='isReadable'
    if ( f_file_isReadable $f ); then
        s+=':!okR'
    else
        s+=':?nok'
    fi
    f_lib_text "check:$s" $LINENO

    #   =*=: get file size
    f_lib_puts "?filesize"
    f_fileSize $f; i=$?; f_lib_text "filesize:<$i>" $LINENO

    #   =*=: read the file
    s=$(<$f)
    f_lib_text "file is...." $LINENO
    echo $s
}

function f_tmp_fileReadLines() {
    local pFile=$1
    declare -i i=0
    declare -i l=0
    local s
    local t
    echo "I will read FILE lines:<$pFile>...."
    cat "$pFile" | \
    while read x; do
        i+=1
        t="$(echo -e "${x}" | tr -d '/[:cntrl:]/')"     # sed -e 's/^[[:cntrl:]]*//
        printf -v s "[%03d]:%s" "$i" "$t" 2>/dev/null   # show no error
        l=${#t}
        if [ $l -gt 0 ]; then
            printf "$s:($l)\n" 2>/dev/null
        fi
    done
}

#
#   =*= :   header
#

source LIB.inc.bsh

z_EXE=$BASH_SOURCE; z_SCP=`basename $z_EXE`
z_iEc=$1
z_DTM=$(date $z_DTM_FMT)

f_lib_header "$z_SCP" $LINENO $z_iEc; z_iEc=$?; z_iRc=$z_iEc

#
#   =*= :   define helper integer
#

f_lib_text "my helper" $LINENO
declare -i i
declare -i n
f_tmp_fileRemove

#
#   =*= :01 create
#

f_lib_menu "create a file" $LINENO
f_tmp_fileCreate    #   $>: ls :> $f

#
#   =*= :02 write
#

f_lib_menu "write file" $LINENO
f_tmp_fileWrite     #   $>: ls $s > $f

#
#   =*= :03 read file
#

z_sFile='readme-BSH.txt'

f_lib_menu "read file" $LINENO
f_tmp_fileRead $z_sFile

f_lib_menu "read fileLines" $LINENO
f_tmp_fileReadLines $z_sFile

#
#   =*= :04 read from stdin
#

f_lib_menu "read from IO" $LINENO
f_tmp_ioRead        #   $> read

#
#   =*= :05 redirect stderr
#

f_lib_menu "redirect stderr" $LINENO

#   to logfile
f_lib_submenu ":2:loggfile" $LINENO
f_tmp_stderr2Logfile

f_lib_submenu ":2:Null" $LINENO
f_tmp_stderr2Null

#
#   =*= :   footer
#

f_lib_footer $z_SCP $LINENO $z_iRc $z_iEc