hereDoc_content_tutor__array

#   p:  p.function
#   p:  p.body

#   b:  b.include
source LIB.wsp.inc.bsh
if [ "$1" == "" ]; then f_lib_configuration '+' '-'; fi
declare -i z_iReply_iEc=$1

#   b:  b.header
f_lib_header $z_iReply_iEc

#   b:  b.main
declare -i i
declare -i j
declare -i n
declare -i m
declare c=$v_LIB_color__blue

#   ===========================================================================
#   m:  A.define
#   ===========================================================================

#   m:  F.menu
f_lib_menu "A.define"

#   prepare
f_lib_puts "define some arrays ..." $v_LIB_color__blue

#   define empty array use declare
declare -a aEmpty

#   show
s=$(declare -p aEmpty); f_lib_text "$s"     #   aEmpty

#   define another empty array
aEmpty2=()

#   show
s=$(declare -p aEmpty2); f_lib_text "$s"   #   aEmpty2

#   define array with os
aOs=('ubuntu' 'centos' 'redhat' 'windows' 'macOs' 'andoid')

#   show
s=$(declare -p aOs); f_lib_text "$s"

#   define digit
aDigit=( 1 5 6 )

#   show
s=$(declare -p aDigit); f_lib_text "$s"

#   define alse
declare -a aNumber=(\
'One' 'Two' 'Three' 'Four' 'Five')
s=$(declare -p aNumber); f_lib_puts "$s"

declare -a aFruit=(\
'Apple' 'Banana' 'Cherry' 'Duran' 'Eggfruit' 'Fig' 'Grapefruit' 'Huckleberry')
s=$(declare -p aFruit); f_lib_puts "$s"

#   show with printf
f_lib_puts "show array with printf ..." $v_LIB_color__blue
printf "aDigit =: [%s]\n" "${aDigit[@]}"


#   ===========================================================================
#   m:  A.size      n=${#a[@]}
#   ===========================================================================

#   m:  F.menu
f_lib_menu "A.size"

#   calc
n=${#aEmpty[@]};    f_lib_text "sizeof(aEmpty)=<$n>"    #   0
n=${#aOs[@]};       f_lib_text "sizeof(aOs)=<$n>"       #   6
n=${#aDigit[@]};    f_lib_text "sizeof(aDigit)=<$n>"    #   3
n=${#aNumber[@]};   f_lib_text "sizeof(aNumber)=<$n>"   #   5
n=${#aFruit[@]};    f_lib_text "sizeof(aFruit)=<$n>"    #   8


#   ===========================================================================
#   m:  A.add       a+=('x')
#   ===========================================================================

#   m:  F.menu
f_lib_menu "A.add"

#   define first
aName=('Donald')

#   add by: += array
aName+=('Peter')
aName+=('Britney')
aName+=('Mike')
aName+=('Ronaldo')
aName+=('Vicky')

#   add by: += string
s='Harvey'; aName+=("$s")

#   show
s=$(declare -p aName); f_lib_text "$s"


#   ===========================================================================
#   m:  A.access        x=${a[$i]};
#   ===========================================================================

f_lib_menu "A.access"

#   max number of array elements
m=${#aFruit[@]} # 8

#   take the half
n=$n/2          # 4

#   show
f_lib_puts "access [$n] fruits of [$m] ..." $c

#   loop
for (( i=0; i < ${n}; i++ ));
do
    j=$((RANDOM % $m))
    x=${aFruit[$j]};
    f_lib_text "iFruit[$j] =: ['$x']"
done


#   ===========================================================================
#   m:  A.slice     n=${#a[@]:$iPos:$iLen}
#   ===========================================================================

#   REM: no overlap possible - bash cuts to long slices

#   m:  F.menu
f_lib_menu "A.slice"

#   syntax: $bsh> aNew  = "${aOld[@]:$Idx:$Num}"

#   define my color
c=$v_LIB_color__blue

#   get size
n=${#aFruit[@]}
f_lib_puts "<<< nMax=[$n]" $c           #   8

#   get position
iPos=$((RANDOM % $n))
f_lib_puts "<<< iPos=[$iPos]" $c        #   0..7

#   get length
iLen=$((RANDOM % $n))
f_lib_puts "<<< iLen=[$iLen]" $c        #   0..7

#   make slice
aTmp=("${aFruit[@]:$iPos:$iLen}")       #   ... ''Banana' 'Cherry' 'Duran' ...

#   show
s=$(declare -p aTmp); f_lib_text "$s"


#   ===========================================================================
#   m:  A.sort
#   ===========================================================================

#   m:  F.menu
f_lib_menu "A.sort"

#   s:  s.sorting.numbers
f_lib_menuS1 "s.sorting.numbers"

#   define
aInteger=(19 81 -1 6 3 66 43 2)
s=$(declare -p aInteger); f_lib_puts "$s"

#   sort - echo but no save
f_lib_puts "do sorting numbers..." $c
mapfile -t aInteger_sorted < <(printf '%s\n' "${aInteger[@]}" | sort -n)
echo "${aInteger_sorted[@]}"

#   store
s=$(echo "${aInteger_sorted[@]}")
f_lib_text "aInteger=$s"

#   s:  s.sorting.words
f_lib_menuS1 "s.sorting.words"

#   define
aName=('Bert' 'Ernie' 'Arnold')
s=$(declare -p aName); f_lib_puts "$s"

#   sort - echo but no save
f_lib_puts "do sorting names..." $c
mapfile -t aName_sorted < <(printf '%s\n' "${aName[@]}" | sort)
s=$(echo "${aName_sorted[@]}")
f_lib_text "aName=$s"


#   ===========================================================================
#   m:  A.shuffle
#   ===========================================================================

#   m:  F.menu
f_lib_menu "A.shuffle"

#   show.before
f_lib_puts "\nbefore shuffle..." $c
s=$(declare -p aFruit); f_lib_puts "$s"

#   perform shuffle
aTmp=( $(shuf -e "${aFruit[@]}") )

#   show.after
f_lib_puts  "\nafter shuffle..." $c
s=$(declare -p aTmp); f_lib_puts "$s"

#   ===========================================================================
#   m:  A.copy
#   ===========================================================================

#   m:  F.menu
f_lib_menu "A.shuffle"

#   define aAlpha(aNumber)
f_lib_puts "\nbefore copy..." $c
s=$(declare -p aNumber); f_lib_text "$s"

#   copy aBeta:=aNumber and show
f_lib_puts "\ndo copy  aBeta:=aNumber"
aBeta=("${aNumber[@]}")
s=$(declare -p aBeta); f_lib_text "$s"

#   add Zero
f_lib_puts "\nadd aBeta += Zero"
aBeta+=('Zero')
s=$(declare -p aBeta); f_lib_text "$s"

#   show old aNumber    -> proof: aBeta is not a link !
f_lib_puts "\nshow old aNumber" $c
s=$(declare -p aNumber); f_lib_text "$s"


#   ===========================================================================
#   m:  A.mix       array a := a1 && a2
#   ===========================================================================

#   m:  F.menu
f_lib_menu "A.mix"

declare -a Common

aCity=('NewYork' 'Chicago' 'Berlin')
aPets=('Harvey' 'Putzi' 'Whisky')
declare -p aCity
declare -p aPets

#   combine and calc length
aCommon=( ${aCity[@]} ${aPets[@]} )
nCommon=${#aCommon[@]}

#   show
f_lib_puts "\nshow results...\n" $c
s="nCommon =: [$nCommon]";    f_lib_text "$s"
s="${aCommon[@]}"; f_lib_text "aCommon =: [$s]"

f_lib_puts "\nshow each element ...\n" $c
i=0
for xCommon in "${aCommon[@]}"
do
    i+=1
    printf "\tcommon:[%2.2d]:'%s'\n" $i $xCommon
done

#   ###########################################################################
#   b:  b.footer
#   ###########################################################################
f_lib_footer 0

#   p:  p.last