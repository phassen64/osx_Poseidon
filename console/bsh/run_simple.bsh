#!/bin/bash
#   ***************************************************************************
#   simple.run 2026        ©[mATe64]               [2026-10-03]
#   ***************************************************************************
#   usage:
#   $   bash [run_simple.bsh]

#   declare my reply
declare -i iReply=$RANDOM
clear
echo "+ simple.Reply:[$iReply]"

#   fetch all bash
a=$(echo `ls t*.bsh`)

#   array size
declare -i n

#   not works
n=${#a[@]}; echo "n1==[$n]"

#   calc manually
n=0
for xFile in $a; do
    n+=1
done
echo "n==[$n] "

#   date
declare sFmt="+%Y-%m-%d %H:%M:%S"
declare sDtm=$(date "$sFmt")

#   ===========================================================================
#   m:  script.run
#   ===========================================================================

clear

printf "BEG simple.run:[%s]\n\n" "$sDtm"

declare -i i=0
for xFile in $a
do
    i+=1
    printf "*** run:[%2.2d]/[%2.2d]:'%s'\n" $i $n $xFile
    bash $xFile
done

printf "END simple.run:[%s]\n\n" "$sDtm"

