function f_tor_dummy {
    local sPara=$1
    local sFunc=${FUNCNAME[0]}
    local iLine=$LINENO
    local dTemp=$v_LIB_dirScratch
    local s; local sTemp
    printf "<<< myName:[%s] p:[%s] at l:[%d]\n" $sFunc $sPara $iLine
    sName="$sFunc.txt"

    f_lib_file_joinPath "$dTemp" "$sName"

    printf "<<< reply via rs:[%s]\n" $v_LIB_reply_sRc


    sRc=$(f_lib_file_joinPath "$dTemp" "$sName")

    printf "<<< reply2[%s]\n" $sRc


    #   sTemp=v_LIB_reply_sRc

    #   printf "<<< joined Path:[%s]\n" $s
}

