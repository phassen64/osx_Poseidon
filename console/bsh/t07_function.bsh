: '
        $@              :   array of all parameter
        $#              :   parameter-counter
        $1...$9..       :   current parameter
        $?              :   return code
        ${FUNCNAME[0]}  :   function name
'

<< hereDoc_content_tutor__function
    content:
        p:  p.function
        p:  p.body
            b:  b.include
