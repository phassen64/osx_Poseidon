#!/bin/bash

#   ***************************************************************************
#   run:[advavanced]  Tutorial BASH 2026        ©[mATe64]       [2026-10-03]
#   ***************************************************************************
#   usage:
#       $   bash [run_02_advanced.bsh]
#   content:
#       m:  run.prepare
#       m:  run.scripts
#   ***************************************************************************

#   ===========================================================================
#   b:  script
#   ===========================================================================

function f_run_script {

    #   fetch
    local p_aSrc=$1
    local p_nStressMax=$2     # stress counter
    local p_iRnd=$3

    #   declare
    declare -i i=0
    declare -i n=0
    declare -i iFile=0
    declare -i nFile=0

    #   calc.array FileNumber
    nFile=0
    for xFile in $p_aSrc; do
        nFile+=1
    done

    #   define my runner.eXitCode [3,...199]
    local -i iEc=55
    local -i iBashReply=0
    local -x sLine
    local -i iRc=0

    #   build sLine
    s=''; c='#'; for((i=0;i<80;i++)); do s+="$c"; done
    sLine=$s

    #   run
    printf "___ script nFiles:<%d>  iRnd:[%d] :#{%d}\n" $nFile $p_iRnd $iEc

    for (( n=1; n<=$p_nStressMax; n++ )); do

        printf "\n### stress :: [%3.3d]/[%3.3d]\n" $n $p_nStressMax
        iFile=0

        for xFile in $p_aSrc
        do
            iFile+=1

            s=''; c='#'; for((i=0;i<80;i++)); do s+="$c"; done

            printf "\n%s\n" $sLine
            printf "*** run:[%2.2d]/[%3.3d]:'%s'\n" $iFile $n  $xFile
            printf "%s\n\n" $sLine

            #   call script, save eXitCode
            bash $xFile $iEc;   iBashReply=$?

            #   check reply
            printf "\n<<< replyOf[%d]:'%s': #{%d}" $n $xFile $iBashReply
            if [ $iEc == $iBashReply ]
            then
                printf ":scpEc==:!OK\n"
            else
                printf ":scpEc==:?nok\n"
                iRc+=1
            fi

        done

    done

    printf "___ total.iRc:<%d>\n" $iRc
    return $iRc
}

#   ===========================================================================
#   b:  body
#   ===========================================================================

#
#   m:  prepare
#

#   s:  fetch all bash
aTest=$(echo `ls t*.bsh`)
#   echo "test: ( $aTest )"

#   s:  fetchDateTime
declare sFmt="+%Y-%m-%d %H:%M:%S"

#   s:  calculate stressCounter
declare -i n=1  #   rndMax
declare -i iCtr=1+$RANDOM%$n
declare -i iRc=0
declare  x  #   formatStr

#   m:  run
clear
#   f_lib_configuration  "1"  # init

#   s:  dateTime.Start
sDtm=$(date "$sFmt");   tDtmStart=$(date '+%s.%N')

#   s:  logFileName
v_SCP=`basename $BASH_SOURCE`
v_SCP_bdy="${v_SCP%.*}"
v_SCP_ext="${v_SCP##*.}"
fLog="$v_FWK_dirScratch/$v_SCP_bdy.log"
printf -v xLog "&&& logFile:'%s'" "$fLog"
printf "$xLog\n"

#   s:  header
printf -v x ">>> runner.BEG *[%d] at:[%s]." "$iCtr" "$sDtm"
printf "$x\n"
echo "$x" > $fLog

#   s:  flush.logFileName
echo "" >>  $fLog
echo "$xLog" >>  $fLog

#   s:  run
f_run_script "$aTest" "$iCtr" "$RANDOM" >> $fLog
iRc=$?
s="# total_sum_of_eRRoRs := [$iRc]"
printf "\t$s\n"
echo "$s" >> $fLog

#   f_run_script "$aTest" "$iCtr" "$RANDOM"
#   s:  dateTime.Stopp
sDtm=$(date "$sFmt");   tDtmStopp=$(date '+%s.%N')

#   s:  calc.Time
fSec=$(echo "($tDtmStopp-$tDtmStart) / 1" | bc)

#   s:  footer
printf -v x "<<< runner.END *[%d] at:[%s] elapsed:[%s]." "$iCtr" "$sDtm" "$fSec"
echo "$x" >> $fLog
printf "$x\n"


