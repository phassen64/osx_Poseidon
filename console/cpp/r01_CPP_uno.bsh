#!/bin/bash

#   ***************************************************************************
#   run:[uno]   tutorial.CPP v2026          ©[mATe64]           [2026-10-14]
#   ***************************************************************************

#   encoding
#   !$@€ƒ„…†‡‰¡“”•—Ÿ¢£¤¥¦§¨™©®×±«»♔♖♞♟°²³µ¶·¹º¼½¾¿ÄÖÜäöüßæŠŒŽšœžçîðñôö÷αβγδεΦ.Ω

#   usage:
#       $   bash run_<SCP>.bsh <FILE.cpp>

#   example:
#       $   bash "r01_runUno.bsh" "z01_intro.cpp"

#   description:
#       compile & link & execute input-file <FILE.cpp>

#   remark:
#       no logging.

#   content:
#       m:  function
#       m:  body
#       m:  compile
#       m:  lastLine

#   ***************************************************************************

#
#   m:  function
#

#   s:  F.clean
function f_run_clean() {
    pushd $v_FWK_dirScratch > /dev/null
    declare -a aExt=('o' 'obj' 'out' 'exe' 'bin')
    for x in "${aExt[@]}"; do
        f='*.'
        f+=$x
        rm -f $f
    done
    popd > /dev/null
}

#
#   m:  body
#

#   s:  paramer
p_sFile=$1

#   s:  const library source
declare -r C_TUTOR_LIBRARY__SRC='z00_library.cpp'

#   s:  const library object
s=$(basename ${C_TUTOR_LIBRARY__SRC})
s="${s%.*}"             #   Body
declare -r C_TUTOR_LIBRARY__OBJ="${s}.obj"

#   clean
clear
f_run_clean

#   s:  fetch my C-sources - build a BASH-array
declare -a aSrc
aSrc+=( $C_TUTOR_LIBRARY__SRC )
aSrc+=( $p_sFile )
#   declare -p aSrc

#   only if source
declare v_INFO="TUTOR-CPP-2026" ; export v_INFO

#   s:  header
declare sFmt="+%Y-%m-%d %H:%M:%S"
declare sDtm=$(date "$sFmt")
s='run<uno>::compile+link+run'; printf "BEG %s [%s]\n\n" $s "$sDtm"

declare -i i=0
declare dTmp=${v_FWK_dirScratch}
declare sOpt="-Wall -Werror"

#   s:  loop about BASH array
for sFile in "${aSrc[@]}"
do

    #   u:  declare.src
    declare sNam=$(basename ${sFile})       #   source baseName.src
    declare sExt="${sNam##*.}"              #   extension
    declare sBdy="${sNam%.*}"               #   Body

    #   u:  declare.objects
    declare oFile="$dTmp/${sBdy}.obj"       #   target filePath.obj
    declare xFile="$dTmp/${sBdy}.exe"       #   target objectPath.exe
    declare pLiby="$dTmp/${C_TUTOR_LIBRARY__OBJ}"       #   target library

    #   u:  show
    i+=1
    printf "&&& make[%d]: '%s' \n" $i $sFile
    export v_EXE=$xFile

    #   -----------------------------------------------------------------------
    #   u:  make (compile+link)
    #   -----------------------------------------------------------------------
    if [ $sFile == "$C_TUTOR_LIBRARY__SRC" ]
    then
        g++ $sOpt -c $sFile -o $pLiby
        continue
    else

        g++ $sOpt -c $sFile -o $oFile         #   compile only
        g++ $oFile $pLiby -o $xFile     #   linking
    fi
    #   -----------------------------------------------------------------------

    #   u:  show run
    printf "&&& run![%2.2d]:'%s'\n" $i $xFile

    #   u:  execute executable stored in a variable
    "$xFile"

    iRc=$?
    printf "&&& bash.reply.iRc:'%d'\n" $iRc

done

#   s:  footer
printf "\n"
sDtm=$(date "$sFmt")
s='run<uno>::compile+link+run'; printf "END %s [%s]\n\n" $s "$sDtm"

exit $iRc
#   m:  lastLine